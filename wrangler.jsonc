// Cloudflare Worker for nomansskyrecipes.com: static assets plus the on-demand /alliances pages (Astro Cloudflare adapter).
// Built by Workers Builds (build `pnpm build`, deploy `npx wrangler deploy`). The adapter fills in `main` and the
// ASSETS binding; prerendered pages, public/_redirects and public/_headers are served as static assets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nms",
  "compatibility_date": "2026-10-22",
  // assets_navigation_has_no_effect: since compatibility date 2025-04-01, browser page loads (Sec-Fetch-Mode: navigate)
  // that match no static file get the static 404.html straight from the asset layer WITHOUT invoking the Worker. That
  // 404'd every real visit to the on-demand /alliances pages (curl, which sends no Sec-Fetch-Mode, still got 200). This
  // flag restores "no matching asset -> run the Worker" for every request.
  "compatibility_flags": ["nodejs_compat", "assets_navigation_has_no_effect"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Alliance directory (was Turso). Schema: migrations/.
  "d1_databases": [
    {
      "binding": "ALLIANCES_DB",
      "database_name": "nms-alliances",
      "database_id": "9eb0b194-7f27-4d95-83dc-27f7632e8980",
      "migrations_dir": "migrations"
    }
  ],
  // Alliance submission alerts (src/utils/allianceNotify.ts). Cloudflare Email Sending is enabled on the subdomain
  // mail.nomansskyrecipes.com only (its records live under mail.); the apex keeps its Google mail. Sends to a verified
  // destination address are free.
  "send_email": [
    {
      "name": "ALERT_EMAIL",
      "allowed_sender_addresses": ["alerts@mail.nomansskyrecipes.com"]
    }
  ],
  // Secrets (set on the Worker, never in this repo): ALLIANCES_ADMIN_TOKEN, optional ALLIANCES_ALERT_EMAIL (the verified
  // destination address), optional ALLIANCES_NTFY_TOPIC (legacy, unset: ntfy rate-limits shared Workers IPs).
  // Test address <name>.<subdomain>.workers.dev until cutover; public/_headers sends noindex there.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
