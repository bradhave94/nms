# Static-asset headers for Cloudflare Workers, mirroring the headers block of vercel.json (keep both in step).
# HSTS matches what Vercel sends by default.
/*
  Strict-Transport-Security: max-age=63072000

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Keep the workers.dev test address out of search results (the live hosts are unaffected).
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
