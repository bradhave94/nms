---
import '../assets/css/blog.css';
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Accordion from '@components/Accordion.astro';
import NitroAd from '@components/ads/NitroAd.astro';
import { buildGuideStructuredData } from '@utils/guideStructuredData.js';
import { getSiteOrigin } from '@utils/structuredData.js';
import { withSiteTitle } from '@utils/seo.js';
import { fixSkippedHeadings, formatPostDate, groupRelatedLinks, isoDay, laterUpdate, tagLabel } from '@utils/blog.js';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
	guide: CollectionEntry<'blog'>;
	headings?: MarkdownHeading[];
}

const { guide, headings = [] } = Astro.props as Props;
const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL(`/blog/${guide.id}/`, siteOrigin).toString();
const ogImage = guide.data.heroImage
	? new URL(guide.data.heroImage, siteOrigin).toString()
	: `${siteOrigin}/images/refiner.webp`;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Blog', href: '/blog/' },
	{ name: guide.data.title },
];
const pageTitle = withSiteTitle(guide.data.title);
const structuredData = buildGuideStructuredData({
	canonicalUrl,
	pageTitle,
	title: guide.data.title,
	description: guide.data.description,
	publishedTime: guide.data.pubDate.toISOString(),
	modifiedTime: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
	authorName: guide.data.author,
	image: ogImage,
	breadcrumbs: breadcrumbs.map((breadcrumb) => ({
		name: breadcrumb.name,
		url: breadcrumb.href ? `${siteOrigin}${breadcrumb.href}` : canonicalUrl,
	})),
	faqs: guide.data.faqs,
});
const tags = guide.data.tags as string[];
const relatedLinks = guide.data.relatedLinks as { label: string; href: string }[];
const guideFaqs = (guide.data.faqs ?? []) as Array<{ question: string; answer: string }>;
const publishedTime = guide.data.pubDate.toISOString();
const modifiedTime = (guide.data.updatedDate ?? guide.data.pubDate).toISOString();
const updatedDate = laterUpdate(guide.data.pubDate, guide.data.updatedDate);

// Related: item pages get their game icon, guides get their hero, the rest are tool links.
const related = groupRelatedLinks(relatedLinks);
const postsById = new Map((await getCollection('blog')).map((post) => [post.id, post]));
const relatedPosts = related.posts.flatMap((link) => {
	const post = postsById.get(link.slug);
	return post && post.id !== guide.id ? [{ ...link, post }] : [];
});
const hasRelated = related.items.length + related.tools.length + relatedPosts.length > 0;
const bodyHtml = fixSkippedHeadings(await Astro.slots.render('default'));
---

<Layout
	title={pageTitle}
	description={guide.data.description}
	slug="blog"
	ogImage={ogImage}
	ogType="article"
	articlePublishedTime={publishedTime}
	articleModifiedTime={modifiedTime}
	structuredData={structuredData}
>
	<div>
		<header class="relative isolate overflow-hidden rounded-2xl border border-line">
			{guide.data.heroImage && (
				<>
					<img
						src={guide.data.heroImage}
						alt=""
						width="1536"
						height="864"
						fetchpriority="high"
						decoding="async"
						class="absolute inset-0 -z-20 size-full object-cover"
					/>
					<div class="guide-hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>
				</>
			)}
			<div class:list={['px-5 sm:px-10 lg:px-12', guide.data.heroImage ? 'pt-4 pb-8 sm:pt-5 sm:pb-14 lg:pt-6 lg:pb-16' : 'bg-panel pt-5 pb-10']}>
				<Breadcrumbs items={breadcrumbs} className="mb-0 px-0! [&_a]:text-[#c3d0dd]" />
				<div class:list={['max-w-[44rem]', guide.data.heroImage ? 'mt-8 sm:mt-20 lg:mt-24' : 'mt-8']}>
					<h1 class="m-0 text-[2.1rem] leading-[1.08] font-bold text-white sm:text-[2.6rem] lg:text-[3rem]">{guide.data.title}</h1>
					<p class="mt-4 mb-0 max-w-[40rem] text-[1.05rem] leading-relaxed text-[#dfe7f0] sm:text-lg">{guide.data.description}</p>
					<p class="mt-5 mb-0 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-[#c3d0dd]">
						<time datetime={isoDay(guide.data.pubDate)} class="tabular">{formatPostDate(guide.data.pubDate)}</time>
						{updatedDate && (
							<>
								<span aria-hidden="true">·</span>
								<span>Updated{' '}<time datetime={isoDay(updatedDate)} class="tabular">{formatPostDate(updatedDate)}</time></span>
							</>
						)}
						{tags.length > 0 && (
							<>
								<span aria-hidden="true">·</span>
								<span><span class="sr-only">Topics: </span>{tags.map(tagLabel).join(', ')}</span>
							</>
						)}
					</p>
				</div>
			</div>
		</header>

		<article class="mt-8 grid gap-10 xl:mt-10 xl:grid-cols-[minmax(0,1fr)_300px] xl:gap-12">
			<div class="min-w-0">
				{tocHeadings.length > 0 && (
					<details class="toc-mobile panel mb-8 max-w-[32rem] xl:hidden">
						<summary class="flex min-h-[44px] items-center justify-between gap-3 px-4 font-semibold text-ink">
							On this page
							<svg class="toc-chevron h-4 w-4 text-dim" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
						</summary>
						<div class="px-4 pb-4"><ul class="toc-list">
							{tocHeadings.map((heading) => (
								<li class={heading.depth === 3 ? 'toc-sub' : ''}>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ul></div>
					</details>
				)}

				<div id="guide-article">
					<div id="guide-content" class="guide-prose" set:html={bodyHtml} />
				</div>
				<script is:inline>
					window.nitroAds.createAd('guide-article', {
						format: 'article',
						pageInterval: 1,
						sizes: [
							[728, 90],
							[300, 250],
							[320, 50],
							[320, 100],
						],
						report: {
							enabled: true,
							icon: true,
							wording: 'Report Ad',
							position: 'top-right',
						},
					});
				</script>
				<script>
					// Wrap each table so it scrolls sideways on phones; a scrolling wrapper gets a tab stop
					// and a name so keyboard users can scroll it too.
					document.querySelectorAll<HTMLTableElement>('#guide-content table').forEach((table, index) => {
						if (table.parentElement?.classList.contains('prose-table-scroll')) return;
						const wrapper = document.createElement('div');
						wrapper.className = 'prose-table-scroll';
						table.parentNode?.insertBefore(wrapper, table);
						wrapper.appendChild(table);
						const sync = () => {
							if (wrapper.scrollWidth > wrapper.clientWidth + 1) {
								wrapper.tabIndex = 0;
								wrapper.setAttribute('role', 'region');
								wrapper.setAttribute('aria-label', `Table ${index + 1}, scrolls sideways`);
							} else {
								wrapper.removeAttribute('tabindex');
								wrapper.removeAttribute('role');
								wrapper.removeAttribute('aria-label');
							}
						};
						sync();
						new ResizeObserver(sync).observe(wrapper);
					});
				</script>

				{hasRelated && (
					<section class="mt-14 max-w-[46rem]" aria-labelledby="related-title">
						<h2 id="related-title" class="section-title text-white">Related</h2>
						{related.items.length > 0 && (
							<ul class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2">
								{related.items.map((item) => (
									<li>
										<a href={item.href} class="panel flex min-h-[64px] items-center gap-3 p-2.5 pr-4 transition-colors hover:border-line-strong hover:bg-panel-3">
											<span class="slot w-11" style={`--c:${item.colour}`}><img src={item.icon} alt="" width="32" height="32" loading="lazy" decoding="async" /></span>
											<span class="min-w-0 font-medium text-ink">{item.label}</span>
										</a>
									</li>
								))}
							</ul>
						)}
						{related.tools.length > 0 && (
							<ul class:list={['m-0 flex list-none flex-wrap gap-2 p-0', related.items.length > 0 && 'mt-4']}>
								{related.tools.map((tool) => (
									<li><a href={tool.href} class="btn-quiet text-[.95rem]">{tool.label}</a></li>
								))}
							</ul>
						)}
						{relatedPosts.length > 0 && (
							<>
								<h3 class="mt-8 mb-3 text-[1.15rem] font-semibold text-white">More guides</h3>
								<ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2">
									{relatedPosts.map(({ href, label, post }) => (
										<li class="group panel relative flex items-center gap-3 p-2.5 transition-colors hover:border-line-strong hover:bg-panel-3">
											{post.data.heroImage && (
												<img src={post.data.heroImage} alt="" width="1536" height="864" loading="lazy" decoding="async" class="aspect-video h-auto w-28 shrink-0 rounded-lg object-cover" />
											)}
											<p class="m-0 min-w-0 text-[.95rem] leading-snug font-medium text-ink group-hover:text-accent">
												<a href={href} class="after:absolute after:inset-0">{label}</a>
											</p>
										</li>
									))}
								</ul>
							</>
						)}
					</section>
				)}

				{guideFaqs.length > 0 && (
					<section id="faq" class="mt-14 max-w-[46rem]" aria-labelledby="faq-title">
						<h2 id="faq-title" class="section-title text-white">Frequently asked questions</h2>
						<div class="panel divide-y divide-line px-1 py-1 sm:px-2">
							{guideFaqs.map((faq, index) => (
								<Accordion id={`faq-${index + 1}`} heading="h3">
									<span class="text-[1.05rem] font-semibold text-white" slot="title">{faq.question}</span>
									<p class="m-0 max-w-[38rem] leading-relaxed text-ink" slot="content">{faq.answer}</p>
								</Accordion>
							))}
						</div>
					</section>
				)}
			</div>

			<aside class="hidden xl:block w-[300px] shrink-0 self-start sticky top-4 h-fit space-y-4">
				<NitroAd
					id="guide-sidebar"
					class="my-0 max-w-[300px]"
					minHeight={250}
					sizes={[[300, 250]]}
				/>
				{tocHeadings.length > 0 && (
					<nav class="panel max-h-[calc(100vh-250px-3rem)] overflow-y-auto p-4" aria-labelledby="toc-title">
						<h2 id="toc-title" class="mt-0 mb-3 text-base font-semibold text-ink">On this page</h2>
						<ul class="toc-list" id="blog-toc-links">
							{tocHeadings.map((heading) => (
								<li class={heading.depth === 3 ? 'toc-sub' : ''}>
									<a href={`#${heading.slug}`} class="blog-toc-link" data-section={heading.slug}>
										{heading.text}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)}
			</aside>
		</article>
	</div>
</Layout>

{tocHeadings.length > 0 && (
	<script define:vars={{ tocHeadings }}>
		const sections = tocHeadings.map((heading) => heading.slug);
		const links = document.querySelectorAll('.blog-toc-link');

		function updateActive() {
			let current = '';
			for (const id of sections) {
				const el = document.getElementById(id);
				if (el && el.getBoundingClientRect().top <= 200) current = id;
			}
			links.forEach((link) => {
				if (link.getAttribute('data-section') === current) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		}

		window.addEventListener('scroll', updateActive, { passive: true });
		updateActive();
	</script>
)}

<style>
	.guide-hero-scrim {
		background:
			linear-gradient(90deg, rgb(11 15 20 / .94), rgb(11 15 20 / .72) 55%, rgb(11 15 20 / .35)),
			linear-gradient(0deg, rgb(11 15 20 / .9), transparent 55%);
	}
	@media (max-width: 639px) {
		.guide-hero-scrim { background: linear-gradient(0deg, rgb(11 15 20 / .96) 35%, rgb(11 15 20 / .7)); }
	}
</style>
