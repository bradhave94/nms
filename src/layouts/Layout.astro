---
import '../assets/css/main.css';
import Analytics from '@vercel/analytics/astro';
import type { JsonLdObject } from '@utils/structuredData.js';
import {
	buildBreadcrumbSchema,
	buildOrganizationSchema,
	buildVideoGameSchema,
	buildWebPageSchema,
	buildWebSiteSchema,
	hasPageEntity,
	serializeJsonLdGraph,
} from '@utils/structuredData.js';
import type { BreadcrumbItem } from '@utils/seo.js';
import { getPublicImageSize } from '@utils/imageSize';

import Sidebar from '@layouts/Sidebar.astro';
import Search from '@components/Search.astro';
import SearchModal from '@components/SearchModal.astro';
import Footer from '@components/Footer.astro';
import NitroGlobalAds from '@components/ads/NitroGlobalAds.astro';
import { SITE } from '@config';
import { ANNOUNCE_KEY } from '../config/announce';
import { ensureTrailingSlashPath, ensureTrailingSlashUrl } from '@utils/trailingSlash.js';

export interface Props {
	title?: string;
	author?: string;
	description?: string;
	ogImage?: string;
	/** Alt text for the social preview image; defaults to the page title. */
	ogImageAlt?: string;
	ogType?: string;
	articlePublishedTime?: string;
	articleModifiedTime?: string;
	slug?: string;
	structuredData?: JsonLdObject | JsonLdObject[];
	/** Visible breadcrumbs; adds a BreadcrumbList when structuredData has none. */
	breadcrumbs?: BreadcrumbItem[];
	robots?: string;
	canonical?: string;
	prevUrl?: string;
	nextUrl?: string;
	/** Set false on pages that must not carry ads (e.g. the 404 page). */
	ads?: boolean;
}

const {
	title = SITE.title,
	author = SITE.author,
	description = SITE.desc,
	slug,
	structuredData,
	breadcrumbs,
	ogImage,
	ogImageAlt,
	ogType = 'website',
	articlePublishedTime,
	articleModifiedTime,
	robots = 'index,follow,max-image-preview:large',
	canonical,
	prevUrl,
	nextUrl,
	ads = true,
} = Astro.props;
const canonicalURL = canonical
	? new URL(canonical, SITE.website)
	: new URL(Astro.url.pathname, Astro.site ?? SITE.website);
canonicalURL.pathname = ensureTrailingSlashPath(canonicalURL.pathname);
const prevHref = prevUrl ? ensureTrailingSlashUrl(prevUrl) : undefined;
const nextHref = nextUrl ? ensureTrailingSlashUrl(nextUrl) : undefined;
const siteOrigin = SITE.website.replace(/\/$/, '');
const defaultOgImage = `${siteOrigin}/images/icon.png`;
const imageUrl = ogImage ?? defaultOgImage;
// Sizes come from the files in public/ at build time; on-demand pages skip them.
const imageSize = Astro.isPrerendered ? getPublicImageSize(imageUrl, siteOrigin) : null;
// Item icons are small squares: a large card would upscale them, so use the summary card.
const twitterCard = imageSize && imageSize.width < 600 ? 'summary' : 'summary_large_image';
const imageAlt = ogImageAlt ?? title;
const organizationSchema = buildOrganizationSchema(siteOrigin);
const webSiteSchema = buildWebSiteSchema(siteOrigin);
const videoGameSchema = buildVideoGameSchema(siteOrigin);
const extraStructuredData = structuredData
	? (Array.isArray(structuredData) ? structuredData : [structuredData])
	: [];
const breadcrumbSchema =
	breadcrumbs?.length && !extraStructuredData.some((schema) => schema['@type'] === 'BreadcrumbList')
		? buildBreadcrumbSchema(siteOrigin, canonicalURL.toString(), breadcrumbs)
		: undefined;
const dateModified = (articleModifiedTime ?? SITE.version_date).slice(0, 10);
const webPageSchema = !hasPageEntity(extraStructuredData)
	? buildWebPageSchema({
			siteOrigin,
			canonicalUrl: canonicalURL.toString(),
			title,
			description,
			dateModified,
			breadcrumbId: breadcrumbSchema ? String(breadcrumbSchema['@id']) : undefined,
		})
	: undefined;
const mergedStructuredData: JsonLdObject[] = [
	organizationSchema,
	webSiteSchema,
	videoGameSchema,
	...(webPageSchema ? [webPageSchema] : []),
	...(breadcrumbSchema ? [breadcrumbSchema] : []),
	...extraStructuredData,
];
const mergedStructuredDataJson = serializeJsonLdGraph(mergedStructuredData);

---

<!DOCTYPE html>
<html lang="en" class="h-full bg-space font-nms text-lg text-ink">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/images/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" sizes="180x180" />
		<link rel="canonical" href={canonicalURL} />
		{prevHref && <link rel="prev" href={prevHref} />}
		{nextHref && <link rel="next" href={nextHref} />}
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content={author} />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		{articlePublishedTime && (
			<meta property="article:published_time" content={articlePublishedTime} />
		)}
		{articleModifiedTime && (
			<meta property="article:modified_time" content={articleModifiedTime} />
		)}

		<meta property="og:image" content={imageUrl} />
		{imageSize && <meta property="og:image:width" content={String(imageSize.width)} />}
		{imageSize && <meta property="og:image:height" content={String(imageSize.height)} />}
		<meta property="og:image:alt" content={imageAlt} />

		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<link
			rel="preload"
			as="font"
			href="/fonts/FuturaProBook.woff2"
			type="font/woff2"
			crossorigin="anonymous"
		/>

		<!-- NitroPay (skipped on ad-free pages such as the 404) -->
		{ads && (
			<Fragment>
		<script is:inline data-cfasync="false">
			/* eslint-disable prefer-rest-params -- NitroPay stock snippet queues the Arguments object. */
			window.nitroAds = window.nitroAds || {
				createAd: function () {
					return new Promise((e) => {
						window.nitroAds.queue.push(['createAd', arguments, e]);
					});
				},
				addUserToken: function () {
					window.nitroAds.queue.push(['addUserToken', arguments]);
				},
				queue: [],
			};
			/* eslint-enable prefer-rest-params */
		</script>
		<script is:inline data-cfasync="false" async src="https://s.nitropay.com/ads-2507.js"></script>
			</Fragment>
		)}

		<!-- a dismissed announcement bar stays hidden from the first paint -->
		<script is:inline define:vars={{ announceKey: ANNOUNCE_KEY }}>
			try {
				if (localStorage.getItem(announceKey)) document.documentElement.classList.add('announce-off');
			} catch {
				/* storage blocked: show the bar */
			}
		</script>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-9GEFK3YPV3"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				// eslint-disable-next-line prefer-rest-params -- Google tag's stock snippet queues the Arguments object.
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-9GEFK3YPV3');
		</script>

		<meta name="robots" content={robots} />
		<script type="application/ld+json" set:html={mergedStructuredDataJson}></script>
	</head>
	<body class={`h-full overflow-x-hidden m-0 ${slug === '/' ? 'home' : ''}`}>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Sidebar slug={slug} showAds={ads}>
			<slot slot="layout" />
		</Sidebar>
		<SearchModal />
		<Search />
		<Footer />
		{ads && <NitroGlobalAds />}
		<Analytics />
		<script>
			// Escape dismisses hover/focus tooltips until the pointer or focus moves (WCAG 1.4.13).
			const root = document.documentElement;
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') root.setAttribute('data-tooltips-dismissed', '');
			});
			const restoreTooltips = () => root.removeAttribute('data-tooltips-dismissed');
			document.addEventListener('pointerover', restoreTooltips);
			document.addEventListener('focusin', restoreTooltips);

			// Horizontally scrolling table wrappers must be reachable by keyboard (WCAG 2.1.1):
			// make each one a focusable, labelled region while it actually overflows.
			const headingBefore = (el: Element): string => {
				for (let node: Element | null = el; node && node !== document.body; node = node.parentElement) {
					for (let sib = node.previousElementSibling; sib; sib = sib.previousElementSibling) {
						const heading = sib.matches('h1,h2,h3,h4') ? sib : sib.querySelector('h1,h2,h3,h4');
						if (heading?.textContent?.trim()) return heading.textContent.trim();
					}
				}
				return '';
			};
			const labelScrollRegions = () => {
				document.querySelectorAll<HTMLElement>('.overflow-x-auto, .prose-table-scroll').forEach((wrapper) => {
					const table = wrapper.querySelector('table');
					if (!table) return;
					const overflowing = wrapper.scrollWidth > wrapper.clientWidth + 1;
					if (!overflowing) {
						if (wrapper.dataset.scrollRegion) {
							wrapper.removeAttribute('tabindex');
							wrapper.removeAttribute('role');
							wrapper.removeAttribute('aria-label');
							delete wrapper.dataset.scrollRegion;
						}
						return;
					}
					if (wrapper.dataset.scrollRegion) return;
					wrapper.dataset.scrollRegion = '1';
					wrapper.tabIndex = 0;
					wrapper.setAttribute('role', 'region');
					const name = table.caption?.textContent?.trim() || headingBefore(wrapper) || 'Table';
					wrapper.setAttribute('aria-label', `${name} (scrollable table)`);
				});
			};
			window.addEventListener('load', labelScrollRegions);
			let resizeTimer: ReturnType<typeof setTimeout> | undefined;
			window.addEventListener('resize', () => {
				if (resizeTimer) clearTimeout(resizeTimer);
				resizeTimer = setTimeout(labelScrollRegions, 200);
			});
		</script>
	</body>
</html>
