---
// Item page (every /[category]/[id] item). Answer first: the header with the "Best yield" box, then
// the recipes on the left and a right column with the item ad, the "I need" calculator and About.
// On phones the ad comes straight after the Best yield box. See DESIGN.md and the approved mockup
// (_output/design/nms/mock/item-full.html).
import { getCollection } from 'astro:content';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import UpdateChangesPanel from '@components/UpdateChangesPanel.astro';
import ItemDetails from '@components/item/ItemDetails.astro';
import ItemCalc from '@components/item/ItemCalc.astro';
import ItemAbout from '@components/item/ItemAbout.astro';
import ItemStats from '@components/item/ItemStats.astro';
import ItemGuide from '@components/item/ItemGuide.astro';
import CraftingSection from '@components/item/CraftingSection.astro';
import RefiningSection from '@components/item/RefiningSection.astro';
import CookingSection from '@components/item/CookingSection.astro';
import RefinedToCreate from '@components/item/RefinedToCreate.astro';
import CookedToCreate from '@components/item/CookedToCreate.astro';
import UsedToCreate from '@components/item/UsedToCreate.astro';
import ItemFaq from '@components/item/ItemFaq.astro';
import NitroAd from '@components/ads/NitroAd.astro';
import { getItemUpdateMeta } from '@utils/updateChanges';
import { getById, getSlug } from '@utils/lookup.js';
import type { Item } from '@utils/lookup.js';
import { getGrowTimeHeader, getPlantGrowTime } from '@utils/plantGrowTime.js';
import { createArray } from '@utils/recipeTree';
import { formatSignedPercent, formatFoodEffectStats } from '@utils/itemFormatters';
import { buildItemRecipeView, findItemGuide, getItemCategory, type HeaderPill, type ItemFact } from '@utils/itemPageContext';
import type { ItemPageSchemaResult } from '@utils/itemPageSchema';
import { SITE } from '@config';
import '../assets/css/item.css';

interface Props {
  item: Item;
  schemaResult: ItemPageSchemaResult;
  relatedLinks?: Array<{ label: string; href: string }>;
}

const { item, schemaResult, relatedLinks = [] } = Astro.props;
const itemUpdateMeta = getItemUpdateMeta(item.Id);
const originalBuilding = item.SpaceBaseVariantOf?.map(getById).find(Boolean);
const originalReward = item.RewardVariantOf ? getById(item.RewardVariantOf) : undefined;
const category = getItemCategory(item);

// Loosely typed game fields that only some catalogs have.
type ItemExtras = Item & {
  NumStatsMin?: number;
  NumStatsMax?: number;
  StatLevels?: Array<{ Name?: string; ValueMin?: number; ValueMax?: number }>;
  StatBonuses?: Array<{ Name?: string; Value?: string | number }>;
  CorvettePartCategory?: string;
  BuildableShipTechID?: string;
  BuildableShipTechName?: string;
  IsCraftable?: boolean;
  MaxStackSize?: number;
  Rarity?: string;
  Legality?: string;
  OnlyFoundInPurpleSystems?: boolean;
  DeploysInto?: string | null;
  EffectCategory?: string;
  RewardEffectStats?: Record<string, unknown> | null;
  BuildableOnPlanetBase?: boolean;
  BuildableOnFreighter?: boolean;
  BuildableOnSpaceBase?: boolean;
  Groups?: Array<{ Group?: string; SubGroupName?: string }>;
  FishingTime?: string;
  NeedsStorm?: boolean;
  FishSize?: string;
  Quality?: string;
  Biomes?: string[];
  RequiresMissionActive?: string | null;
  MissionCatchChanceOverride?: number;
  BlueprintCost?: number;
  BlueprintCostType?: string;
  ProductCategory?: string;
  SubstanceCategory?: string;
  TradeCategory?: string;
  PinObjective?: string | null;
  EconomyInfluenceMultiplier?: number;
  CurrencyType?: string;
};
const extra = item as ItemExtras;
const slugStarts = (prefix: string) => Boolean(item.Slug?.startsWith(prefix));
const isFoodItem = slugStarts('food/') || slugStarts('cooking/');
const isFishPage = slugStarts('fish/');
const isCorvettePage = slugStarts('corvette/');
const isBuildingPage = slugStarts('buildings/');
const isExocraftPage = slugStarts('exocraft/');
const isStatsPage = slugStarts('upgrades/') || slugStarts('technology/');

// ── Recipes ──
const view = buildItemRecipeView(item);
const { array: requiredItems, rawItems } = createArray(item);
const craftTree = item.RequiredItems?.length
  ? [{ Id: item.Id, Icon: item.Icon, Name: item.Name, Quantity: 1, RequiredItems: requiredItems }]
  : [];

// ── Header pills: group, value, rarity, stack, how many ways ──
const humanize = (value: string) => value.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/ (\w)/g, (_, c: string) => ` ${c.toLowerCase()}`);
const RARITY_TIERS: Record<string, string> = { Common: 'common', Uncommon: 'uncommon', Rare: 'rare', VeryRare: 'veryrare' };
const FISH_TIERS: Record<string, string> = { Junk: 'junk', Common: 'common', Rare: 'rare', Epic: 'veryrare', Legendary: 'legendary' };
const cleanGroup = item.Group && !/[%{}]|-null-/i.test(item.Group) ? item.Group : undefined;
const pills: HeaderPill[] = [];
if (cleanGroup) pills.push({ label: cleanGroup, href: `/items?group=${encodeURIComponent(item.Group)}` });
if ((item.BaseValueUnits ?? 0) > 1) pills.push({ label: `${Number(item.BaseValueUnits).toLocaleString()} units` });
const fishTier = isFishPage && extra.Quality ? FISH_TIERS[extra.Quality] : undefined;
// Fish have their own quality tier, which is what players mean by a fish's rarity.
if (!fishTier && extra.Rarity && RARITY_TIERS[extra.Rarity]) pills.push({ label: humanize(extra.Rarity), tier: RARITY_TIERS[extra.Rarity] });
// the group usually already names the tier ("Legendary Fish"); colour that pill instead of adding a second one
if (fishTier && cleanGroup && cleanGroup.toLowerCase().includes(String(extra.Quality).toLowerCase())) pills[0] = { ...pills[0], tier: fishTier };
else if (fishTier) pills.push({ label: `${extra.Quality} fish`, tier: fishTier });
// Substances store a stack multiplier of 1 here, not their real stack size, so only show real stacks.
if (typeof extra.MaxStackSize === 'number' && extra.MaxStackSize > 1) pills.push({ label: `Max stack ${extra.MaxStackSize.toLocaleString()}` });
if (view.waysToMake > 1) pills.push({ label: `${view.waysToMake} ways to make it` });
const blueprintIconByType: Record<string, string> = {
  nanites: `${SITE.imageBaseUrl}TECHFRAG_R.webp`,
  factoryoverride: `${SITE.imageBaseUrl}FACT_TOKEN.webp`,
};
const blueprintCost = extra.BlueprintCost ?? 0;
const blueprintIcon = extra.BlueprintCostType ? blueprintIconByType[extra.BlueprintCostType.toLowerCase()] : undefined;
if (blueprintCost > 0 && blueprintIcon) {
  pills.push({
    label: `Blueprint ${blueprintCost.toLocaleString()}${extra.BlueprintCostType && extra.BlueprintCostType !== 'None' ? ` ${extra.BlueprintCostType}` : ''}`,
    icon: blueprintIcon,
  });
}

// ── Details (right column) ──
const facts: ItemFact[] = [];
const addFact = (label: string, value: string | undefined | null, href?: string) => {
  if (value) facts.push({ label, value, ...(href ? { href } : {}) });
};
const yesNo = (value: boolean | undefined) => (value === true ? 'Yes' : value === false ? 'No' : undefined);
if (extra.Rarity && extra.Rarity !== 'None' && (fishTier || !RARITY_TIERS[extra.Rarity])) addFact(fishTier ? 'Item rarity' : 'Rarity', humanize(extra.Rarity));
if (extra.Legality && extra.Legality !== 'None') addFact('Legality', extra.Legality);
if (extra.OnlyFoundInPurpleSystems === true) addFact('Source', 'Purple systems only');
const deploysIntoId = extra.DeploysInto && extra.DeploysInto !== 'None' ? extra.DeploysInto : undefined;
const deploysIntoItem = deploysIntoId ? getById(deploysIntoId) : undefined;
// Only link targets that exist in the catalog; others (e.g. SEA_TRASH) have no page.
if (deploysIntoId && deploysIntoItem) addFact('Installs as', deploysIntoItem.Name, getSlug(deploysIntoId));
if (isCorvettePage) {
  addFact('Category', extra.CorvettePartCategory);
  addFact('Craftable', yesNo(extra.IsCraftable));
  const shipTechId = extra.BuildableShipTechID && extra.BuildableShipTechID !== 'None' ? extra.BuildableShipTechID : undefined;
  if (shipTechId) addFact('Ship tech', extra.BuildableShipTechName ?? getById(shipTechId)?.Name ?? shipTechId, getSlug(shipTechId));
}
if (isFoodItem) {
  addFact('Effect', extra.EffectCategory);
  formatFoodEffectStats(extra.RewardEffectStats).forEach((line) => addFact('Reward', line));
  const chance = extra.RewardEffectStats?.PercentageChance;
  if (typeof chance === 'number' && chance < 100) addFact('Chance', `${chance}%`);
}
if (isBuildingPage) {
  addFact('Planet base', yesNo(extra.BuildableOnPlanetBase));
  addFact('Freighter', yesNo(extra.BuildableOnFreighter));
  addFact('Space base', yesNo(extra.BuildableOnSpaceBase));
  (extra.Groups ?? []).forEach((group) => {
    addFact('Build menu', group.Group);
    addFact('Sub-group', group.SubGroupName);
  });
}
if (isExocraftPage) {
  addFact('Category', extra.ProductCategory);
  addFact('Type', extra.SubstanceCategory);
  if (extra.TradeCategory && extra.TradeCategory !== 'None') addFact('Trade', extra.TradeCategory);
  addFact('Craftable', yesNo(extra.IsCraftable));
  addFact(
    'How to obtain',
    extra.PinObjective === 'UI_FIND_BUY_OBJ' ? 'Find and buy' : extra.PinObjective && extra.PinObjective !== 'None' ? extra.PinObjective : undefined
  );
  if (typeof extra.EconomyInfluenceMultiplier === 'number' && extra.EconomyInfluenceMultiplier !== 0) {
    addFact('Economy influence', formatSignedPercent(extra.EconomyInfluenceMultiplier));
  }
}
if (isFishPage) {
  const time = (extra.FishingTime ?? '').toLowerCase();
  addFact('Time', time === 'both' ? 'Day or night' : time === 'day' ? 'Day' : time === 'night' ? 'Night' : extra.FishingTime);
  addFact('Size', extra.FishSize);
  if (extra.Quality && !FISH_TIERS[extra.Quality]) addFact('Quality', extra.Quality);
  const biomes = Array.isArray(extra.Biomes) ? extra.Biomes.filter(Boolean) : [];
  if (biomes.length > 0) addFact('Biomes', biomes.join(', '));
  if (extra.NeedsStorm) addFact('Weather', 'Storm required');
  // the mission id (e.g. S15_CATCHANGLER) means nothing to players: just say a mission is needed
  if (extra.RequiresMissionActive && extra.RequiresMissionActive !== 'NONE') addFact('Availability', 'Only during its mission');
  if (typeof extra.MissionCatchChanceOverride === 'number' && extra.MissionCatchChanceOverride > 0) {
    addFact('Catch chance', `${(extra.MissionCatchChanceOverride * 100).toLocaleString()}%`);
  }
}
const plantGrowTime = getPlantGrowTime(item.Id);
if (plantGrowTime) addFact(getGrowTimeHeader(), plantGrowTime);
addFact('Data updated', SITE.version_date);

// ── Stats (upgrades, technology) ──
const statLevels = (extra.StatLevels ?? []).map((stat) => ({
  name: stat.Name ?? 'Unknown Stat',
  min: typeof stat.ValueMin === 'number' ? stat.ValueMin : undefined,
  max: typeof stat.ValueMax === 'number' ? stat.ValueMax : undefined,
}));
const statBonuses = (extra.StatBonuses ?? []).map((stat) => {
  const parsed = typeof stat.Value === 'string' ? Number(stat.Value) : stat.Value;
  const value = typeof parsed === 'number' && Number.isFinite(parsed) ? parsed : undefined;
  return { name: stat.Name ?? 'Unknown Bonus', min: value, max: value };
});
const upgradeStats = isStatsPage ? (statLevels.length > 0 ? statLevels : statBonuses) : [];

// ── Guide: the blog post about this item, if any ──
const posts = await getCollection('blog');
const guideEntry = findItemGuide(
  item.Name,
  posts.map((post) => ({ id: post.id, title: post.data.title, description: post.data.description, heroImage: post.data.heroImage }))
);

const { faqQuestions, answerSummary } = schemaResult;
// The Best yield box already shows a single recipe or a one-level craft, so the open lists only
// appear when they add something: more than one recipe, or crafted parts with their own recipes.
const showTree = (craftTree[0]?.RequiredItems ?? []).some((part) => part.RequiredItems.length > 0);
const refineRows = view.makeRefine.length > 1 ? view.makeRefine : [];
const cookRows = view.makeCook.length > 1 ? view.makeCook : [];
const showCalc = Boolean(view.craft || view.bestRefine || view.bestCook);
// Rough height of the left column in rows. When it's short, the "uses" sections, guide and FAQ move
// up into it so the right column (ad, calculator, About) doesn't stand beside an empty gap.
const mainWeight =
  (showTree ? 6 : 0) + Math.min(refineRows.length, 8) + Math.min(cookRows.length, 8) + (upgradeStats.length > 0 ? 3 : 0);
const restInMain = mainWeight < 7;
// Nothing to make: the in-game description is the answer, so it leads the left column (above any uses),
// and the right column keeps only the ad and calculator instead of a long About beside an empty gap.
const aboutInMain = mainWeight === 0;
---

<div class="item-page">
  <Breadcrumbs
    className="!px-0"
    items={[
      { name: 'Home', href: '/' },
      { name: category.name, href: category.path },
      { name: item.Name },
    ]}
  />

  <ItemDetails
    item={item}
    answerSummary={answerSummary}
    pills={pills}
    relatedLinks={relatedLinks}
    bestRefine={view.bestRefine}
    quickestRefine={view.quickestRefine}
    craft={view.craft}
    bestCook={view.bestCook}
  />

  {(originalBuilding || originalReward || itemUpdateMeta) && (
    <div class="mt-4 grid gap-2">
      {itemUpdateMeta && <UpdateChangesPanel meta={itemUpdateMeta} />}
      {originalBuilding && (
        <p class="panel m-0 px-4 py-3 text-[.9rem] text-dim">
          Orbital-base version of <a class="link" href={getSlug(originalBuilding)}>{originalBuilding.Name}</a>.
        </p>
      )}
      {originalReward && (
        <p class="panel m-0 px-4 py-3 text-[.9rem] text-dim">
          Reward version of <a class="link" href={getSlug(originalReward)}>{originalReward.Name}</a>.
        </p>
      )}
    </div>
  )}

  <div class:list={['item-body', !showCalc && 'no-answer']}>
    <div class="item-ad">
      <NitroAd
        id="item-after-details"
        class="my-0!"
        minHeight={280}
        sizes={[
          [300, 250],
          [336, 280],
          [728, 90],
          [320, 100],
          [320, 50],
        ]}
      />
    </div>

    {showCalc && (
      <div class="item-calc-wrap">
        <ItemCalc itemName={item.Name} best={view.bestRefine ?? view.bestCook} craft={view.craft} hasTree={showTree} />
      </div>
    )}

    <div class="item-main">
      {aboutInMain && <ItemAbout description={item.Description} facts={facts} />}
      {showTree && <CraftingSection item={item} data={craftTree} rawItems={rawItems} isFoodItem={isFoodItem} />}
      <RefiningSection item={item} rows={refineRows} />
      <CookingSection item={item} rows={cookRows} />
      <ItemStats min={extra.NumStatsMin} max={extra.NumStatsMax} stats={upgradeStats} />
      {restInMain && (
        <>
          <RefinedToCreate rows={view.refineInto} />
          <CookedToCreate rows={view.cookInto} />
          <UsedToCreate item={item} tiles={view.craftWith} categories={view.craftWithCategories} />
          {guideEntry && <ItemGuide guide={guideEntry} />}
          <ItemFaq faqQuestions={faqQuestions} />
        </>
      )}
    </div>

    {!aboutInMain && (
      <div class="item-aside">
        <ItemAbout description={item.Description} facts={facts} />
      </div>
    )}
  </div>

  {!restInMain && (
    <div class="item-rest">
      <RefinedToCreate rows={view.refineInto} />
      <CookedToCreate rows={view.cookInto} />
      <UsedToCreate item={item} tiles={view.craftWith} categories={view.craftWithCategories} />
      {guideEntry && <ItemGuide guide={guideEntry} />}
      <ItemFaq faqQuestions={faqQuestions} />
    </div>
  )}
</div>
