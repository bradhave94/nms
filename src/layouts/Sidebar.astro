---
import NitroAd from '@components/ads/NitroAd.astro';
import NavLink from '@components/NavLink.astro';
import { icons } from './navIcons';
import { toolsNav, calculatorsNav, catalogsNav, moreNav, normalizePath, bestMatchHref, type NavItem } from '../config/nav';

interface Props {
	slug?: string;
	showAds?: boolean;
}

const { showAds = true } = Astro.props;
const pathname = Astro.url.pathname;

const activeHref = bestMatchHref(pathname, [...toolsNav, ...calculatorsNav, ...catalogsNav, ...moreNav].map((i) => i.href));
const isActive = (href: string): boolean => activeHref !== null && href === activeHref;
// "page" only on the exact page; a section match (e.g. an item under /products/) gets "true".
const current = (href: string): 'page' | 'true' | undefined =>
	normalizePath(pathname) === normalizePath(href) ? 'page' : isActive(href) ? 'true' : undefined;
const calculatorsActive = calculatorsNav.some((i) => isActive(i.href));
const catalogsActive = catalogsNav.some((i) => isActive(i.href));

// Disclosure groups (Calculators, Catalogs): a flyout on desktop, an accordion in the mobile drawer.
const groups: { id: string; label: string; trigger: string; icon: string; items: NavItem[]; active: boolean; cols: number }[] = [
	{ id: 'calculators', label: 'Calculators', trigger: 'All calculators', icon: 'calculator', items: calculatorsNav, active: calculatorsActive, cols: 1 },
	{ id: 'catalogs', label: 'Catalogs', trigger: 'All catalogs', icon: 'squares-2x2', items: catalogsNav, active: catalogsActive, cols: 2 },
];
const chevronRight = 'M16.28 11.47a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 0 1-1.06-1.06L14.69 12 7.72 5.03a.75.75 0 0 1 1.06-1.06l7.5 7.5Z';
const chevronDown = 'M12.53 16.28a.75.75 0 0 1-1.06 0l-7.5-7.5a.75.75 0 0 1 1.06-1.06L12 14.69l6.97-6.97a.75.75 0 1 1 1.06 1.06l-7.5 7.5Z';
const searchPath = 'M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z';
const closePath = 'M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z';
const menuPath = 'M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z';
---

<div>
	<!-- Mobile drawer -->
	<div id="mobile-sidebar" class="pointer-events-none fixed inset-0 z-40 lg:hidden" aria-hidden="true" inert>
		<div id="mobile-backdrop" class="fixed inset-0 bg-black/75 opacity-0 transition-opacity duration-300 ease-linear"></div>
		<div class="fixed inset-0 z-40 flex">
			<div id="mobile-panel" role="dialog" aria-modal="true" aria-label="Site menu"
				class="relative flex w-full max-w-xs flex-1 -translate-x-full flex-col overflow-hidden border-r border-line bg-[#05080b] transition-transform duration-300 ease-in-out">
				<div class="flex shrink-0 items-center justify-between gap-2 px-4 pt-4 pb-2">
					<a href="/" class="inline-flex min-h-11 min-w-0 flex-1 items-center"><img class="block h-auto w-full max-w-[12.5rem]" src="/images/logo-nms.webp" width="600" height="57" alt="No Man's Sky Recipes" /></a>
					<button id="sidebar-close" type="button" class="icon-btn">
						<span class="sr-only">Close menu</span>
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={closePath} clip-rule="evenodd"></path></svg>
					</button>
				</div>
				<div class="h-0 flex-1 overflow-y-auto px-2 pb-6">
					<button type="button" data-open-search class="search-trigger mt-2"><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={searchPath} clip-rule="evenodd"></path></svg>Search items and recipes</button>
					<nav aria-label="Site navigation">
						<p class="nav-label">Tools</p>
						{toolsNav.map((item) => <NavLink item={item} active={isActive(item.href)} current={current(item.href)} />)}
						{groups.map((g) => (
							<Fragment>
								<p class="nav-label" id={`nav-${g.id}-label-mobile`}>{g.label}</p>
								<button data-accordion-btn={g.id} type="button" class:list={['nav-link w-full', g.active && 'is-active']}
									aria-expanded={g.active ? 'true' : 'false'} aria-controls={`${g.id}-accordion-panel`}>
									<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">{icons[g.icon].map((p) => <path d={p.d} fill-rule={p.fillRule} clip-rule={p.clipRule} />)}</svg>
									{g.trigger}
									<svg class:list={['chev ml-auto', g.active && 'rotate-180']} data-accordion-chevron={g.id} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={chevronDown} clip-rule="evenodd"></path></svg>
								</button>
								<div id={`${g.id}-accordion-panel`} data-accordion-panel={g.id} class:list={['mt-0.5 space-y-0.5 pl-3', !g.active && 'hidden']} role="region" aria-labelledby={`nav-${g.id}-label-mobile`}>
									{g.items.map((item) => <NavLink item={item} active={isActive(item.href)} current={current(item.href)} />)}
								</div>
							</Fragment>
						))}
						<p class="nav-label">More</p>
						{moreNav.map((item) => <NavLink item={item} active={isActive(item.href)} current={current(item.href)} />)}
					</nav>
				</div>
			</div>
			<div class="w-14 shrink-0"></div>
		</div>
	</div>

	<!-- Desktop sidebar: 224px. The menu stays short so the 160x300 unit under it is on the first screen. -->
	<div id="desktop-sidebar" class="hidden lg:fixed lg:inset-y-0 lg:z-30 lg:flex lg:w-56 lg:flex-col">
		<div class="flex min-h-0 flex-1 flex-col overflow-hidden border-r border-[#141c26] bg-[#05080b]">
			<div class="flex min-h-0 flex-1 flex-col overflow-hidden pt-3 pb-3">
				<header>
				<a href="/" class="mb-1 box-border block w-full shrink-0 px-3 py-1"><img class="block h-auto w-full max-w-[12.5rem]" src="/images/logo-nms.webp" width="600" height="57" alt="No Man's Sky Recipes" /></a>
				<div class="px-2"><button type="button" data-open-search class="search-trigger mt-2"><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={searchPath} clip-rule="evenodd"></path></svg>Search<kbd aria-hidden="true">/</kbd></button></div>
				</header>
				<nav class="mt-1 flex shrink-0 flex-col px-2" aria-label="Site navigation">
					<p class="nav-label">Tools</p>
					{toolsNav.map((item) => <NavLink item={item} active={isActive(item.href)} current={current(item.href)} />)}
					{groups.map((g) => (
						<Fragment>
							<p class="nav-label">{g.label}</p>
							<button data-flyout-trigger={g.id} type="button" class:list={['nav-link w-full', g.active && 'is-active']} aria-expanded="false" aria-controls={`${g.id}-flyout`}>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">{icons[g.icon].map((p) => <path d={p.d} fill-rule={p.fillRule} clip-rule={p.clipRule} />)}</svg>
								{g.trigger}
								<svg class="chev ml-auto" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={chevronRight} clip-rule="evenodd"></path></svg>
							</button>
							<div id={`${g.id}-flyout`} data-flyout={g.id} class="fixed z-50 hidden pl-2">
								<div class="max-h-[calc(100vh-2rem)] overflow-y-auto rounded-xl border border-line bg-[#0b1017] p-2 shadow-2xl shadow-black/60">
									<div class:list={['grid gap-0.5', g.cols === 2 ? 'grid-cols-2' : 'grid-cols-1']}>
										{g.items.map((item) => <NavLink item={item} active={isActive(item.href)} current={current(item.href)} />)}
									</div>
								</div>
							</div>
						</Fragment>
					))}
					<p class="nav-label">More</p>
					{moreNav.map((item) => <NavLink item={item} active={isActive(item.href)} current={current(item.href)} />)}
				</nav>
				{showAds && <NitroAd id="nav-left" class="nav-left-ad my-0 mt-4 max-h-[300px] min-h-[300px] w-[160px] max-w-[160px] overflow-hidden px-0" minHeight={300} sizes={[[160, 300]]} mediaQuery="(min-width: 1024px)" />}
			</div>
		</div>
	</div>

	<div class="flex flex-1 flex-col lg:pl-56">
		<header class="sticky top-0 z-10 flex items-center gap-2 border-b border-[#141c26] bg-[#05080b]/95 px-3 py-2 backdrop-blur lg:hidden">
			<a href="/" class="mr-auto inline-flex min-h-11 min-w-0 items-center"><img class="block h-4 w-auto object-contain object-left" src="/images/logo-nms.webp" width="600" height="57" alt="No Man's Sky Recipes" /></a>
			<button type="button" data-open-search class="icon-btn"><span class="sr-only">Search</span><svg class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={searchPath} clip-rule="evenodd"></path></svg></button>
			<button id="sidebar-open" type="button" aria-expanded="false" aria-controls="mobile-sidebar" class="icon-btn">
				<span class="sr-only">Open menu</span>
				<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={menuPath} clip-rule="evenodd"></path></svg>
			</button>
		</header>
		<main id="main-content" class="flex-1" tabindex="-1">
			<div class="page-col mx-auto min-h-screen max-w-[1260px] px-4 py-4 lg:px-8">
				<slot name="layout" />
			</div>
		</main>
	</div>
</div>

<style is:global>
	.nav-label { margin: 0; padding: .85rem .6rem .3rem; font-size: .8125rem; font-weight: 500; color: var(--color-dim); }
	.nav-link { display: flex; align-items: center; gap: .65rem; min-height: 44px; padding: .3rem .6rem; border-radius: 8px; font-size: 1.0625rem; line-height: 1.2; color: var(--color-ink); text-align: left; transition: background-color .15s, color .15s; }
	.nav-link > svg:first-child { width: 1.15rem; height: 1.15rem; flex: none; color: #7f90a4; transition: color .15s; }
	.nav-link .chev { width: 1rem; height: 1rem; flex: none; color: #7f90a4; transition: transform .2s; }
	.nav-link:hover { background: var(--color-panel-3); }
	.nav-link.is-active { background: rgb(255 195 86 / .13); color: var(--color-accent); }
	.nav-link.is-active > svg { color: var(--color-accent); }
	.search-trigger { display: flex; align-items: center; gap: .55rem; width: 100%; min-height: 42px; padding: 0 .75rem; border-radius: 10px; border: 1px solid var(--color-line-strong); background: var(--color-panel-2); color: var(--color-dim); font-size: .95rem; text-align: left; transition: border-color .15s; }
	.search-trigger:hover { border-color: var(--color-accent); }
	.search-trigger svg { width: 1.05rem; height: 1.05rem; flex: none; }
	.search-trigger kbd { margin-left: auto; padding: 0 .4rem; border: 1px solid var(--color-line-strong); border-radius: 5px; font: 600 .75rem var(--font-sans); color: var(--color-dim); }
	.icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: none; border-radius: 12px; border: 1px solid var(--color-line); background: var(--color-panel-2); color: var(--color-ink); }
	.icon-btn:hover { border-color: var(--color-accent); }
</style>

<script>
	const OPEN_DELAY = 120;
	const CLOSE_DELAY = 250;
	const LG_QUERY = '(min-width: 1024px)';

	// Mobile drawer
	const mobileSidebar = document.getElementById('mobile-sidebar');
	const mobileBackdrop = document.getElementById('mobile-backdrop');
	const mobilePanel = document.getElementById('mobile-panel');
	const sidebarOpenBtn = document.getElementById('sidebar-open');
	const sidebarCloseBtn = document.getElementById('sidebar-close');

	function openMobileDrawer(): void {
		if (!mobileSidebar || !mobileBackdrop || !mobilePanel) return;
		mobileSidebar.classList.remove('pointer-events-none');
		mobileSidebar.setAttribute('aria-hidden', 'false');
		mobileSidebar.inert = false;
		sidebarOpenBtn?.setAttribute('aria-expanded', 'true');
		mobileBackdrop.classList.remove('opacity-0');
		mobileBackdrop.classList.add('opacity-100');
		mobilePanel.classList.remove('-translate-x-full');
		mobilePanel.classList.add('translate-x-0');
		document.body.classList.add('overflow-hidden');
		sidebarCloseBtn?.focus();
	}

	function closeMobileDrawer(): void {
		if (!mobileSidebar || !mobileBackdrop || !mobilePanel) return;
		mobileSidebar.classList.add('pointer-events-none');
		const hadFocus = mobileSidebar.contains(document.activeElement);
		mobileSidebar.setAttribute('aria-hidden', 'true');
		mobileSidebar.inert = true;
		sidebarOpenBtn?.setAttribute('aria-expanded', 'false');
		if (hadFocus) sidebarOpenBtn?.focus();
		mobileBackdrop.classList.remove('opacity-100');
		mobileBackdrop.classList.add('opacity-0');
		mobilePanel.classList.remove('translate-x-0');
		mobilePanel.classList.add('-translate-x-full');
		document.body.classList.remove('overflow-hidden');
	}

	sidebarOpenBtn?.addEventListener('click', openMobileDrawer);
	sidebarCloseBtn?.addEventListener('click', closeMobileDrawer);
	mobileBackdrop?.addEventListener('click', closeMobileDrawer);

	// Mobile nav accordions
	document.querySelectorAll<HTMLElement>('[data-accordion-btn]').forEach((accordionBtn) => {
		const id = accordionBtn.getAttribute('data-accordion-btn');
		if (!id) return;
		const accordionPanel = document.querySelector<HTMLElement>(`[data-accordion-panel="${id}"]`);
		const accordionChevron = document.querySelector<HTMLElement>(`[data-accordion-chevron="${id}"]`);

		accordionBtn.addEventListener('click', () => {
			const expanded = accordionBtn.getAttribute('aria-expanded') === 'true';
			const nextExpanded = !expanded;
			accordionBtn.setAttribute('aria-expanded', String(nextExpanded));
			accordionPanel?.classList.toggle('hidden', !nextExpanded);
			accordionChevron?.classList.toggle('rotate-180', nextExpanded);
		});
	});

	// Desktop nav flyouts
	type FlyoutGroup = {
		trigger: HTMLElement;
		flyout: HTMLElement;
		openTimer: ReturnType<typeof setTimeout> | null;
		closeTimer: ReturnType<typeof setTimeout> | null;
		open: boolean;
	};

	const flyoutGroups: FlyoutGroup[] = [];

	function isLargeScreen(): boolean {
		return window.matchMedia(LG_QUERY).matches;
	}

	function clearFlyoutTimers(group: FlyoutGroup): void {
		if (group.openTimer) {
			clearTimeout(group.openTimer);
			group.openTimer = null;
		}
		if (group.closeTimer) {
			clearTimeout(group.closeTimer);
			group.closeTimer = null;
		}
	}

	function positionFlyout(group: FlyoutGroup): void {
		const rect = group.trigger.getBoundingClientRect();
		const sidebar = document.getElementById('desktop-sidebar');
		const left = sidebar ? sidebar.getBoundingClientRect().right : 224;
		group.flyout.style.top = `${rect.top}px`;
		group.flyout.style.left = `${left}px`;
	}

	function setFlyoutOpen(group: FlyoutGroup, open: boolean, focusFirstLink = false): void {
		group.open = open;
		group.flyout.classList.toggle('hidden', !open);
		group.trigger.setAttribute('aria-expanded', String(open));
		if (open) {
			positionFlyout(group);
			if (focusFirstLink) {
				const firstLink = group.flyout.querySelector<HTMLAnchorElement>('a');
				firstLink?.focus();
			}
		}
	}

	function scheduleFlyoutOpen(group: FlyoutGroup): void {
		if (!isLargeScreen()) return;
		clearFlyoutTimers(group);
		group.closeTimer = null;
		group.openTimer = setTimeout(() => setFlyoutOpen(group, true), OPEN_DELAY);
	}

	function scheduleFlyoutClose(group: FlyoutGroup): void {
		if (!isLargeScreen()) return;
		clearFlyoutTimers(group);
		group.openTimer = null;
		group.closeTimer = setTimeout(() => setFlyoutOpen(group, false), CLOSE_DELAY);
	}

	function bindHoverZone(group: FlyoutGroup, element: HTMLElement | null): void {
		element?.addEventListener('mouseenter', () => scheduleFlyoutOpen(group));
		element?.addEventListener('mouseleave', () => scheduleFlyoutClose(group));
	}

	document.querySelectorAll<HTMLElement>('[data-flyout-trigger]').forEach((trigger) => {
		const id = trigger.getAttribute('data-flyout-trigger');
		if (!id) return;
		const flyout = document.querySelector<HTMLElement>(`[data-flyout="${id}"]`);
		if (!flyout) return;

		const group: FlyoutGroup = {
			trigger,
			flyout,
			openTimer: null,
			closeTimer: null,
			open: false,
		};
		flyoutGroups.push(group);

		bindHoverZone(group, trigger);
		bindHoverZone(group, flyout);

		trigger.addEventListener('blur', (event) => {
			if (!isLargeScreen()) return;
			const related = event.relatedTarget as Node | null;
			if (related && flyout.contains(related)) return;
			scheduleFlyoutClose(group);
		});

		flyout.addEventListener('focusout', (event) => {
			if (!isLargeScreen() || !group.open) return;
			const related = event.relatedTarget as Node | null;
			if (related && (flyout.contains(related) || trigger.contains(related))) return;
			scheduleFlyoutClose(group);
		});

		trigger.addEventListener('click', (event) => {
			if (!isLargeScreen()) return;
			event.preventDefault();
			clearFlyoutTimers(group);
			if (group.open) {
				setFlyoutOpen(group, false);
			} else {
				const fromKeyboard = event.detail === 0;
				setFlyoutOpen(group, true, fromKeyboard);
			}
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isLargeScreen()) {
			const openGroup = flyoutGroups.find((group) => group.open);
			if (openGroup) {
				event.preventDefault();
				clearFlyoutTimers(openGroup);
				setFlyoutOpen(openGroup, false);
				openGroup.trigger.focus();
			}
		}
		if (event.key === 'Escape' && mobileSidebar?.getAttribute('aria-hidden') === 'false') {
			closeMobileDrawer();
		}
		// Keep Tab inside the open mobile drawer (it is a modal dialog).
		if (event.key === 'Tab' && mobilePanel && mobileSidebar?.getAttribute('aria-hidden') === 'false') {
			const focusables = Array.from(
				mobilePanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
			).filter((el) => el.offsetParent !== null);
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			if (!first || !last) return;
			const active = document.activeElement;
			if (event.shiftKey && (active === first || !mobilePanel.contains(active))) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && (active === last || !mobilePanel.contains(active))) {
				event.preventDefault();
				first.focus();
			}
		}
	});

	window.addEventListener('resize', () => {
		for (const group of flyoutGroups) {
			if (group.open) positionFlyout(group);
			if (!isLargeScreen()) {
				clearFlyoutTimers(group);
				setFlyoutOpen(group, false);
			}
		}
	});

	window.addEventListener('scroll', () => {
		for (const group of flyoutGroups) {
			if (group.open) positionFlyout(group);
		}
	}, true);
</script>
