---
// Filterable item grid for the catalog pages, /items and the calculator picker.
// - The first `initialCount` tiles are server-rendered (links work without JS, crawlers see them).
// - The full list ships inline as compact JSON, pre-sorted A–Z by the page; the script filters on
//   `input`, sorts by value on request, and appends more tiles as you scroll.
// - The optional `ad` slot is placed after the first row of tiles (CSS `order`, see lists.css).
import CompactCard from '@components/CompactCard.astro';

export interface FilterItem {
	name: string;
	group?: string | null;
	/** Icon file name (the WebP copy), joined to `imageBase`. */
	icon: string;
	link: string;
	colour?: string | null;
	value?: number | null;
	/** Category segment of the link (`products`, `raw`, ...); used by the category filter on /items. */
	type?: string;
}

interface Props {
	/** Unique id prefix for this list. */
	id: string;
	/** Path the filter state is written to (query string), e.g. `/buildings`. */
	basePath: string;
	/** Every item in the list, already sorted A–Z. */
	items: FilterItem[];
	imageBase: string;
	/** How many tiles are rendered on the server. */
	initialCount?: number;
	searchLabel?: string;
	searchPlaceholder?: string;
	/** Category options for /items. */
	types?: Array<{ value: string; label: string }>;
	showGroups?: boolean;
	/** [singular, plural] for the result count. */
	noun?: [string, string];
}

const {
	id,
	basePath,
	items,
	imageBase,
	initialCount = 80,
	searchLabel = 'Search by name or group',
	searchPlaceholder = 'Type a name…',
	types,
	showGroups = true,
	noun = ['item', 'items'],
} = Astro.props;

const groups = [...new Set(items.map((item) => item.group).filter((g): g is string => Boolean(g)))].sort((a, b) =>
	a.localeCompare(b)
);
const groupIndex = new Map(groups.map((g, i) => [g, i]));
const typeValues = types?.map((t) => t.value) ?? [];
const typeIndex = new Map(typeValues.map((t, i) => [t, i]));
const rows = items.map((item) => [
	item.name,
	item.group ? groupIndex.get(item.group) ?? -1 : -1,
	item.icon,
	item.link,
	(item.colour ?? '').replace(/^#/, ''),
	item.value ?? 0,
	item.type !== undefined ? typeIndex.get(item.type) ?? -1 : -1,
]);
const payload = JSON.stringify({
	rows,
	groups,
	types: typeValues,
	imageBase,
	basePath,
	initial: Math.min(initialCount, items.length),
	noun,
}).replace(/</g, '\\u003c');
const initialItems = items.slice(0, initialCount);
const hasAd = Astro.slots.has('ad');
const total = items.length;
---

<div data-tile-list class="tile-list">
	<script type="application/json" set:html={payload} />
	<form class="list-filter panel" role="search" aria-label={`Filter ${noun[1]}`} data-filter-form>
		<div class="lf-search">
			<label for={`${id}-q`}>{searchLabel}</label>
			<input id={`${id}-q`} type="search" class="field" placeholder={searchPlaceholder} autocomplete="off" spellcheck="false" data-q />
		</div>
		{
			types && types.length > 0 && (
				<div class="lf-select">
					<label for={`${id}-type`}>Category</label>
					<select id={`${id}-type`} class="field" data-type>
						<option value="">All categories</option>
						{types.map((t) => (
							<option value={t.value}>{t.label}</option>
						))}
					</select>
				</div>
			)
		}
		{
			showGroups && groups.length > 1 && (
				<div class="lf-select">
					<label for={`${id}-group`}>Group</label>
					<select id={`${id}-group`} class="field" data-group>
						<option value="">All groups</option>
						{groups.map((g) => (
							<option value={g}>{g}</option>
						))}
					</select>
				</div>
			)
		}
		<div>
			<span class="lf-label" id={`${id}-sort-label`}>Sort</span>
			<div class="lf-sort" role="group" aria-labelledby={`${id}-sort-label`}>
				<button type="button" class="btn-quiet" aria-pressed="true" data-sort="az">A–Z</button>
				<button type="button" class="btn-quiet" aria-pressed="false" data-sort="value">Value</button>
			</div>
		</div>
	</form>
	<p class="list-status">
		<span aria-hidden="true" data-status-visible><span class="tabular">{total.toLocaleString('en-US')}</span> {total === 1 ? noun[0] : noun[1]}</span>
		<span class="sr-only" role="status" data-status></span>
	</p>
	<div class="list-empty panel" hidden data-empty>
		<p class="mb-3">Nothing matches. Try a shorter name or another group.</p>
		<button type="button" class="btn-quiet" data-reset>Clear filters</button>
	</div>
	<div class="tile-grid" id={`${id}-items`} data-grid>
		{initialItems.map((item, index) => (
			<CompactCard
				card={{ name: item.name, image: imageBase + item.icon, link: item.link, colour: item.colour, group: item.group }}
				index={index}
				loading={index < 20 ? 'eager' : 'lazy'}
			/>
		))}
		{hasAd && (
			<div class="grid-ad" data-ad>
				<slot name="ad" />
			</div>
		)}
	</div>
	<div class="h-1 w-full" aria-hidden="true" data-sentinel></div>
</div>

<script>
	type Row = [string, number, string, string, string, number, number];
	interface Payload {
		rows: Row[];
		groups: string[];
		types: string[];
		imageBase: string;
		basePath: string;
		initial: number;
		noun: [string, string];
	}

	const BATCH = 120;
	const HEX = /^[0-9a-f]{6}$/i;

	function initList(root: HTMLElement) {
		const dataEl = root.querySelector('script[type="application/json"]');
		if (!dataEl?.textContent) return;
		const data = JSON.parse(dataEl.textContent) as Payload;
		const form = root.querySelector<HTMLFormElement>('[data-filter-form]');
		const qInput = root.querySelector<HTMLInputElement>('[data-q]');
		const groupSelect = root.querySelector<HTMLSelectElement>('[data-group]');
		const typeSelect = root.querySelector<HTMLSelectElement>('[data-type]');
		const sortButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-sort]')];
		const statusEl = root.querySelector<HTMLElement>('[data-status]');
		const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
		const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]');
		const grid = root.querySelector<HTMLElement>('[data-grid]');
		const adEl = root.querySelector<HTMLElement>('[data-ad]');
		const sentinel = root.querySelector<HTMLElement>('[data-sentinel]');
		if (!grid || !sentinel) return;

		const allGroupOptions = data.groups;
		let sortMode: 'az' | 'value' = 'az';
		let list: Row[] = data.rows;
		let shown = data.initial;
		let announceTimer: number | undefined;

		const fmt = (n: number) => n.toLocaleString('en-US');

		function tile(row: Row): HTMLElement {
			const [name, gi, icon, link, colour, value] = row;
			const a = document.createElement('a');
			a.className = 'tile';
			a.href = link.startsWith('/') && !link.startsWith('//') ? link : '#';
			const slot = document.createElement('span');
			slot.className = 'slot';
			if (HEX.test(colour)) slot.style.setProperty('--c', `#${colour}`);
			const img = document.createElement('img');
			img.src = data.imageBase + icon;
			img.alt = '';
			img.width = 48;
			img.height = 48;
			img.loading = 'lazy';
			img.decoding = 'async';
			slot.append(img);
			const text = document.createElement('span');
			text.className = 'tile-text';
			const nameEl = document.createElement('span');
			nameEl.className = 'tile-name';
			nameEl.textContent = name;
			text.append(nameEl);
			const metaParts: string[] = [];
			if (gi >= 0) metaParts.push(data.groups[gi]);
			if (sortMode === 'value' && value > 0) metaParts.push(`${fmt(value)} units`);
			if (metaParts.length) {
				const meta = document.createElement('span');
				meta.className = 'tile-meta';
				meta.textContent = metaParts.join(' · ');
				text.append(meta);
			}
			a.append(slot, text);
			const cell = document.createElement('article');
			cell.className = 'tile-cell';
			cell.append(a);
			return cell;
		}

		function appendBatch() {
			const end = Math.min(shown + BATCH, list.length);
			if (end <= shown) return;
			const frag = document.createDocumentFragment();
			for (let i = shown; i < end; i++) frag.append(tile(list[i]));
			grid!.insertBefore(frag, adEl);
			shown = end;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries[0]?.isIntersecting || shown >= list.length) return;
				appendBatch();
				// re-arm so a still-visible sentinel fires again
				observer.unobserve(sentinel);
				observer.observe(sentinel);
			},
			{ rootMargin: '900px 0px' }
		);

		function state() {
			return {
				q: qInput?.value.trim() ?? '',
				group: groupSelect?.value ?? '',
				type: typeSelect?.value ?? '',
			};
		}

		function statusText(count: number) {
			const { q, group, type } = state();
			const word = count === 1 ? data.noun[0] : data.noun[1];
			if (!q && !group && !type) return `${fmt(count)} ${word}`;
			return `${fmt(count)} of ${fmt(data.rows.length)} ${data.noun[1]}${q ? ` matching “${q}”` : ''}`;
		}

		// the visible count updates at once; the screen-reader announcement waits for typing to settle
		const visibleEl = root.querySelector<HTMLElement>('[data-status-visible]');
		function setStatus(text: string, announce: boolean) {
			if (visibleEl) visibleEl.textContent = text;
			if (!statusEl) return;
			window.clearTimeout(announceTimer);
			if (!announce) {
				statusEl.textContent = text;
				return;
			}
			// one announcement after typing settles
			announceTimer = window.setTimeout(() => (statusEl.textContent = text), 450);
		}

		function refreshGroups() {
			if (!groupSelect || !typeSelect) return;
			const type = typeSelect.value;
			const ti = type ? data.types.indexOf(type) : -1;
			const allowed = new Set<number>();
			for (const r of data.rows) if (ti < 0 || r[6] === ti) allowed.add(r[1]);
			const current = groupSelect.value;
			groupSelect.replaceChildren(new Option('All groups', ''));
			allGroupOptions.forEach((g, i) => {
				if (allowed.has(i)) groupSelect.append(new Option(g, g));
			});
			groupSelect.value = [...groupSelect.options].some((o) => o.value === current) ? current : '';
		}

		function writeUrl() {
			const { q, group, type } = state();
			const params = new URLSearchParams();
			if (group) params.set('group', group);
			if (type) params.set('type', type);
			if (q) params.set('q', q);
			if (sortMode === 'value') params.set('sort', 'value');
			const query = params.toString();
			window.history.replaceState(window.history.state, '', `${data.basePath.replace(/\/+$/, '')}/${query ? `?${query}` : ''}`);
		}

		function apply(announce = true) {
			const { q, group, type } = state();
			const needle = q.toLowerCase();
			const gi = group ? data.groups.indexOf(group) : -1;
			const ti = type ? data.types.indexOf(type) : -1;
			let next = data.rows.filter((r) => {
				if (gi >= 0 && r[1] !== gi) return false;
				if (ti >= 0 && r[6] !== ti) return false;
				if (needle) {
					const g = r[1] >= 0 ? data.groups[r[1]].toLowerCase() : '';
					if (!r[0].toLowerCase().includes(needle) && !g.includes(needle)) return false;
				}
				return true;
			});
			if (sortMode === 'value') {
				next = next
					.map((r, i) => [r, i] as const)
					.sort((a, b) => b[0][5] - a[0][5] || a[1] - b[1])
					.map(([r]) => r);
			}
			list = next;
			grid!.querySelectorAll('.tile-cell').forEach((el) => el.remove());
			shown = 0;
			appendBatch();
			if (emptyEl) emptyEl.hidden = list.length > 0;
			setStatus(statusText(list.length), announce);
			writeUrl();
		}

		function setSort(mode: 'az' | 'value') {
			sortMode = mode;
			sortButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === mode)));
		}

		// state from the URL (old links used ?group=, ?type= and ?q=)
		const params = new URLSearchParams(window.location.search);
		const pType = params.get('type')?.toLowerCase() ?? '';
		if (typeSelect && pType && data.types.includes(pType)) typeSelect.value = pType;
		refreshGroups();
		const pGroup = params.get('group')?.trim() ?? '';
		if (groupSelect && pGroup) {
			const match = [...groupSelect.options].find((o) => o.value.toLowerCase() === pGroup.toLowerCase())
				?? [...groupSelect.options].find((o) => o.value && o.value.toLowerCase().includes(pGroup.toLowerCase()));
			if (match) groupSelect.value = match.value;
		}
		if (qInput) qInput.value = params.get('q') ?? '';
		if (params.get('sort') === 'value') setSort('value');
		const { q, group, type } = state();
		if (q || group || type || sortMode !== 'az') apply(false);

		qInput?.addEventListener('input', () => apply());
		groupSelect?.addEventListener('change', () => apply());
		typeSelect?.addEventListener('change', () => {
			refreshGroups();
			apply();
		});
		sortButtons.forEach((b) =>
			b.addEventListener('click', () => {
				setSort(b.dataset.sort === 'value' ? 'value' : 'az');
				apply();
			})
		);
		form?.addEventListener('submit', (e) => e.preventDefault());
		resetBtn?.addEventListener('click', () => {
			if (qInput) qInput.value = '';
			if (typeSelect) typeSelect.value = '';
			refreshGroups();
			if (groupSelect) groupSelect.value = '';
			setSort('az');
			apply();
			qInput?.focus();
		});

		observer.observe(sentinel);
	}

	document.querySelectorAll<HTMLElement>('[data-tile-list]').forEach(initList);
</script>
