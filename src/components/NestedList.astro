---
// Crafting tree: components that are themselves crafted open as nested disclosures; raw
// ingredients are links. Amounts carry `data-quantity` so the "I need" box can scale them.
import Accordion from '@components/Accordion.astro';
import ItemSlot from '@components/item/ItemSlot.astro';
import { getById, getSlug } from '@utils/lookup.js';
import { toWebp } from '@utils/icons';

interface NestedItem {
  Id: string;
  Name: string;
  Icon: string;
  Colour?: string;
  Quantity?: number;
  RequiredItems?: NestedItem[];
}

interface Props {
  items: NestedItem;
  depth?: number;
  /** When false, don't multiply input quantities by parent quantity (e.g. refiner recipes where output 30 doesn't mean 30x inputs) */
  multiplyByParent?: boolean;
}

const { items, depth = 0, multiplyByParent = true } = Astro.props;
const colourOf = (node: NestedItem) => node.Colour ?? getById(node.Id)?.Colour;
---

<ul class="tree-list" role="list" data-depth={depth}>
  {items.RequiredItems?.map((item, index) => {
    const quantity = multiplyByParent
      ? (item.Quantity ?? 1) * (items.Quantity ?? 1)
      : (item.Quantity ?? 1);
    return item.RequiredItems?.length ? (
      <li class="tree-node" data-index={index}>
        <Accordion>
          <span class="tree-label" slot="title">
            <ItemSlot icon={toWebp(item.Icon)} colour={colourOf(item)} qty={quantity} qtyAttr="data-quantity" class="w-10" />
            <span class="nm">{item.Name}</span>
          </span>
          <div slot="content">
            <Astro.self items={{ ...item, Quantity: quantity }} depth={depth + 1} />
            <a href={getSlug(item.Id)} class="link ml-2 inline-block py-1 text-[.85rem]">{item.Name} page</a>
          </div>
        </Accordion>
      </li>
    ) : (
      <li class="tree-node" data-index={index}>
        <a href={getSlug(item.Id)} class="tree-leaf">
          <ItemSlot icon={toWebp(item.Icon)} colour={colourOf(item)} qty={quantity} qtyAttr="data-quantity" class="w-10" />
          <span class="nm">{item.Name}</span>
        </a>
      </li>
    );
  })}
</ul>
