---
interface Props {
	/** Stable placement id — must match a unique element id on the page. */
	id: string;
	class?: string;
	/** Optional format override. Default is standard display. */
	format?: 'display' | 'article' | 'smart-flex';
	/** Optional sizes; defaults cover common desktop + mobile IAB units. */
	sizes?: [number, number][];
	/** Reserved slot height in px to limit CLS. Defaults by format. */
	minHeight?: number;
	/** Optional Nitro mediaQuery so the unit only bids at matching viewports. */
	mediaQuery?: string;
}

const {
	id,
	class: className = '',
	format = 'display',
	sizes = [
		[728, 90],
		[970, 90],
		[300, 250],
		[320, 50],
		[320, 100],
	],
	minHeight,
	mediaQuery,
} = Astro.props;

const reservedHeight = minHeight ?? 250;
const hasMaxWidthClass = /\bmax-w-/.test(className);

const options = {
	...(format !== 'display' ? { format } : {}),
	sizes,
	refreshTime: 30,
	renderVisibleOnly: true,
	report: {
		enabled: true,
		icon: true,
		wording: 'Report Ad',
		position: 'top-right',
	},
	...(format === 'article' ? { pageInterval: 1 } : {}),
	...(format === 'smart-flex' ? { height: 250, smartFlexStickyTop: 16 } : {}),
	...(mediaQuery ? { mediaQuery } : {}),
};

const scriptBody = `window.nitroAds.createAd(${JSON.stringify(id)}, ${JSON.stringify(options)});`;
---

<!-- Not a landmark: several slots per page would give screen readers a list of identical
     "Advertisement" regions (axe landmark-unique). -->
<div
	class:list={['nitro-ad-slot mx-auto my-8 box-border w-full', !hasMaxWidthClass && 'max-w-[970px]', className]}
	style={`min-height: ${reservedHeight}px`}
>
	<div
		id={id}
		class="nitro-ad flex w-full items-center justify-center"
		style={`min-height: ${reservedHeight}px`}
	>
	</div>
</div>
<script is:inline set:html={scriptBody} />
