---
// "Refine it into": refiner recipes that use this item, as open rows.
import RecipeRows from '@components/item/RecipeRows.astro';
import type { RecipeRowView } from '@utils/itemPageContext';

interface Props {
  rows: RecipeRowView[];
}

const { rows } = Astro.props;
---

<RecipeRows
  id="refined-to-create"
  title="Refine it into"
  count={rows.length === 1 ? '1 recipe' : `${rows.length} recipes`}
  rows={rows}
  mode="use"
/>
