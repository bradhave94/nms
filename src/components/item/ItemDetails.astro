---
// Item header: the icon (the page's LCP image, so eager + high priority), the name, a few facts as
// pills, the answer summary, and the "Best yield" box: the best refiner recipe (highest output per
// input unit) with its refiner size and time, the quickest one, and the craft or cooking recipe.
import ItemSlot from '@components/item/ItemSlot.astro';
import type { RecipeRowView } from '@utils/itemPageContext';
import { REFINE_TIME_NOTE } from '@utils/itemFormatters';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';

import type { HeaderPill } from '@utils/itemPageContext';

interface Props {
  item: { Name: string; Icon: string };
  answerSummary: string;
  pills: HeaderPill[];
  relatedLinks: Array<{ label: string; href: string }>;
  bestRefine?: RecipeRowView;
  quickestRefine?: RecipeRowView;
  craft?: RecipeRowView;
  bestCook?: RecipeRowView;
}

const { item, answerSummary, pills, relatedLinks, bestRefine, quickestRefine, craft, bestCook } = Astro.props;
const hasBest = Boolean(bestRefine || craft || bestCook);
const blocks = [
  bestRefine && { key: 'refine', label: 'Best yield', row: bestRefine },
  craft && { key: 'craft', label: craft.machine === 'Nutrient Processor' ? 'Cook it' : 'Craft it', row: craft },
  bestCook && { key: 'cook', label: craft ? 'Or cook it' : 'Cook it', row: bestCook },
].filter(Boolean) as Array<{ key: string; label: string; row: RecipeRowView }>;
const shortList = (row: RecipeRowView) =>
  row.inputs.map((slot) => `${slot.qty.toLocaleString()} ${slot.name}`).join(' + ');
---

<div class="item-head">
  <div class="item-icon">
    <img
      src={`${SITE.imageBaseUrl}${toWebp(item.Icon)}`}
      alt=""
      width="256"
      height="256"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="item-title min-w-0">
    <h1 class="m-0 text-[2.1rem] leading-[1.05] font-bold sm:text-[2.6rem] lg:text-[3rem]">{item.Name}</h1>
    {pills.length > 0 && (
      <ul class="item-pills" role="list">
        {pills.map((pill) => (
          <li>
            {pill.href ? (
              <a href={pill.href} class="pill pill-link" data-tier={pill.tier}>{pill.label}</a>
            ) : (
              <span class="pill" data-tier={pill.tier}>
                {pill.icon && <img src={pill.icon} alt="" width="16" height="16" class="h-4 w-4" loading="lazy" />}
                {pill.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
  <div class="item-answer min-w-0">
    <p class="item-summary m-0 max-w-[68ch] text-[1rem] text-dim">{answerSummary}</p>
    {relatedLinks.length > 0 && (
      <p class="m-0 mt-2 text-[.9rem] text-dim">
        See also:{' '}
        {relatedLinks.map((link, index) => (
          <>
            {index > 0 ? ' · ' : ''}
            <a href={link.href} class="link">{link.label}</a>
          </>
        ))}
      </p>
    )}

    {hasBest && (
      <div class="panel-amber best-box">
        {blocks.map((block) => (
          <div class="best-block">
            <p class="best-label">{block.label}</p>
            <div class="best-eq">
              {block.row.inputs.map((slot, index) => (
                <>
                  {index > 0 && <span class="op" aria-hidden="true">+</span>}
                  <a class="best-io" href={slot.href}>
                    <ItemSlot icon={slot.icon} colour={slot.colour} qty={slot.qty} class="w-12 sm:w-14" />
                    <span class="nm">{slot.name}</span>
                  </a>
                </>
              ))}
              <span class="op" aria-hidden="true">→</span>
              <span class="sr-only">makes</span>
              <span class="best-io">
                <ItemSlot icon={block.row.output.icon} colour={block.row.output.colour} qty={block.row.output.qty} class="w-12 sm:w-14" />
                <b class="best-num tabular">{block.row.output.qty.toLocaleString()}</b>
                <span class="sr-only">{block.row.output.name}</span>
              </span>
            </div>
            <p class="best-meta">
              <span>{block.row.machine}</span>
              {block.row.time && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span class="tabular" title={REFINE_TIME_NOTE}><span class="sr-only">about </span><span aria-hidden="true">~</span>{block.row.time} per batch</span>
                </>
              )}
              {block.key === 'refine' && quickestRefine && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span>
                    Quickest: {shortList(quickestRefine)} → {quickestRefine.output.qty.toLocaleString()}
                    {quickestRefine.time && <> in <span class="sr-only">about </span><span aria-hidden="true">~</span>{quickestRefine.time}</>}
                  </span>
                </>
              )}
            </p>
          </div>
        ))}
      </div>
    )}
  </div>
</div>
