---
// "How to make it": every refiner recipe for this item as an open row, best yield per input first.
import RecipeRows from '@components/item/RecipeRows.astro';
import type { RecipeRowView } from '@utils/itemPageContext';

interface Props {
  item: { Name: string };
  rows: RecipeRowView[];
}

const { item, rows } = Astro.props;
---

<RecipeRows
  id="refining"
  title={`How to refine ${item.Name}`}
  count={rows.length === 1 ? '1 recipe' : `${rows.length} recipes`}
  note={rows.length > 1 ? 'Best yield per input first' : undefined}
  rows={rows}
  mode="make"
  footnote="Times are approximate, per batch (one run of the recipe). In-game refiner timers are often off."
/>
