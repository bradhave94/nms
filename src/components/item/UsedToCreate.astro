---
// "Craft with it": everything whose crafting recipe uses this item, as compact icon tiles, with
// category filters and counts. The first 16 show; "Show all" reveals the rest of the current filter.
import ItemSlot from '@components/item/ItemSlot.astro';
import type { CraftUseTile } from '@utils/itemPageContext';

interface Props {
  item: { Name: string; Slug?: string };
  tiles: CraftUseTile[];
  categories: Array<{ slug: string; label: string; count: number }>;
}

const { item, tiles, categories } = Astro.props;
const VISIBLE = 16;
const isFish = Boolean(item.Slug?.startsWith('fish/'));
const countLabel = tiles.length === 1 ? '1 item' : `${tiles.length} items`;
---

{tiles.length > 0 && (
  <section id="used-to-create" class="item-section" aria-labelledby="used-to-create-title" data-uses data-visible={VISIBLE}>
    <h2 id="used-to-create-title" class="section-title">
      {isFish ? 'What this fish is used for' : 'Craft with it'}
      <span class="count">{countLabel}</span>
    </h2>
    {categories.length > 1 && (
      <div class="mb-3 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        <button type="button" class="use-tab" aria-pressed="true" data-cat="all" data-label="items">
          All <span class="tabular">{tiles.length}</span>
        </button>
        {categories.map((category) => (
          <button type="button" class="use-tab" aria-pressed="false" data-cat={category.slug} data-label={category.label.toLowerCase()}>
            {category.label} <span class="tabular">{category.count}</span>
          </button>
        ))}
      </div>
    )}
    <p class="sr-only" role="status" data-use-status></p>
    <ul id="used-to-create-grid" class="use-tiles" role="list">
      {tiles.map((tile, index) => (
        <li data-cat={tile.category} hidden={index >= VISIBLE}>
          <a class="use-tile" href={tile.href}>
            <ItemSlot icon={tile.icon} colour={tile.colour} class="w-10" />
            <span class="nm">{tile.name}</span>
          </a>
        </li>
      ))}
    </ul>
    {tiles.length > VISIBLE && (
      <button type="button" class="recipe-more px-0!" aria-expanded="false" aria-controls="used-to-create-grid" data-use-all>
        Show all <span class="tabular" data-use-total>{tiles.length}</span> <span aria-hidden="true">↓</span>
      </button>
    )}
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-uses]').forEach((section) => {
    const visible = Number(section.dataset.visible ?? 16);
    const tiles = Array.from(section.querySelectorAll<HTMLLIElement>('li[data-cat]'));
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('button[data-cat]'));
    const more = section.querySelector<HTMLButtonElement>('button[data-use-all]');
    const total = section.querySelector<HTMLElement>('[data-use-total]');
    const status = section.querySelector<HTMLElement>('[data-use-status]');
    let category = 'all';
    let expanded = false;

    const apply = (announce: boolean) => {
      const matching = tiles.filter((tile) => category === 'all' || tile.dataset.cat === category);
      tiles.forEach((tile) => (tile.hidden = true));
      matching.forEach((tile, index) => (tile.hidden = !expanded && index >= visible));
      if (more) {
        more.hidden = matching.length <= visible;
        more.setAttribute('aria-expanded', String(expanded));
        if (total) total.textContent = String(matching.length);
        more.firstChild!.textContent = expanded ? 'Show fewer ' : 'Show all ';
        if (total) total.hidden = expanded;
      }
      if (announce && status) {
        const tab = tabs.find((button) => button.dataset.cat === category);
        status.textContent = `${matching.length} ${tab?.dataset.label ?? 'items'}`;
      }
    };

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        category = tab.dataset.cat ?? 'all';
        expanded = false;
        tabs.forEach((button) => button.setAttribute('aria-pressed', String(button === tab)));
        apply(true);
      })
    );
    more?.addEventListener('click', () => {
      expanded = !expanded;
      apply(false);
    });
  });
</script>
