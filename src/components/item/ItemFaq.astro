---
// The visible FAQ. itemPageSchema.ts emits FAQPage JSON-LD for exactly these questions.
import Accordion from '@components/Accordion.astro';
import type { FaqQuestion } from '@utils/itemPageSchema';

interface Props {
  faqQuestions: FaqQuestion[];
}

const { faqQuestions } = Astro.props;
---

{faqQuestions.length > 0 && (
  <section id="faq" class="item-section" aria-labelledby="faq-title">
    <h2 id="faq-title" class="section-title">Frequently asked questions</h2>
    <div class="faq-list">
      {faqQuestions.map((faq, index) => (
        <Accordion id={`item-faq-${index + 1}`} heading="h3">
          <span class="text-[1rem] font-medium text-ink" slot="title">{faq.question}</span>
          <p class="m-0 max-w-[36rem] text-[.95rem] text-dim" slot="content">{faq.answer}</p>
        </Accordion>
      ))}
    </div>
  </section>
)}
