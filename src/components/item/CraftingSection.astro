---
// "How to craft it": the crafting tree (crafted parts open to their own recipes) and the raw
// materials it all comes down to. Amounts follow the "I need" box.
import NestedList from '@components/NestedList.astro';
import ItemSlot from '@components/item/ItemSlot.astro';
import { getSlug } from '@utils/lookup.js';
import type { ProcessedItem, RawItem } from '@utils/recipeTree';
import { toWebp } from '@utils/icons';

interface Props {
  item: { Name: string };
  data: Array<{
    Id: string;
    Icon: string;
    Name: string;
    Quantity: number;
    RequiredItems: ProcessedItem[];
  }>;
  rawItems: RawItem[];
  isFoodItem: boolean;
}

const { item, data, rawItems, isFoodItem } = Astro.props;
const craftItem = data[0];
const hasSubRecipes = craftItem?.RequiredItems.some((part) => part.RequiredItems.length > 0) ?? false;
const sortedRaw = [...rawItems].sort((a, b) => b.Quantity - a.Quantity);
const rawTotal = rawItems.reduce((sum, r) => sum + r.Quantity, 0);
---

{craftItem && (
  <section id="crafting" class="recipe-panel" aria-labelledby="crafting-title">
    <div class="recipe-panel-head">
      <h2 id="crafting-title" class="m-0 text-[1.15rem] font-semibold">
        {isFoodItem ? `How to cook ${item.Name}` : `How to craft ${item.Name}`}
      </h2>
      {hasSubRecipes && <p class="m-0 text-[.85rem] text-dim">Open a part to see its recipe</p>}
    </div>
    <div class="px-3 py-2 sm:px-4">
      <NestedList items={craftItem} depth={0} />
    </div>

    {hasSubRecipes && sortedRaw.length > 0 && (
      <div class="border-t border-line px-3 py-3 sm:px-4">
        <h3 class="m-0 mb-2 text-[1rem] font-semibold">
          Raw materials
          <span class="ml-1 font-normal text-dim text-[.9rem]">
            {sortedRaw.length} {sortedRaw.length === 1 ? 'item' : 'items'},{' '}
            <span id="raw-total" class="tabular" data-base-total={rawTotal}>{rawTotal.toLocaleString()}</span> in total
          </span>
        </h3>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0" role="list">
          {sortedRaw.map((rawItem) => (
            <li>
              <a href={getSlug(rawItem.Id)} class="raw-chip">
                <ItemSlot icon={toWebp(rawItem.Icon)} colour={rawItem.Colour} qty={rawItem.Quantity} qtyAttr="data-quantity" class="w-9" />
                <span class="nm">{rawItem.Name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
)}
