---
// Previous / next links for the paginated list pages (/[category]/[page], /calculator/[page]).
interface Props {
	page: { currentPage: number; lastPage: number; url: { prev?: string; next?: string } };
}
const { page } = Astro.props;
const normalizePrevHref = (href?: string): string | undefined => {
	if (!href) return href;
	const normalized = href.replace(/\/1\/?$/, '');
	return normalized === '' ? '/' : normalized;
};
const prevHref = normalizePrevHref(page?.url?.prev);
---

<nav class="pager" aria-label="Previous and next page">
	{prevHref && <a class="btn-quiet" href={prevHref} rel="prev"><span aria-hidden="true">←</span> Previous</a>}
	<span class="pos tabular">Page {page.currentPage} of {page.lastPage}</span>
	{page.url.next && <a class="btn-quiet" href={page.url.next} rel="next">Next <span aria-hidden="true">→</span></a>}
</nav>
