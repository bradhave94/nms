---
// One item tile: the game's inventory slot tinted by the item's own Colour, the full name (wraps,
// never truncated) and a small group line. The <article> wrapper is what scripts/check-new-items.mjs counts. Styles live in src/assets/css/lists.css.
export interface TileCard {
	name: string;
	image: string;
	link: string;
	/** The item's `Colour` from the data (hex, with or without #). */
	colour?: string | null;
	/** Small line under the name, usually the item's group. */
	group?: string | null;
	subtitle?: string | null;
}

interface Props {
	card: TileCard;
	index?: number;
	loading?: 'eager' | 'lazy';
}

const { card, index, loading = 'lazy' } = Astro.props;
const hex = String(card.colour ?? '').replace(/^#/, '');
const slotStyle = /^[0-9a-f]{6}$/i.test(hex) ? `--c:#${hex}` : undefined;
const meta = [card.group, card.subtitle].filter(Boolean).join(' · ');
---

<article class="tile-cell" data-index={index}>
	<a href={card.link} class="tile">
		<span class="slot" style={slotStyle}>
			<img src={card.image} alt="" width="48" height="48" loading={loading} decoding="async" />
		</span>
		<span class="tile-text">
			<span class="tile-name">{card.name}</span>
			{meta && <span class="tile-meta">{meta}</span>}
		</span>
	</a>
</article>
