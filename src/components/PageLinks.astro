---
// Plain links to every page of a paginated list, so crawlers reach page N in one click
// (page 1 of a category loads the rest of its items with JavaScript).
interface Props {
	currentPage: number;
	lastPage: number;
	/** List root without the page number, e.g. `/buildings`. Defaults to the current URL. */
	basePath?: string;
}

const { currentPage, lastPage } = Astro.props;
const basePath = (Astro.props.basePath ?? Astro.url.pathname.replace(/\/\d+\/?$/, '')).replace(/\/+$/, '');
const pageHref = (page: number): string => (page === 1 ? `${basePath}/` : `${basePath}/${page}/`);
const pages = Array.from({ length: lastPage }, (_, index) => index + 1);
---

{lastPage > 1 && (
	<nav aria-label="Pages" class="page-links">
		<span class="mr-1">Browse by page:</span>
		{pages.map((page) =>
			page === currentPage ? (
				<span aria-current="page">{page}</span>
			) : (
				<a href={pageHref(page)} aria-label={`Page ${page}`}>{page}</a>
			)
		)}
	</nav>
)}
