<!-- Opens the site search dialog (SearchModal) from any [data-open-search] button (the sidebar field, the
     mobile top bar, home and 404 search boxes), or with "/" or Ctrl+K. The old floating button is gone: it
     covered table columns and card buttons. -->
<script>
	const siteSearch = document.getElementById('site-search') as HTMLElement | null;
	const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
	const searchPanel = document.getElementById('site-search-panel');
	let returnFocusTo: HTMLElement | null = null;

	function isEditableTarget(target: EventTarget | null): boolean {
		if (!(target instanceof HTMLElement)) return false;
		const tag = target.tagName;
		return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable;
	}

	function openSiteSearch(from?: HTMLElement | null, prefill?: string): void {
		if (!siteSearch) return;
		if (siteSearch.classList.contains('hidden')) {
			const active = document.activeElement;
			returnFocusTo = from ?? (active instanceof HTMLElement && active !== document.body ? active : null);
		}
		siteSearch.classList.remove('hidden');
		document.body.classList.add('overflow-hidden');
		if (searchInput) {
			if (prefill !== undefined) {
				searchInput.value = prefill;
				searchInput.dispatchEvent(new Event('input'));
			}
			searchInput.focus();
		}
	}

	function closeSiteSearch(): void {
		if (!siteSearch || siteSearch.classList.contains('hidden')) return;
		siteSearch.classList.add('hidden');
		document.body.classList.remove('overflow-hidden');
		// opened with "/" or Ctrl+K from nowhere in particular: land on the visible search button
		const fallback = Array.from(document.querySelectorAll<HTMLElement>('[data-open-search]')).find((el) => el.offsetParent !== null && !el.closest('[inert]'));
		(returnFocusTo && document.contains(returnFocusTo) ? returnFocusTo : fallback)?.focus();
		returnFocusTo = null;
	}

	document.addEventListener('click', (event) => {
		const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-open-search]');
		if (!trigger) return;
		event.preventDefault();
		// a trigger may carry a starting query (data-open-search="text")
		// from inside the mobile menu: close the menu first (two modal dialogs would fight over Tab and Escape),
		// and return focus to the menu button afterwards, since the drawer's own button goes inert
		let from: HTMLElement | null = trigger;
		if (trigger.closest('#mobile-sidebar')) {
			document.getElementById('sidebar-close')?.click();
			from = document.getElementById('sidebar-open');
		}
		openSiteSearch(from, trigger.dataset.openSearch || undefined);
	});

	// Inline search boxes (home, 404) hand their text to the dialog instead of a page reload.
	document.querySelectorAll<HTMLFormElement>('form[data-search-form]').forEach((form) => {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const input = form.querySelector('input');
			openSiteSearch(input, input?.value ?? '');
		});
	});

	siteSearch?.addEventListener('click', (event: MouseEvent) => {
		const target = event.target as Node | null;
		if (target && searchPanel && !searchPanel.contains(target)) closeSiteSearch();
	});
	document.getElementById('site-search-close')?.addEventListener('click', closeSiteSearch);

	document.addEventListener('keydown', (event: KeyboardEvent) => {
		const open = siteSearch && !siteSearch.classList.contains('hidden');
		if (event.key === 'Escape' && open) {
			closeSiteSearch();
			return;
		}
		// The dialog is modal: keep Tab inside it.
		if (event.key === 'Tab' && open && searchPanel) {
			const focusables = Array.from(searchPanel.querySelectorAll<HTMLElement>('input, a[href], button:not([disabled])'))
				.filter((el) => el.offsetParent !== null || (el.matches('input[type="checkbox"]') && !el.closest('[hidden], .hidden')));
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			if (!first || !last) return;
			const active = document.activeElement;
			if (event.shiftKey && (active === first || !searchPanel.contains(active))) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && (active === last || !searchPanel.contains(active))) {
				event.preventDefault();
				first.focus();
			}
			return;
		}
		if (isEditableTarget(event.target)) return;
		const isModifierK = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
		const isSlash = event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey;
		if (isModifierK || isSlash) {
			event.preventDefault();
			openSiteSearch();
		}
	});
</script>
