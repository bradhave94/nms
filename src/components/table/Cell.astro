---
import { Image } from 'astro:assets'
import { getSlug } from '@utils/lookup.js';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';
import { swatchStyle } from '@utils/contrast';

interface CellData {
    id: string;
    name: string;
    amount?: number;
    colour: string;
    image?: string;
    description?: string;
    value?: number;
    href?: string;
}

export interface Props {
    cell: CellData | string | number;
}

const { cell } = Astro.props;
---

<style>
    .sort,
    .description {
        display: none !important;
    }

    .cell-link {
        text-decoration: none;
        color: inherit;
    }

    .cell-content {
        display: flex;
        align-items: center;
        padding: 5px;
    }

    .cell-text {
        margin-right: 10px;
    }

    .amount {
        font-size: 0.9em;
        opacity: 0.8;
    }
</style>

<td>
    {typeof cell === 'string' ? (
        cell
    ) : typeof cell === 'number' ? (
        <>
            <span class="d-none sort">{cell}</span>
            {cell.toLocaleString()}
        </>
    ) : cell && 'id' in cell ? (
        <>
            <span class="d-none sort">{cell.name}</span>
            <a href={cell.href ?? getSlug(cell.id)} class="cell-link">
                <div class="cell-content" style={swatchStyle(cell.colour)}>
                    <span class="cell-text flex items-center gap-2 flex-wrap">
                        {cell.name}
                        {cell.amount && (
                            <span class="inline-flex items-center justify-center min-w-[1.75rem] rounded-sm px-1.5 py-0.5 text-xs font-medium bg-black/60 text-white tabular-nums amount">
                                {cell.amount.toLocaleString()}
                            </span>
                        )}
                    </span>
                    {cell.image && (
                        <Image
                            src={`${SITE.imageBaseUrl}${toWebp(cell.image)}`}
                            alt=""
                            sizes="50px"
                            width={50}
                            height={50}
                        />
                    )}
                </div>
            </a>
        </>
    ) : null}
</td>