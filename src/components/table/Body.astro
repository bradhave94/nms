---
// Compact server-rendered rows for the recipe tables (refining, cooking, crafting guide).
// Each item cell is just its link, name, amount, colour and icon; Table.astro's script reads these
// rows into Tabulator and draws the coloured swatch with the icon, so the HTML stays small and icons
// load only for rows on screen. Crawlers still get every recipe and link. The row's data attributes
// carry the filter keys (n = number of inputs, y = output units per input unit).
// No <style> block on purpose: scoped styles would add a data-astro-cid attribute to every cell.
import type { RecipeItem, RecipeRow } from './recipeRows';

export interface Props {
	rows: RecipeRow[];
	extra: 'operation' | 'value';
}

const { rows, extra } = Astro.props;
const slots = [0, 1, 2] as const;
---

<tbody>
	{rows.map((row) => {
		const item = (cell: RecipeItem | undefined) =>
			cell ? <td><a href={cell.href} data-c={cell.colour} data-i={cell.icon}>{cell.name}</a>{cell.amount ? <b>{cell.amount.toLocaleString()}</b> : null}</td> : <td></td>;
		return (
			<tr data-n={row.inputs.length} data-y={Number(row.yield.toFixed(4))}>
				{slots.map((i) => item(row.inputs[i]))}
				{item(row.output)}
				{extra === 'operation'
					? <td>{row.operation}{row.detail && <small>{row.detail}</small>}</td>
					: <td data-v={row.value ?? 0}>{(row.value ?? 0).toLocaleString()}</td>}
			</tr>
		);
	})}
</tbody>
