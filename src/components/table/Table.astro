---
// Recipe table (refining, cooking, crafting guide): compact header, filter bar, Tabulator grid with
// the per-item colour swatches, compact pager, and the `table-above` ad after the first 5 rows.
//
// The ad: NitroPay units must be created once, and moving an iframe in the DOM reloads it, so the
// slot never moves. It sits after the grid in the DOM, absolutely positioned inside `.rt-stage`;
// after every render the script gives the 5th visible row (or the last one, on short pages) a
// bottom margin the height of the slot and moves the slot into that gap with `top`. With no rows
// the slot sits under the filter bar. Phones (<= 640px) get stacked rows with the output first.
import '../../assets/css/tabulator.css';
import '../../assets/css/tables.css';
import TableHead from '@components/table/Head.astro';
import TableBody from '@components/table/Body.astro';
import PageHead from '@components/table/PageHead.astro';
import FilterBar from '@components/table/FilterBar.astro';
import type { RecipeKind } from '@components/table/FilterBar.astro';
import NitroAd from '@components/ads/NitroAd.astro';
import type { RecipeRow } from './recipeRows';

export interface Props {
  title: string;
  /** Machine art in /public, e.g. /images/refiner.webp. */
  image: string;
  /** Base path of the page family, e.g. /refining. */
  base: string;
  kind: RecipeKind;
  /** Rows in the default order. */
  rows: RecipeRow[];
  /** Last column: the machine operation (refining, cooking) or the unit value (crafting). */
  extra: 'operation' | 'value';
  outputTitle?: string;
  /** Order while a query is active: best yield per input unit, or keep the default order. */
  querySort?: 'yield' | 'default';
}

const { title, image, base, kind, rows, extra, outputTitle = 'Output', querySort = 'yield' } = Astro.props;
const columns = [
  { title: 'Input 1', field: 'i1' },
  { title: 'Input 2', field: 'i2' },
  { title: 'Input 3', field: 'i3' },
  { title: outputTitle, field: 'out' },
  extra === 'operation' ? { title: 'Operation', field: 'op' } : { title: 'Value', field: 'v' },
];
---

<div class="rt" data-rt data-query-sort={querySort} data-extra={extra}>
  <PageHead title={title} image={image} base={base} view="table"><slot /></PageHead>
  <FilterBar kind={kind} total={rows.length} />
  <div class="rt-stage rt-pending" data-rt-stage>
    <table id="recipe-table" data-columns={JSON.stringify(columns)}>
      <TableHead columns={columns} />
      <TableBody rows={rows} extra={extra} />
    </table>
    <div class="rt-ad" data-rt-ad>
      <NitroAd id="table-above" class="px-4" />
    </div>
  </div>
  <div class="rt-pager" data-rt-pager></div>
</div>

<script>
  import { TabulatorFull as Tabulator } from 'tabulator-tables';
  import { readableTextOn } from '@utils/contrast';
  import { applyTabulatorA11y } from '@utils/tabulatorA11y';
  import { bindFilters, countLabel, isFiltering, matches, type FilterState } from './filters';

  type Item = { name: string; href: string; c: string; i?: string; amt?: string };
  type Row = {
    ord: number;
    n: number;
    y: number;
    so: string;
    si: string;
    sop: string;
    i1: Item | null;
    i2: Item | null;
    i3: Item | null;
    out: Item | null;
    op: { name: string; detail: string } | null;
    v: number;
  };
  type CellLike = { getValue: () => unknown; getElement: () => HTMLElement };
  type RowLike = { getData: () => Row };
  type Column = { title: string; field: string };

  const imageBase = '/images/items/';

  const readItem = (td: Element | undefined): Item | null => {
    const a = td?.querySelector('a');
    if (!a) return null;
    return {
      name: a.textContent?.trim() ?? '',
      href: a.getAttribute('href') ?? '#',
      c: a.dataset.c ?? '333333',
      i: a.dataset.i,
      amt: td?.querySelector('b')?.textContent ?? undefined,
    };
  };

  const readRows = (table: HTMLTableElement): Row[] =>
    [...table.tBodies[0].rows].map((tr, ord) => {
      const tds = [...tr.cells];
      const [i1, i2, i3, out] = tds.slice(0, 4).map(readItem);
      const last = tds[4];
      const detail = last?.querySelector('small')?.textContent ?? '';
      const opName = (last?.firstChild?.nodeType === Node.TEXT_NODE ? last.firstChild.textContent : '') ?? '';
      const inputs = [i1, i2, i3].filter((x): x is Item => Boolean(x));
      return {
        ord,
        n: Number(tr.dataset.n) || inputs.length,
        y: Number(tr.dataset.y) || 0,
        so: (out?.name ?? '').toLowerCase(),
        si: inputs.map((x) => x.name.toLowerCase()).join('|'),
        sop: opName.trim().toLowerCase(),
        i1,
        i2,
        i3,
        out,
        op: opName || detail ? { name: opName.trim(), detail } : null,
        v: Number(last?.dataset.v) || 0,
      };
    });

  // The swatch: the item's own colour with readable text, icon, name and amount badge.
  const formatItem = (cell: CellLike): string | HTMLElement => {
    const item = cell.getValue() as Item | null;
    cell.getElement().classList.toggle('is-empty', !item);
    if (!item) return '';
    const link = document.createElement('a');
    link.href = item.href;
    link.className = 'cell-link';
    const content = document.createElement('span');
    content.className = 'cell-content';
    content.style.background = `#${item.c}`;
    content.style.color = readableTextOn(item.c);
    if (item.i) {
      const img = document.createElement('img');
      img.src = `${imageBase}${item.i}`;
      img.alt = '';
      img.width = 32;
      img.height = 32;
      img.loading = 'lazy';
      img.decoding = 'async';
      content.append(img);
    }
    const name = document.createElement('span');
    name.className = 'rt-name';
    name.textContent = item.name;
    content.append(name);
    if (item.amt) {
      const badge = document.createElement('span');
      badge.className = 'rt-qty';
      // "Silver x1" for screen readers; the badge alone would read "Silver1".
      const times = document.createElement('span');
      times.className = 'sr-only';
      times.textContent = ' x';
      badge.append(times, item.amt);
      content.append(badge);
    }
    link.append(content);
    return link;
  };

  const formatOp = (cell: CellLike): string | HTMLElement => {
    const op = cell.getValue() as Row['op'];
    if (!op) return '';
    const wrap = document.createElement('span');
    wrap.className = 'rt-op';
    wrap.append(op.name);
    if (op.detail) {
      const small = document.createElement('small');
      small.textContent = op.detail;
      wrap.append(small);
    }
    return wrap;
  };

  const formatValue = (cell: CellLike): string | HTMLElement => {
    const wrap = document.createElement('span');
    wrap.className = 'rt-value tabular';
    wrap.textContent = (cell.getValue() as number).toLocaleString();
    const unit = document.createElement('small');
    unit.textContent = ' units';
    wrap.append(unit);
    return wrap;
  };

  // Empty cells (recipes with fewer inputs) always sort to the bottom.
  const byName =
    (key: (value: unknown) => string) =>
    (a: unknown, b: unknown, _ar: unknown, _br: unknown, _c: unknown, dir: string): number => {
      const ta = key(a);
      const tb = key(b);
      if (!ta && !tb) return 0;
      if (!ta) return dir === 'asc' ? 1 : -1;
      if (!tb) return dir === 'asc' ? -1 : 1;
      return ta.localeCompare(tb);
    };
  const itemName = (v: unknown) => (v as Item | null)?.name ?? '';
  const opName = (v: unknown) => (v as Row['op'])?.name ?? '';
  // Ties keep the default order (the sorter result is reversed for "desc").
  const byYield = (a: unknown, b: unknown, ar: RowLike, br: RowLike): number =>
    (a as number) - (b as number) || br.getData().ord - ar.getData().ord;

  const init = (): void => {
    const root = document.querySelector<HTMLElement>('[data-rt]');
    const source = document.getElementById('recipe-table') as HTMLTableElement | null;
    const stage = root?.querySelector<HTMLElement>('[data-rt-stage]');
    const ad = root?.querySelector<HTMLElement>('[data-rt-ad]');
    const pager = root?.querySelector<HTMLElement>('[data-rt-pager]');
    const countEl = root?.querySelector<HTMLElement>('[data-rt-count]');
    if (!root || !source || !stage || !ad || !pager) return;

    let titles: Column[];
    try {
      titles = JSON.parse(source.dataset.columns || '[]');
    } catch (error) {
      console.error('Failed to parse table columns:', error);
      return;
    }
    const data = readRows(source);
    const host = document.createElement('div');
    host.id = 'recipe-table';
    source.replaceWith(host);

    const columns = titles.map((col) => {
      if (col.field === 'op') return { title: col.title, field: 'op', formatter: formatOp, sorter: byName(opName), minWidth: 180, widthGrow: 1 };
      if (col.field === 'v')
        return { title: col.title, field: 'v', formatter: formatValue, sorter: 'number', headerSortStartingDir: 'desc', minWidth: 120, widthGrow: 0.6 };
      return { title: col.title, field: col.field, formatter: formatItem, sorter: byName(itemName), minWidth: 140, widthGrow: col.field === 'out' ? 1.2 : 1 };
    });
    columns.push({ title: '', field: 'ord', sorter: 'number', visible: false } as never, { title: '', field: 'y', sorter: byYield, visible: false } as never);

    const defaultSort = [{ column: 'ord', dir: 'asc' }];
    const table = new Tabulator(host, {
      data,
      columns,
      columnDefaults: { resizable: false },
      initialSort: defaultSort,
      layout: 'fitColumns',
      renderVertical: 'basic',
      pagination: true,
      paginationSize: 25,
      paginationSizeSelector: [25, 50, 100, true],
      paginationButtonCount: 0,
      paginationElement: pager,
      placeholder: 'No recipes match. Try another name or clear a filter.',
      langs: {
        default: {
          pagination: {
            page_size: 'Rows',
            first: 'First',
            first_title: 'First page',
            last: 'Last',
            last_title: 'Last page',
            prev: '‹',
            prev_title: 'Previous page',
            next: '›',
            next_title: 'Next page',
            all: 'All',
          },
        },
      },
    });

    let state: FilterState = { q: '', mode: 'out', size: 0 };
    const bestFirst = root.dataset.querySort === 'yield';
    applyTabulatorA11y(table, document.querySelector('h1')?.textContent?.trim() || 'Recipes', 'recipes', {
      status: countEl ?? undefined,
      format: (count) => countLabel(count, state, bestFirst),
      delay: 250,
    });

    // "‹ 1 / 15 ›": the counter sits between Tabulator's prev and next buttons (CSS order).
    const counter = document.createElement('span');
    counter.className = 'rt-pagecount tabular';
    pager.append(counter);
    const updateCounter = (): void => {
      const page = Number(table.getPage()) || 1;
      const max = Number(table.getPageMax()) || 1;
      counter.innerHTML = `<span aria-hidden="true">${page} / ${max}</span><span class="sr-only">Page ${page} of ${max}</span>`;
      pager.hidden = max <= 1 && table.getDataCount('active') <= 25;
    };

    // Ad placement (see the header comment).
    let gapRow: HTMLElement | null = null;
    let frame = 0;
    const placeAd = (): void => {
      frame = 0;
      const grid = table.element as HTMLElement | undefined;
      if (!grid) return;
      const rows = [...grid.querySelectorAll<HTMLElement>('.tabulator-table > .tabulator-row')];
      const gap = ad.offsetHeight;
      stage.style.setProperty('--rt-ad-gap', `${gap}px`);
      const target = rows[Math.min(5, rows.length) - 1] ?? null;
      if (gapRow !== target) {
        gapRow?.classList.remove('rt-gap');
        target?.classList.add('rt-gap');
        gapRow = target;
      }
      stage.classList.toggle('rt-ad-top', !target);
      const top = target ? target.getBoundingClientRect().bottom - stage.getBoundingClientRect().top : 0;
      ad.style.top = `${Math.round(top)}px`;
    };
    const schedule = (): void => {
      if (!frame) frame = requestAnimationFrame(placeAd);
    };

    // Phones hide the header visually (stacked rows), so its sort buttons leave the tab order.
    const stacked = window.matchMedia('(max-width: 640px)');
    const syncHeaderFocus = (): void => {
      (table.element as HTMLElement | undefined)
        ?.querySelectorAll<HTMLElement>('.tabulator-col.tabulator-sortable')
        .forEach((col) => (col.tabIndex = stacked.matches ? -1 : 0));
    };
    stacked.addEventListener('change', syncHeaderFocus);

    table.on('tableBuilt', () => {
      syncHeaderFocus();
      stage.classList.remove('rt-pending');
      updateCounter();
      schedule();
      new ResizeObserver(schedule).observe(stage);
    });
    table.on('renderComplete', schedule);
    table.on('dataFiltered', schedule);
    table.on('pageLoaded', () => {
      updateCounter();
      schedule();
    });
    table.on('dataSorted', schedule);

    // Paging from the bottom: bring the top of the new page into view.
    pager.addEventListener('click', (event) => {
      if (!(event.target as Element).closest('button')) return;
      requestAnimationFrame(() => {
        if (stage.getBoundingClientRect().top < 0) root.querySelector('[data-rt-filters]')?.scrollIntoView({ block: 'start' });
      });
    });

    let wasQuery = false;
    const onFilters = (next: FilterState): void => {
      state = next;
      if (isFiltering(state)) table.setFilter((row: Row) => matches(state, row));
      else table.clearFilter();
      const isQuery = Boolean(state.q);
      if (isQuery !== wasQuery) {
        table.setSort(isQuery && bestFirst ? [{ column: 'y', dir: 'desc' }] : defaultSort);
        wasQuery = isQuery;
      }
      updateCounter();
    };
    // Filters bind once the table exists (Tabulator warns about setFilter before tableBuilt).
    table.on('tableBuilt', () => {
      state = bindFilters(root, onFilters);
    });
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
</script>
