---
import '../../assets/css/tabulator.css';
import TableHead from '@components/table/Head.astro';
import TableBody from '@components/table/Body.astro';
import NitroAd from '@components/ads/NitroAd.astro';
import { Image } from 'astro:assets';

interface Column {
  title: string;
  field: string;
}

export interface TableRow {
  input_1?: object;
  input_2?: object;
  input_3?: object;
  output?: object;
  description?: string;
  value?: number;
  [key: string]: unknown;
}

export interface Props {
  title: string;
  image: string;
  image_width: number;
  image_height: number;
  columns: Column[];
  sort?: string;
  data: TableRow[];
}

const { title, image, image_width, image_height, columns, sort = 'output', data } = Astro.props;
---

<style is:global>
  .nms-sort {
    display: none !important;
  }
  .cell-link {
    text-decoration: none;
    color: inherit;
  }
  .cell-content {
    display: flex;
    align-items: center;
    padding: 5px;
  }
  .cell-text {
    margin-right: 10px;
  }
  .cell-amount {
    font-size: 0.9em;
    opacity: 0.8;
  }
</style>

<style>
  .table-rows {
    opacity: 1;
    transition: opacity 0.5s ease-in-out;
  }
  .d-hidden {
    opacity: 0;
    height: 500px;
    overflow: hidden;
  }
</style>

<div class="table-wrapper" data-layout="table" data-astro-transition-persist="table-wrapper">
  <div
    class="card-header p-4 relative flex lg:flex-row flex-col gap-5 items-center justify-between bg-center before:bg-black/80 before:w-full before:h-full before:absolute before:left-0 before:top-0"
    style="background-image: url(/images/resources.png)"
  >
    <div class="flex items-center gap-2 z-10 relative">
      <Image
        class="logo"
        src={import(`../../assets/img/${image}.png`)}
        sizes={`${image_width}px`}
        width={image_width}
        height={image_height}
        alt={title}
      />
      <h1 class="text-2xl">{title}</h1>
    </div>

    <div class="relative text-center">
      <div class="flex gap-2 justify-center">
        <p>Layout:</p>
        <div>
          <a
            href={`/${image}`}
            class="block cursor-pointer select-none rounded-md px-2 transition-colors bg-blue-500 text-black border border-blue-500 peer-checked:bg-blue-500 peer-checked:text-black"
          >
            Table
          </a>
        </div>
        <div>
          <a
            href={`/${image}/cards`}
            class="block cursor-pointer select-none rounded-md px-2 border transition-colors hover:bg-blue-500 hover:text-black border-blue-500 peer-checked:bg-blue-500 peer-checked:text-black"
          >
            Cards
          </a>
        </div>
      </div>
    </div>

    <div class="flex items-center z-10">
      <div class="tabulator-search relative">
        <input
          class="rounded-md w-full bg-black border-blue-500 focus:border-blue-500 focus:ring-blue-500 peer"
          required
          type="text"
          id="search"
          name="search"
          placeholder=""
        />
        <label
          class="absolute top-1/2 -translate-y-1/2 left-3 peer-focus:opacity-0 peer-valid:opacity-0"
          for="search">Search</label
        >
      </div>
    </div>
  </div>
  <!-- Only the rows wait for Tabulator; the header (the LCP element) paints immediately. -->
  <div class="table-rows d-hidden">
    <NitroAd id="table-above" class="px-4" />
    <table id="table" data-columns={JSON.stringify(columns)} data-sort={sort}>
      <TableHead columns={columns} />
      <TableBody columns={columns} data={data} />
    </table>
  </div>
</div>

<script>
  import { TabulatorFull as Tabulator } from 'tabulator-tables';
  type ColumnData = { title: string; field: string };
  type SortValue = string | number | null | undefined;

  const parseSortNumber = (value: SortValue): number => {
    if (typeof value === 'number' && !Number.isNaN(value)) {
      return value;
    }

    if (typeof value !== 'string') {
      return Number.NEGATIVE_INFINITY;
    }

    // Prefer explicit hidden sort value when present in the HTML cell.
    const hiddenSortMatch = value.match(
      /<span[^>]*class=["'][^"']*sort[^"']*["'][^>]*>(-?\d+(?:\.\d+)?)<\/span>/i,
    );
    if (hiddenSortMatch?.[1]) {
      return Number(hiddenSortMatch[1]);
    }

    // Fallback to text extraction to support non-HTML/edge-case values.
    const textOnly = value.replace(/<[^>]*>/g, '').replace(/,/g, '').trim();
    const parsed = Number(textOnly);
    if (!Number.isNaN(parsed)) {
      return parsed;
    }

    const firstNumber = textOnly.match(/-?\d+(?:\.\d+)?/);
    return firstNumber?.[0] ? Number(firstNumber[0]) : Number.NEGATIVE_INFINITY;
  };

  const imageBase = '/images/items/';
  const parser = document.createElement('template');

  // Visible text of a compact cell, without the amount badge.
  const cellText = (value: unknown): string =>
    String(value ?? '')
      .replace(/<b>[^<]*<\/b>/g, '')
      .replace(/<span class="nms-sort">[^<]*<\/span>/g, '')
      .replace(/<[^>]*>/g, '')
      .replace(/&amp;/g, '&')
      .trim();

  // Empty cells (recipes with fewer inputs) always sort to the bottom.
  const sortByText = (
    a: SortValue,
    b: SortValue,
    _aRow: unknown,
    _bRow: unknown,
    _column: unknown,
    dir: string,
  ): number => {
    const textA = cellText(a);
    const textB = cellText(b);
    if (!textA && !textB) return 0;
    if (!textA) return dir === 'asc' ? 1 : -1;
    if (!textB) return dir === 'asc' ? -1 : 1;
    return textA.localeCompare(textB);
  };

  // Expand compact server markup (<a data-c data-i>Name</a><b>amount</b>) into the item card.
  const formatCell = (cell: { getValue: () => unknown }): string | HTMLElement => {
    const value = cell.getValue();
    if (typeof value !== 'string' || !value.includes('data-c=')) {
      return typeof value === 'string' ? value : '';
    }
    parser.innerHTML = value;
    const source = parser.content.querySelector('a');
    if (!source) return value;

    const link = document.createElement('a');
    link.href = source.getAttribute('href') ?? '#';
    link.className = 'cell-link';
    const content = document.createElement('div');
    content.className = 'cell-content';
    content.style.background = `#${source.dataset.c ?? '333333'}`;
    const text = document.createElement('span');
    text.className = 'cell-text flex items-center gap-2 flex-wrap';
    text.append(source.textContent ?? '');
    const amount = parser.content.querySelector('b')?.textContent;
    if (amount) {
      const badge = document.createElement('span');
      badge.className =
        'cell-amount inline-flex items-center justify-center min-w-[1.75rem] rounded-sm px-1.5 py-0.5 text-xs font-medium bg-black/30 text-gray-300 tabular-nums';
      badge.textContent = amount;
      text.append(badge);
    }
    content.append(text);
    if (source.dataset.i) {
      const img = document.createElement('img');
      img.src = `${imageBase}${source.dataset.i}`;
      img.alt = '';
      img.width = 50;
      img.height = 50;
      img.loading = 'lazy';
      img.decoding = 'async';
      content.append(img);
    }
    link.append(content);
    return link;
  };

  // Use requestAnimationFrame to defer execution until after React hydration
  requestAnimationFrame(() => {
    const tableElement = document.getElementById('table') as HTMLTableElement;
    if (!tableElement) return;

    const sort = tableElement.dataset.sort;
    let columns;
    try {
      columns = JSON.parse(tableElement.dataset.columns || '[]').map((element: ColumnData) => ({
      title: element.title,
      field: element.field,
      sorterParams: {
        alignEmptyValues: 'bottom',
      },
      formatter: formatCell,
      sorter:
        sort === element.field && sort === 'value'
          ? (a: SortValue, b: SortValue) => parseSortNumber(a) - parseSortNumber(b)
          : sortByText,
    }));
    } catch (error) {
      console.error('Failed to parse table columns:', error);
      return;
    }

    const table = new Tabulator('#table', {
      columns,
      initialSort: [{ column: sort, dir: sort !== 'value' ? 'asc' : 'desc' }],
      layout: 'fitColumns',
      pagination: true,
      paginationSize: 10,
      paginationSizeSelector: [10, 25, 50, 100, true],
      paginationCounter: 'rows',
      placeholder: 'No results found',
      printAsHtml: true,
    });

    table.on('dataLoaded', function () {
      if (table.element?.parentElement) {
        table.element.parentElement.classList.remove('d-hidden');
      }
    });

    function matchAny(data: Record<string, unknown>, filterParams: { value: string }) {
      // Escape special regex characters to prevent ReDoS attacks
      const escapedValue = filterParams.value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(escapedValue, 'i');
      return Object.values(data).some((value) => regex.test(String(value)));
    }

    const input = document.getElementById('search') as HTMLInputElement;
    if (input) {
      let debounceTimer: ReturnType<typeof setTimeout> | undefined;
      input.addEventListener('keyup', function () {
        if (debounceTimer) {
          clearTimeout(debounceTimer);
        }
        debounceTimer = setTimeout(() => {
          if (input.value.trim() === '') {
            table.clearFilter();
          } else {
            table.setFilter(matchAny, { value: input.value });
          }
        }, 150);
      });
    }
  });
</script>
