---
// Feedback form, sent through Formspree. Styles come from assets/css/alliances.css (.site-form).
---

<form action="https://formspree.io/mzbjbkzw" method="POST" class="panel space-y-5">
	<p class="help !mt-0"><span class="required" aria-hidden="true">*</span> Required</p>
	<div class="grid gap-5 sm:grid-cols-2">
		<div>
			<label for="feedback-name">Name <span class="required" aria-hidden="true">*</span></label>
			<input id="feedback-name" type="text" name="name" autocomplete="given-name" maxlength="80" required />
		</div>
		<div>
			<label for="feedback-email">Email <span class="optional">(optional)</span></label>
			<input id="feedback-email" type="email" name="email" autocomplete="email" maxlength="120" aria-describedby="feedback-email-help" />
			<p id="feedback-email-help" class="help">Only if you'd like a reply.</p>
		</div>
	</div>
	<div>
		<label for="feedback-subject">Subject <span class="required" aria-hidden="true">*</span></label>
		<input id="feedback-subject" type="text" name="subject" maxlength="120" required />
	</div>
	<div>
		<label for="feedback-message">Message <span class="required" aria-hidden="true">*</span></label>
		<textarea id="feedback-message" name="message" rows="6" maxlength="5000" required aria-describedby="feedback-message-help"></textarea>
		<p id="feedback-message-help" class="help">For a wrong recipe or missing item, include the item name so we can find it.</p>
	</div>
	<div class="pt-1">
		<button type="submit" class="button large">Send feedback</button>
	</div>
</form>
