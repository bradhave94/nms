---
import type { ItemUpdateMeta } from '@utils/updateChanges';
import { getUpdateDiffRows } from '@utils/updateChanges';
import { getById, getSlug } from '@utils/lookup';

interface Props {
	meta: ItemUpdateMeta;
}

const { meta } = Astro.props;
const diffRows = getUpdateDiffRows(meta);
const hasDiff = diffRows.length > 0;
const versionLabel = meta.versionLabel;
const previousLabel = meta.previousVersionLabel;
const originalVariantItem = meta.releaseVariant ? getById(meta.releaseVariant.BaseItemId) : undefined;
---

{
	meta.kind === 'added' ? (
		<div class="mb-6 mt-6 rounded-md border border-emerald-700/60 bg-emerald-950/40 px-4 py-3 text-sm text-emerald-100">
			<p class="m-0 font-semibold">Added in update {versionLabel}</p>
			{meta.releaseVariant && (
				<p class="m-0 mt-1 text-emerald-200/80">
					Expedition {meta.releaseVariant.Expedition} variant
					{originalVariantItem && <> of <a class="underline" href={getSlug(originalVariantItem)}>{originalVariantItem.Name}</a></>}.
				</p>
			)}
		</div>
	) : (
		<div
			id="update-changes-panel"
			class="update-changes-panel mb-6 mt-6 rounded-md border border-amber-700/60 bg-amber-950/35 text-sm text-amber-50"
			data-has-diff={hasDiff ? '1' : '0'}
		>
			<div class="px-4 py-3">
				<p class="m-0 font-semibold">Updated in update {versionLabel}</p>
				<p class="m-0 mt-1 text-amber-100/80">
					{hasDiff ? (
						<>
							{' '}
							<button
								type="button"
								aria-expanded="false"
								aria-controls="update-changes-detail"
								class="update-changes-toggle ml-1 underline hover:text-white"
							>
								Show what changed
							</button>
						</>
					) : (
						<> Data was refreshed for this patch; no player-facing text fields changed.</>
					)}
				</p>
			</div>
			{hasDiff && (
				<div id="update-changes-detail" class="update-changes-detail hidden min-w-0 border-t border-amber-800/60 px-4 py-3">
					{diffRows.map((row) => (
						<section class="min-w-0 border-t border-amber-900/50 py-3 first:border-0">
							<h3 class="m-0 mb-2 text-sm font-semibold text-amber-100">{row.field}</h3>
							<dl class="m-0 grid min-w-0 gap-3 sm:grid-cols-2">
								<div class="min-w-0">
									<dt class="text-xs text-amber-200/90">Before ({previousLabel})</dt>
									<dd class="m-0 mt-1 whitespace-pre-wrap [overflow-wrap:anywhere] text-amber-100/70">{row.before}</dd>
								</div>
								<div class="min-w-0">
									<dt class="text-xs text-amber-200/90">After ({versionLabel})</dt>
									<dd class="m-0 mt-1 whitespace-pre-wrap [overflow-wrap:anywhere] text-white">{row.after}</dd>
								</div>
							</dl>
						</section>
					))}
				</div>
			)}
		</div>
	)
}

<script>
	const panel = document.getElementById('update-changes-panel');
	if (!panel) {
		// Panel not rendered (added-item banner only).
	} else {
		const detail = panel.querySelector('.update-changes-detail');
		const toggle = panel.querySelector('.update-changes-toggle');
		const expand = () => {
			detail?.classList.remove('hidden');
			toggle?.setAttribute('aria-expanded', 'true');
		};
		const collapse = () => {
			detail?.classList.add('hidden');
			toggle?.setAttribute('aria-expanded', 'false');
		};

		if (new URLSearchParams(window.location.search).has('show_changes')) {
			expand();
		}

		toggle?.addEventListener('click', () => {
			if (detail?.classList.contains('hidden')) {
				expand();
			} else {
				collapse();
			}
		});
	}
</script>

<style>
	.update-changes-panel:target .update-changes-detail,
	.update-changes-panel[data-force-open='1'] .update-changes-detail {
		display: block;
	}
</style>
