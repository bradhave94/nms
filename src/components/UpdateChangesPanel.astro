---
import type { ItemUpdateMeta } from '@utils/updateChanges';
import { getUpdateDiffRows } from '@utils/updateChanges';
import { getById, getSlug } from '@utils/lookup';

interface Props {
	meta: ItemUpdateMeta;
}

const { meta } = Astro.props;
const diffRows = getUpdateDiffRows(meta);
const hasDiff = diffRows.length > 0;
const versionLabel = meta.versionLabel;
const previousLabel = meta.previousVersionLabel;
// The game uses the literal enum value "None" for unset fields.
const showValue = (value: string): string => (value === 'None' ? '(not set)' : value);
const originalVariantItem = meta.releaseVariant ? getById(meta.releaseVariant.BaseItemId) : undefined;
---
{
	meta.kind === 'added' ? (
		<div class="update-note panel flex items-start gap-3 px-4 py-3 text-[.9rem]">
			<span class="mt-[.45rem] h-2 w-2 shrink-0 rounded-full bg-glow" aria-hidden="true"></span>
			<div class="min-w-0">
				<p class="m-0 font-semibold text-ink">Added in update {versionLabel}</p>
				{meta.releaseVariant && (
					<p class="m-0 mt-1 text-dim">
						Expedition {meta.releaseVariant.Expedition} variant
						{originalVariantItem && <> of <a class="link" href={getSlug(originalVariantItem)}>{originalVariantItem.Name}</a></>}.
					</p>
				)}
			</div>
		</div>
	) : (
		<div
			id="update-changes-panel"
			class="update-changes-panel update-note panel text-[.9rem]"
			data-has-diff={hasDiff ? '1' : '0'}
		>
			<div class="flex items-start gap-3 px-4 py-3">
				<span class="mt-[.45rem] h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
				<div class="min-w-0">
					<p class="m-0 font-semibold text-ink">Updated in update {versionLabel}</p>
					<p class="m-0 mt-1 text-dim">
						{hasDiff ? (
							<button
								type="button"
								aria-expanded="false"
								aria-controls="update-changes-detail"
								class="update-changes-toggle link min-h-6"
							>
								Show what changed
							</button>
						) : (
							<>Data was refreshed for this patch; no player-facing text fields changed.</>
						)}
					</p>
				</div>
			</div>
			{hasDiff && (
				<div id="update-changes-detail" class="update-changes-detail hidden min-w-0 border-t border-line px-4 py-3">
					{diffRows.map((row) => (
						<section class="min-w-0 border-t border-line py-3 first:border-0">
							<p class="m-0 mb-2 font-semibold text-ink">{row.field}</p>
							<dl class="m-0 grid min-w-0 gap-3 sm:grid-cols-2">
								<div class="min-w-0">
									<dt class="text-[.8rem] text-dim">Before ({previousLabel})</dt>
									<dd class="m-0 mt-1 whitespace-pre-wrap [overflow-wrap:anywhere] text-dim">{showValue(row.before)}</dd>
								</div>
								<div class="min-w-0">
									<dt class="text-[.8rem] text-dim">After ({versionLabel})</dt>
									<dd class="m-0 mt-1 whitespace-pre-wrap [overflow-wrap:anywhere] text-ink">{showValue(row.after)}</dd>
								</div>
							</dl>
						</section>
					))}
				</div>
			)}
		</div>
	)
}

<script>
	const panel = document.getElementById('update-changes-panel');
	if (!panel) {
		// Panel not rendered (added-item banner only).
	} else {
		const detail = panel.querySelector('.update-changes-detail');
		const toggle = panel.querySelector('.update-changes-toggle');
		const expand = () => {
			detail?.classList.remove('hidden');
			toggle?.setAttribute('aria-expanded', 'true');
		};
		const collapse = () => {
			detail?.classList.add('hidden');
			toggle?.setAttribute('aria-expanded', 'false');
		};

		if (new URLSearchParams(window.location.search).has('show_changes')) {
			expand();
		}

		toggle?.addEventListener('click', () => {
			if (detail?.classList.contains('hidden')) {
				expand();
			} else {
				collapse();
			}
		});
	}
</script>

<style>
	.update-changes-panel:target .update-changes-detail,
	.update-changes-panel[data-force-open='1'] .update-changes-detail {
		display: block;
	}
</style>
