---
import { SITE } from '@config';

const filters = [
	{ id: 'raw', name: 'Raw Materials' },
	{ id: 'products', name: 'Products' },
	{ id: 'technology', name: 'Technology' },
	{ id: 'upgrades', name: 'Upgrades' },
	{ id: 'buildings', name: 'Buildings' },
	{ id: 'food', name: 'Food' },
	{ id: 'curiosities', name: 'Curiosities' },
	{ id: 'exocraft', name: 'Exocraft' },
	{ id: 'starships', name: 'Starships' },
	{ id: 'corvette', name: 'Corvette' },
	{ id: 'creatures', name: 'Creatures' },
	{ id: 'fish', name: 'Fish' },
	{ id: 'other', name: 'Other' },
	{ id: 'blog', name: 'Guides' },
];
const filterLabels = Object.fromEntries(filters.map((f) => [f.id, f.name]));
---

<div class="fixed inset-0 z-50 hidden" id="site-search" role="dialog" aria-modal="true" aria-labelledby="site-search-title">
	<div class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
	<div class="relative z-10 flex min-h-full items-start justify-center p-3 sm:p-6 sm:pt-[10vh]">
		<div id="site-search-panel" class="flex max-h-[calc(100dvh-1.5rem)] w-full max-w-2xl flex-col overflow-hidden rounded-2xl border border-line bg-[#0b1017] shadow-2xl shadow-black/70 sm:max-h-[80vh]">
			<h2 id="site-search-title" class="sr-only">Search the site</h2>
			<div class="flex items-center gap-2 border-b border-line px-3">
				<svg class="h-5 w-5 shrink-0 text-dim" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"></path></svg>
				<input id="search-input" type="search" enterkeyhint="search" class="h-14 min-w-0 flex-1 border-0 bg-transparent px-1 text-lg text-ink placeholder:text-dim focus:outline-none focus:ring-0" placeholder="Search items, recipes and guides" aria-label="Search items, recipes and guides" aria-describedby="search-status" autocomplete="off" spellcheck="false" />
				<button id="search-filter-toggle" type="button" class="btn-quiet !min-h-9 !px-3 text-sm" aria-expanded="false" aria-controls="search-filters">Filter<span id="search-filter-count" class="tabular"></span></button>
				<button id="site-search-close" type="button" class="btn-quiet !min-h-9 !px-3 text-sm"><span class="sr-only">Close search</span><span aria-hidden="true" class="hidden sm:inline">Esc</span><span aria-hidden="true" class="sm:hidden">Close</span></button>
			</div>
			<fieldset id="search-filters" class="hidden border-b border-line px-3 py-3">
				<legend class="sr-only">Only show</legend>
				<div class="flex flex-wrap gap-1.5">
					{filters.map((f) => (
						<span class="inline-flex">
							<input type="checkbox" class="peer sr-only" name="type-filter" id={`sf-${f.id}`} value={f.id} />
							<label for={`sf-${f.id}`} class="inline-flex min-h-8 cursor-pointer items-center rounded-full border border-line-strong px-3 text-sm text-ink select-none peer-checked:border-accent peer-checked:bg-accent peer-checked:text-accent-ink peer-focus-visible:outline-3 peer-focus-visible:outline-[#facc15]">{f.name}</label>
						</span>
					))}
				</div>
			</fieldset>
			<p id="search-status" class="sr-only" role="status" aria-live="polite"></p>
			<div id="search-hint" class="px-4 py-5 text-sm text-dim">Type a name, an ingredient or a refiner operation. Use the arrow keys to move through results.</div>
			<ul id="results" class="m-0 hidden min-h-0 flex-1 list-none overflow-y-auto overscroll-contain p-2" data-filter-labels={JSON.stringify(filterLabels)} data-image-base={SITE.imageBaseUrl}></ul>
		</div>
	</div>
</div>

<script>
	import { toWebp } from '@utils/icons';

	type Entry = { id: string; name: string; type: string; url: string; icon?: string; subtitle?: string; searchText?: string };

	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const results = document.getElementById('results') as HTMLUListElement | null;
	const hint = document.getElementById('search-hint');
	const status = document.getElementById('search-status');
	const filterToggle = document.getElementById('search-filter-toggle');
	const filterBox = document.getElementById('search-filters');
	const filterCount = document.getElementById('search-filter-count');
	const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name=type-filter]'));
	const labels: Record<string, string> = results?.dataset.filterLabels ? JSON.parse(results.dataset.filterLabels) : {};
	const imageBase = results?.dataset.imageBase ?? '/images/items/';
	const MAX = 60;
	let dataset: Promise<Entry[]> | null = null;
	let timer: ReturnType<typeof setTimeout> | undefined;

	const load = (): Promise<Entry[]> => {
		dataset ??= fetch('/search.json', { cache: 'force-cache' })
			.then((r) => r.json())
			.then((j) => (Array.isArray(j?.body) ? j.body.filter((e: Entry) => typeof e?.name === 'string') : []))
			.catch((e) => { dataset = null; throw e; });
		return dataset;
	};

	// Exact name, then names starting with the query, then a word in the name starting with it, then any
	// name match, then matches only in hidden text (ingredients, aliases, guide descriptions).
	function rank(e: Entry, q: string): number {
		const n = e.name.toLowerCase();
		if (n === q) return 0;
		if (n.startsWith(q)) return 1;
		if (n.split(/[\s\-–:()']+/).some((w) => w.startsWith(q))) return 2;
		if (n.includes(q)) return 3;
		if (e.searchText?.toLowerCase().includes(q)) return 4;
		return 9;
	}

	const say = (msg: string) => { if (status) status.textContent = msg; };

	async function run(): Promise<void> {
		if (!input || !results || !hint) return;
		const q = input.value.trim().toLowerCase();
		const types = boxes.filter((b) => b.checked).map((b) => b.value);
		if (!q) {
			results.classList.add('hidden');
			hint.classList.remove('hidden');
			hint.textContent = 'Type a name, an ingredient or a refiner operation. Use the arrow keys to move through results.';
			say('');
			return;
		}
		let data: Entry[];
		try {
			data = await load();
		} catch {
			hint.textContent = 'Search could not load. Check your connection and try again.';
			say(hint.textContent);
			return;
		}
		const hits = data
			.filter((e) => !types.length || types.includes(e.type))
			.map((e) => ({ e, r: rank(e, q) }))
			.filter((x) => x.r < 9)
			.sort((a, b) => a.r - b.r || a.e.name.length - b.e.name.length || a.e.name.localeCompare(b.e.name));
		results.textContent = '';
		if (!hits.length) {
			results.classList.add('hidden');
			hint.classList.remove('hidden');
			hint.textContent = types.length ? 'No matches in the selected categories.' : 'No matches. Try a shorter word.';
			say(hint.textContent);
			return;
		}
		hint.classList.add('hidden');
		results.classList.remove('hidden');
		for (const { e } of hits.slice(0, MAX)) {
			const li = document.createElement('li');
			const a = document.createElement('a');
			a.href = e.url.replace(/\/+/g, '/');
			a.className = 'search-hit';
			const slot = document.createElement('span');
			slot.className = 'search-ico';
			if (e.icon) {
				const img = document.createElement('img');
				img.src = `${imageBase}${toWebp(e.icon)}`;
				img.alt = '';
				img.loading = 'lazy';
				img.width = 36;
				img.height = 36;
				slot.appendChild(img);
			} else if (e.type === 'blog') {
				slot.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z"/></svg>';
			}
			const name = document.createElement('span');
			name.className = 'search-name';
			name.textContent = e.name;
			if (e.subtitle) {
				const sub = document.createElement('small');
				sub.textContent = e.subtitle;
				name.appendChild(sub);
			}
			const type = document.createElement('span');
			type.className = 'search-type';
			type.textContent = labels[e.type] ?? e.type;
			a.append(slot, name, type);
			li.appendChild(a);
			results.appendChild(li);
		}
		const n = hits.length;
		say(`${n > MAX ? `${MAX} of ${n}` : n} result${n === 1 ? '' : 's'}. Press Down Arrow to move to them.`);
	}

	const schedule = () => { clearTimeout(timer); timer = setTimeout(run, 120); };
	input?.addEventListener('focus', () => { load().catch(() => {}); }, { once: true });
	input?.addEventListener('input', schedule);
	boxes.forEach((b) => b.addEventListener('change', () => {
		const n = boxes.filter((x) => x.checked).length;
		if (filterCount) filterCount.textContent = n ? ` (${n})` : '';
		schedule();
	}));
	filterToggle?.addEventListener('click', () => {
		const open = filterToggle.getAttribute('aria-expanded') !== 'true';
		filterToggle.setAttribute('aria-expanded', String(open));
		filterBox?.classList.toggle('hidden', !open);
	});

	// Arrow keys: input -> first result, then through the list; Up from the first goes back to the input.
	const links = () => (results ? Array.from(results.querySelectorAll<HTMLAnchorElement>('a')) : []);
	input?.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowDown') { const first = links()[0]; if (first) { e.preventDefault(); first.focus(); } }
		if (e.key === 'Enter') { const first = links()[0]; if (first) { e.preventDefault(); first.click(); } }
	});
	results?.addEventListener('keydown', (e) => {
		const list = links();
		const i = list.indexOf(document.activeElement as HTMLAnchorElement);
		if (i < 0) return;
		if (e.key === 'ArrowDown') { e.preventDefault(); list[i + 1]?.focus(); }
		if (e.key === 'ArrowUp') { e.preventDefault(); (i > 0 ? list[i - 1] : input)?.focus(); }
	});
</script>

<style is:global>
	.search-hit { display: flex; align-items: center; gap: .75rem; padding: .45rem .6rem; border-radius: 10px; color: var(--color-ink); }
	.search-hit:hover, .search-hit:focus-visible { background: var(--color-panel-3); }
	.search-ico { color: var(--color-accent); display: grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 9px; background: var(--color-panel-2); border: 1px solid var(--color-line); }
	.search-ico img { width: 32px; height: 32px; object-fit: contain; }
	.search-name { min-width: 0; flex: 1; font-size: 1.0625rem; line-height: 1.25; }
	.search-name small { display: block; font-size: .8125rem; color: var(--color-dim); }
	.search-type { flex: none; font-size: .8125rem; color: var(--color-dim); }
</style>
