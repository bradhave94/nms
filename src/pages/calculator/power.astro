---
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { buildPowerCatalog } from '@utils/basePowerCatalog.js';
import { AUTO_SOLAR_PANEL_LIMIT } from '@utils/basePower.js';
import '@assets/css/calculators.css';

const catalog = buildPowerCatalog();
const rulesSource = catalog.rulesProvenance.SteamBuildId ? `Steam build ${catalog.rulesProvenance.SteamBuildId}` : `game ${catalog.rulesProvenance.GameVersion}`;
const reactorRate = catalog.equipment.find((item) => item.id === 'U_BIOGENERATOR')?.generation;
const title = "Base Power Calculator | No Man's Sky Recipes";
const description = 'Calculate solar panels, batteries, electromagnetic generators and biofuel reactors for your No Man’s Sky base. Get a power plan and construction materials list.';
const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Calculators', href: '/calculator/' }, { name: 'Base Power Calculator' }];
const structuredData = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name,
		item: `https://nomansskyrecipes.com${item.href ?? '/calculator/power/'}` })),
};
---
<Layout {title} {description} slug="calculator" {structuredData}>
	<div id="base-power" data-catalog={JSON.stringify(catalog)} class="calc">
		<Breadcrumbs items={breadcrumbs} className="pt-2 mb-2 px-0!" />
		<header class="calc-head">
			<h1>Base power calculator</h1>
			<p>Plan your base’s power with solar panels, electromagnetic generators or biofuel reactors, and get the materials to build them.</p>
		</header>
		<noscript><p class="panel calc-pad mb-6">Enable JavaScript to calculate your base’s power requirements.</p></noscript>
		<div class="calc-grid">
			<form id="power-form" class="calc-col">
				<section class="panel calc-pad" aria-labelledby="load-heading">
					<h2 id="load-heading">Your base’s power draw</h2>
					<fieldset class="calc-seg mt-4"><legend class="sr-only">How to calculate consumption</legend>
						<label><input type="radio" name="load-mode" value="total" checked />Enter total</label>
						<label><input type="radio" name="load-mode" value="devices" />Add devices</label>
					</fieldset>
					<div id="total-fields" class="mt-5">
						<label for="power-load" class="calc-label">Total consumption (kP/s)</label>
						<input id="power-load" class="field calc-field-num" type="number" min="0" max="1000000" step="any" inputmode="decimal" value="100" required />
						<p class="calc-help">Use the power grid’s consumption reading from a connected battery or generator.</p>
					</div>
					<div id="device-fields" class="mt-5" hidden>
						<label for="power-device" class="calc-label">Add a powered building or device</label>
						<div class="flex gap-2">
							<select id="power-device" class="field min-w-0 flex-1"><option value="">Choose a device…</option>
								{catalog.devices.map((item) => <option value={item.id}>{item.name} — {item.consumption} kP/s</option>)}
							</select><button type="button" id="power-add" class="btn-quiet min-h-[44px] flex-none">Add</button>
						</div>
						<ul id="power-devices" class="mt-3" aria-label="Devices in your base"></ul>
						<p id="device-empty" class="calc-help">Add devices to build your base’s power budget.</p>
						<p class="calc-help">All selected devices are treated as active. Include powered rooms, corridors, doors and trays; crops add no separate power draw. For wiring or switched devices, the measured total is more accurate.</p>
					</div>
					<div class="mt-5"><label for="power-reserve" class="calc-label">Spare capacity (%)</label>
						<input id="power-reserve" class="field calc-field-num" type="number" min="0" max="100" step="1" inputmode="numeric" value="0" required />
						<p class="calc-help">Leave room for growth by planning for a higher load.</p>
					</div>
				</section>
				<section class="panel calc-pad" aria-labelledby="supply-heading">
					<h2 id="supply-heading">Power you already have</h2>
					<div class="mt-4 grid grid-cols-2 gap-4">
						<div><label for="power-panels" class="calc-label">Solar panels</label><input id="power-panels" class="field" type="number" min="0" max="100000" step="1" inputmode="numeric" value="0" required /></div>
						<div><label for="power-batteries" class="calc-label">Batteries</label><input id="power-batteries" class="field" type="number" min="0" max="100000" step="1" inputmode="numeric" value="0" required /></div>
					</div>
					<div class="mt-4"><label for="power-continuous" class="calc-label">Continuous generation (kP/s)</label>
						<input id="power-continuous" class="field calc-field-num" type="number" min="0" max="1000000" step="any" inputmode="decimal" value="0" required />
						<p class="calc-help">Combined output of existing electromagnetic generators. Exclude solar panels and fuel-dependent reactors for an unattended base.</p>
					</div>
				</section>
				<section class="panel calc-pad" aria-labelledby="plan-heading">
					<h2 id="plan-heading">Choose your power source</h2>
					<fieldset class="calc-seg mt-4"><legend class="sr-only">Power source to build</legend>
						<label><input type="radio" name="strategy" value="auto" checked />Automatic</label>
						<label><input type="radio" name="strategy" value="solar" />Solar + batteries</label>
						<label><input type="radio" name="strategy" value="electromagnetic" />Electromagnetic</label>
						<label><input type="radio" name="strategy" value="biofuel" />Biofuel</label>
					</fieldset>
					<p class="calc-help">Automatic suggests electromagnetic power when you need {AUTO_SOLAR_PANEL_LIMIT} or more additional solar panels. Choose a source yourself to keep that choice.</p>
					<div id="biofuel-fields" class="mt-5" hidden>
						<label for="power-reactors" class="calc-label">Biofuel reactors you already have</label>
						<input id="power-reactors" class="field calc-field-num" type="number" min="0" max="100000" step="1" inputmode="numeric" value="0" required />
						<p class="calc-help">Each reactor supplies {reactorRate} kP/s while fueled. This plan assumes you keep every reactor fueled; solar output is not counted toward it. Fuel quantities and runtime are not estimated.</p>
					</div>
					<div id="solar-fields" class="mt-4">
						<p class="calc-help">The default estimate uses 15 minutes of full sun and 15 minutes of darkness. Batteries must charge before the first night.</p>
						<details class="mt-2"><summary>Adjust the daylight estimate</summary>
							<div class="mt-3 grid grid-cols-2 gap-4">
								<div><label for="power-night" class="calc-label">Darkness (minutes)</label><input id="power-night" class="field" type="number" min="0" max="30" step="0.1" inputmode="decimal" value="15" required /></div>
								<div><label for="power-twilight" class="calc-label">Dawn + dusk (minutes)</label><input id="power-twilight" class="field" type="number" min="0" max="30" step="0.1" inputmode="decimal" value="0" required /></div>
							</div>
							<p class="calc-help">Within the extracted {catalog.cycleSeconds / 60}-minute cycle, the remaining time is full sun. Twilight is modeled at half output. These phase lengths are adjustable estimates, not extracted guarantees for every location.</p>
						</details>
					</div>
					<div id="generator-fields" class="mt-5" hidden>
						<label for="power-generator" class="calc-label">Output per additional generator (kP/s)</label>
						<input id="power-generator" class="field calc-field-num" type="number" min="0.1" max="1000000" step="any" inputmode="decimal" value="150" required />
						<p class="calc-help">Requires an electromagnetic hotspot. Enter the output measured where you’ll place it. Choose solar or biofuel if you have no suitable hotspot.</p>
						<div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Hotspot reference strengths">
							{Object.entries(catalog.hotspotStrengths).map(([key, value]) => <button type="button" class="btn-quiet tabular" data-strength={value}>{key}: {value}</button>)}
						</div><p class="calc-help">Extracted class-strength references; actual output depends on placement.</p>
					</div>
				</section>
			</form>
			<div class="calc-col">
				<section class="panel-amber calc-pad" aria-labelledby="result-heading">
					<h2 id="result-heading">Ready for day and night</h2>
					<p id="power-error" class="mt-3 font-medium text-accent" role="alert" hidden></p>
					<div id="power-result-body">
						<p id="power-budget" class="mt-2 text-dim tabular"></p>
						<p id="power-recommendation" class="calc-help" role="status" aria-live="polite" hidden></p>
						<div id="power-counts" class="mt-5 grid gap-4 sm:grid-cols-2"></div>
						<p id="power-status" class="mt-5" role="status" aria-live="polite"></p>
						<dl id="power-details" class="mt-4 text-[.95rem]"></dl>
						<p class="calc-help mt-4">An estimate for one connected planetary base grid, with normal power requirements enabled. Freighters, corvettes and free-power settings are outside this plan.</p>
					</div>
				</section>
				<section id="power-materials-panel" class="panel calc-pad" aria-labelledby="materials-heading">
					<h2 id="materials-heading">Materials for the additions</h2>
					<p class="calc-help">Direct construction ingredients for new power equipment.</p>
					<ul id="power-materials" class="mt-3"></ul>
					<a id="power-planner" class="btn-quiet mt-4" href="/calculator/planner">Open in crafting planner →</a>
				</section>
				<div class="flex flex-wrap gap-3"><button type="button" id="power-share" class="btn-quiet">Copy plan link</button><button type="button" id="power-reset" class="btn-quiet">Reset</button></div>
				<p id="power-share-status" class="calc-help -mt-3" role="status"></p>
			</div>
		</div>
		<div class="mt-8 grid gap-4">
			<details class="panel calc-pad">
				<summary>How the calculation works & data sources</summary>
				<div class="mt-4 grid gap-8">
					<dl class="grid gap-3 sm:grid-cols-3">
						<div class="rounded-[10px] border border-line bg-panel-2 p-4"><dt class="text-sm text-dim">Solar panel output</dt><dd class="mt-1">Up to <strong class="tabular text-2xl font-semibold">{catalog.panelRate}</strong> kP/s</dd></div>
						<div class="rounded-[10px] border border-line bg-panel-2 p-4"><dt class="text-sm text-dim">Battery capacity</dt><dd class="mt-1"><strong class="tabular text-2xl font-semibold">{catalog.batteryCapacity.toLocaleString('en-US')}</strong> kP</dd></div>
						<div class="rounded-[10px] border border-line bg-panel-2 p-4"><dt class="text-sm text-dim">Biofuel reactor output</dt><dd class="mt-1"><strong class="tabular text-2xl font-semibold">{reactorRate}</strong> kP/s <span class="block text-sm text-dim">while fueled</span></dd></div>
					</dl>
					<div class="grid gap-8 md:grid-cols-2">
						<section class="calc-prose" aria-labelledby="power-method-heading">
							<h3 id="power-method-heading" class="text-ink">How we size your system</h3>
							<h4 class="mt-4 mb-1.5 font-semibold text-ink">Solar panels & batteries</h4>
							<p>Panels must power your base during the day and recharge the energy used overnight. <strong>More batteries cannot make up for too few panels.</strong></p>
							<p>We check the daily energy budget and the largest storage shortfall across full sun, dusk, night and dawn. Your existing panels count toward the plan; continuous generation reduces the load they need to cover.</p>
							<h4 class="mt-4 mb-1.5 font-semibold text-ink">Electromagnetic generators</h4>
							<p>This mode adds enough continuous generation to cover the remaining load without relying on solar.</p>
							<h4 class="mt-4 mb-1.5 font-semibold text-ink">Biofuel reactors</h4>
							<p>Biofuel mode covers the remaining load with fueled reactors, including any you already own. It includes construction materials, but does not estimate fuel quantities or runtime. Reactors need refueling to keep supplying power.</p>
						</section>
						<section class="calc-prose" aria-labelledby="power-assumptions-heading">
							<h3 id="power-assumptions-heading" class="text-ink">Assumptions to keep in mind</h3>
							<h4 class="mt-4 mb-1.5 font-semibold text-ink">Battery discharge</h4>
							<p>Battery sizing is based on stored energy. The <a class="link" href="https://nomanssky.fandom.com/wiki/Battery">wiki lists a 50 kP/s discharge limit per battery</a>, which we have not verified in the game data.</p>
							<p>The default 15-minute night already allows at least one battery per 50 kP/s of remaining load. <strong>Shorter custom nights may need an in-game check.</strong></p>
							<h4 class="mt-4 mb-1.5 font-semibold text-ink">Short-range teleporters</h4>
							<p>We budget 5 kP/s for each powered unit. The <a class="link" href="https://nomanssky.fandom.com/wiki/Short-Range_Teleporter">wiki documents versions where they work without power</a>. Use your measured grid consumption if your base behaves differently.</p>
						</section>
					</div>
					<section class="calc-prose max-w-none border-t border-line pt-6 text-[.95rem]" aria-labelledby="power-sources-heading">
						<h3 id="power-sources-heading" class="text-ink">Data sources</h3>
						<dl class="my-3 grid gap-3">
							<div class="grid gap-1 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-4"><dt class="font-semibold text-ink">Device rates & recipes</dt><dd>Extracted game {catalog.gameVersion} catalog.</dd></div>
							<div class="grid gap-1 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-4"><dt class="font-semibold text-ink">Day cycle & hotspot strengths</dt><dd class="[overflow-wrap:anywhere]">{rulesSource}{catalog.rulesProvenance.ObservedDate ? ` · observed ${catalog.rulesProvenance.ObservedDate}` : ''}.</dd></div>
						</dl>
						<p>The cycle length does not establish the full solar schedule at your base. Daylight and twilight durations remain adjustable estimates.</p>
					</section>
				</div>
			</details>
			<details class="panel calc-pad"><summary>Parts that add no power draw</summary>
				<p class="calc-help">These parts have electrical connections but add no consumption in the game data. They do not need to be added to your power budget.</p>
				<ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
					{catalog.zeroDrawDevices.map((item) => <li><a class="link" href={item.url}>{item.name}</a></li>)}
				</ul>
				<p class="calc-help">The Galactic Trade Terminal has required no base power since <a href="https://www.nomanssky.com/frontiers-update/" class="link">Frontiers</a>. The Small Generator is a decoration and produces no electricity. Supply depots and pipes store or transport resources; they add no electrical load.</p>
			</details>
		</div>
	</div>
</Layout>

<script>
	import '../../scripts/basePower';
</script>
