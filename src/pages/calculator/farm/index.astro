---
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getAllGrowablePlants } from '@utils/plantGrowTime.js';
import { getById } from '@utils/lookup.js';
import { getSiteOrigin } from '@utils/structuredData.js';
import { SITE } from '@config';
import '@assets/css/calculators.css';

const IMAGE_BASE = SITE.imageBaseUrl;
const plants = getAllGrowablePlants().map((plant) => ({
	...plant,
	colour: getById(plant.harvestId)?.Colour || undefined,
}));
const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL('/calculator/farm/', siteOrigin).toString();
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Crafting Calculator', href: '/calculator' },
	{ name: 'Farm Calculator' },
];
const title = "Farm Calculator | No Man's Sky Recipes";
const description =
	'Plan your No Man\'s Sky farm plots by grow time and harvest yield. Select plants, set plot counts, and see total real-time duration and output.';
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'@id': `${canonicalUrl}#breadcrumb`,
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Crafting Calculator', item: `${siteOrigin}/calculator/` },
		{ '@type': 'ListItem', position: 3, name: 'Farm Calculator', item: canonicalUrl },
	],
};
const structuredData = [breadcrumbSchema];
---

<Layout {title} {description} slug="calculator" structuredData={structuredData}>
	<div class="calc">
		<Breadcrumbs items={breadcrumbs} className="pt-2 mb-2 px-0!" />
		<header class="calc-head">
			<h1>Farm calculator</h1>
			<p>Pick your crops and plot counts to see the harvest cycle time and base yield. Harvest upgrades may increase your actual yield.</p>
		</header>

		<div id="farm-app" class="calc-grid" data-image-base={IMAGE_BASE} data-plants={JSON.stringify(plants)}>
			<section class="panel calc-pad" aria-labelledby="crops-heading">
				<h2 id="crops-heading">Your crops</h2>
				<div class="mt-4">
					<label for="plant-select" class="calc-label">Add a plant</label>
					<div class="flex flex-wrap gap-3">
						<select id="plant-select" class="field min-w-0 basis-full sm:basis-auto sm:flex-1 sm:min-w-[14rem]">
							<option value="">Choose a plant…</option>
							{
								plants.map((plant) => (
									<option value={plant.harvestId}>
										{plant.name} ({plant.growTime})
									</option>
								))
							}
						</select>
						<button id="add-plant-btn" type="button" class="btn-primary">Add plant</button>
					</div>
					<p id="farm-status" class="sr-only" role="status" aria-live="polite"></p>
				</div>
				<ul id="selected-plants" class="mt-4" aria-label="Selected plants"></ul>
				<p id="empty-selection" class="calc-empty mt-4">
					No plants selected yet. Add a crop above to start planning.
				</p>
			</section>

			<section class="panel-amber calc-pad" aria-labelledby="harvest-heading">
				<h2 id="harvest-heading">Harvest</h2>
				<p id="results-empty" class="calc-empty mt-3">Add a plant to see the harvest cycle and yield.</p>
				<div id="farm-results" hidden>
					<dl class="calc-stats mt-4">
						<div class="calc-stat">
							<dt>Full harvest cycle</dt>
							<dd id="cycle-time" class="value"></dd>
							<dd class="calc-help mt-1">Longest grow time among selected plants</dd>
						</div>
						<div class="calc-stat">
							<dt>Total plots</dt>
							<dd id="total-plots" class="value"></dd>
							<dd class="calc-help mt-1">Combined plant count across all crops</dd>
						</div>
					</dl>
					<h3 class="mt-6">Total yield per harvest</h3>
					<ul id="yield-list" class="mt-1"></ul>
				</div>
			</section>
		</div>
	</div>
</Layout>

<script>
	import { bindNumericPaste, itemSlot, removeButton } from '../../../scripts/calculatorUi';

	type Plant = {
		harvestId: string;
		name: string;
		icon: string;
		colour?: string;
		growTime: string;
		growTimeMinutes: number;
		harvestQuantity: number;
	};

	const app = document.getElementById('farm-app');
	if (app) setup(app);

	function setup(app: HTMLElement) {
		const plants: Plant[] = JSON.parse(app.dataset.plants ?? '[]');
		const imageBase = app.dataset.imageBase ?? '/images/items/';
		const plantById = new Map(plants.map((plant) => [plant.harvestId, plant]));
		const selected = new Map<string, number>();

		const plantSelect = document.getElementById('plant-select') as HTMLSelectElement;
		const addBtn = document.getElementById('add-plant-btn') as HTMLButtonElement;
		const list = document.getElementById('selected-plants')!;
		const emptyEl = document.getElementById('empty-selection')!;
		const resultsEmpty = document.getElementById('results-empty')!;
		const resultsEl = document.getElementById('farm-results')!;
		const yieldList = document.getElementById('yield-list')!;
		const cycleTimeEl = document.getElementById('cycle-time')!;
		const totalPlotsEl = document.getElementById('total-plots')!;
		const status = document.getElementById('farm-status')!;

		const slot = (plant: Plant, quantity?: number) =>
			itemSlot({ icon: plant.icon, colour: plant.colour, quantity, size: 'w-11', imageBase });

		function formatMinutes(minutes: number) {
			const hours = Math.floor(minutes / 60);
			const mins = minutes % 60;
			if (hours && mins) {
				return `${hours} hour${hours !== 1 ? 's' : ''} ${mins} minute${mins !== 1 ? 's' : ''}`;
			}
			if (hours) {
				return `${hours} hour${hours !== 1 ? 's' : ''}`;
			}
			return `${mins} minute${mins !== 1 ? 's' : ''}`;
		}

		/** Results only; the input rows stay in place so typing keeps focus. */
		function renderResults() {
			const empty = selected.size === 0;
			emptyEl.hidden = !empty;
			resultsEmpty.hidden = !empty;
			resultsEl.hidden = empty;
			yieldList.replaceChildren();
			if (empty) return;

			let maxMinutes = 0;
			let totalPlots = 0;
			for (const [harvestId, count] of selected) {
				const plant = plantById.get(harvestId);
				if (!plant) continue;
				maxMinutes = Math.max(maxMinutes, plant.growTimeMinutes);
				totalPlots += count;
				const totalYield = count * plant.harvestQuantity;

				const row = document.createElement('li');
				row.className = 'calc-row';
				row.appendChild(slot(plant, totalYield));
				const name = document.createElement('span');
				name.className = 'name';
				const sub = document.createElement('span');
				sub.className = 'sub tabular';
				sub.textContent = `${plant.harvestQuantity.toLocaleString()} per plot × ${count.toLocaleString()} plot${count === 1 ? '' : 's'}`;
				name.append(plant.name, sub);
				const amount = document.createElement('span');
				amount.className = 'calc-amount';
				amount.textContent = totalYield.toLocaleString();
				row.append(name, amount);
				yieldList.appendChild(row);
			}

			cycleTimeEl.textContent = maxMinutes > 0 ? formatMinutes(maxMinutes) : '—';
			totalPlotsEl.textContent = totalPlots.toLocaleString();
		}

		function renderRows() {
			list.replaceChildren();
			for (const [harvestId, count] of selected) {
				const plant = plantById.get(harvestId);
				if (!plant) continue;
				const row = document.createElement('li');
				row.className = 'calc-row';
				row.dataset.harvestId = harvestId;
				row.appendChild(slot(plant));

				const name = document.createElement('span');
				name.className = 'name font-medium';
				const sub = document.createElement('span');
				sub.className = 'sub font-normal';
				sub.textContent = plant.growTime;
				name.append(plant.name, sub);
				row.appendChild(name);

				const field = document.createElement('input');
				field.type = 'number';
				field.min = '1';
				field.step = '1';
				field.inputMode = 'numeric';
				field.value = String(count);
				field.className = 'field w-[4.5rem] sm:w-24 flex-none text-center';
				field.setAttribute('aria-label', `Plot count for ${plant.name}`);
				field.addEventListener('input', () => {
					const value = Number.parseInt(field.value, 10);
					if (Number.isFinite(value) && value >= 1) {
						selected.set(harvestId, value);
						renderResults();
					}
				});
				field.addEventListener('change', () => {
					const value = Math.max(1, Number.parseInt(field.value, 10) || 1);
					field.value = String(value);
					selected.set(harvestId, value);
					renderResults();
				});
				row.appendChild(field);

				const remove = removeButton(`Remove ${plant.name}`);
				remove.addEventListener('click', () => {
					const index = [...selected.keys()].indexOf(harvestId);
					selected.delete(harvestId);
					renderRows();
					renderResults();
					status.textContent = `Removed ${plant.name}.`;
					const buttons = list.querySelectorAll<HTMLButtonElement>('.calc-remove');
					(buttons[Math.min(index, buttons.length - 1)] ?? plantSelect).focus();
				});
				row.appendChild(remove);
				list.appendChild(row);
			}
		}

		addBtn.addEventListener('click', () => {
			const harvestId = plantSelect.value;
			const plant = plantById.get(harvestId);
			if (!plant) return;
			if (!selected.has(harvestId)) {
				selected.set(harvestId, 1);
				renderRows();
				status.textContent = `Added ${plant.name}.`;
			}
			renderResults();
			const field = list.querySelector<HTMLInputElement>(`li[data-harvest-id="${CSS.escape(harvestId)}"] input`);
			field?.focus();
			field?.select();
		});

		bindNumericPaste(list);
		renderResults();
	}
</script>
