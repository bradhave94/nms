---
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getSiteOrigin } from '@utils/structuredData.js';
import { SITE } from '@config';
import '@assets/css/calculators.css';

const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL('/calculator/planner/', siteOrigin).toString();
const title = 'Crafting Planner | No Man\'s Sky Recipes';
const description =
	'Plan multiple crafted products at once. Add items and quantities to see total raw materials needed across your entire build list.';
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Crafting Calculator', href: '/calculator' },
	{ name: 'Crafting Planner' },
];
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'@id': `${canonicalUrl}#breadcrumb`,
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Crafting Calculator', item: `${siteOrigin}/calculator/` },
		{ '@type': 'ListItem', position: 3, name: 'Crafting Planner', item: canonicalUrl },
	],
};
const imageBaseUrl = SITE.imageBaseUrl;
---

<Layout
	{title}
	{description}
	slug="calculator"
	structuredData={breadcrumbSchema}
	ogImage={`${SITE.website}/images/calculator.webp`}
>
	<div class="calc">
		<Breadcrumbs items={breadcrumbs} className="pt-2 mb-2 px-0!" />
		<header class="calc-head">
			<h1>Crafting planner</h1>
			<p>Add the products you want to build and get one combined list of raw materials. Share the plan with a link.</p>
		</header>

		<div id="planner-app" class="calc-grid" data-image-base={imageBaseUrl}>
			<section class="panel calc-pad" aria-labelledby="plan-heading">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<h2 id="plan-heading">Your plan</h2>
					<button id="copy-link-btn" type="button" class="btn-quiet" disabled>Copy link</button>
				</div>
				<div class="mt-4">
					<label for="product-search" class="calc-label">Add a product</label>
					<input
						id="product-search"
						type="text"
						autocomplete="off"
						spellcheck="false"
						placeholder="Search products, e.g. Stasis Device"
						aria-controls="product-results"
						class="field"
					/>
					<div id="product-results" class="calc-picker hidden"></div>
					<p id="planner-status" class="sr-only" role="status" aria-live="polite"></p>
				</div>
				<ul id="plan-rows" class="mt-4" aria-label="Products in your plan"></ul>
				<p id="plan-empty" class="calc-empty mt-4">
					No items added yet. Search above to add products (e.g. Stasis Device, Living Glass).
				</p>
			</section>

			<div class="calc-col">
				<section class="panel-amber calc-pad" aria-labelledby="totals-heading">
					<h2 id="totals-heading">Total raw materials<span id="totals-count" class="count tabular"></span></h2>
					<ul id="totals-list" class="mt-3"></ul>
					<p id="totals-empty" class="calc-empty mt-3">
						Add products to your plan to see total raw materials.
					</p>
				</section>

				<section aria-labelledby="breakdown-heading" id="breakdown-panel" class="panel calc-pad hidden">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<h2 id="breakdown-heading">Per-item breakdown</h2>
						<button id="breakdown-toggle" type="button" class="btn-quiet" aria-pressed="false" aria-controls="breakdown-section">
							Show crafting trees
						</button>
					</div>
					<p id="breakdown-hint" class="calc-help">
						Expand to see the full crafting tree for each product in your plan, down to raw resources.
					</p>
					<div id="breakdown-section" class="hidden"></div>
				</section>
			</div>
		</div>
	</div>
</Layout>

<script>
	import { bindNumericPaste, bindResultKeys, itemSlot, removeButton } from '../../scripts/calculatorUi';

	type PlannerItem = {
		id: string;
		name: string;
		icon: string;
		colour?: string;
		quantity: number;
	};

	type PlannerTreeItem = {
		id: string;
		name: string;
		icon: string;
		colour?: string;
		quantity: number;
		url: string;
		children: PlannerTreeItem[];
	};

	type PlannerProduct = {
		id: string;
		name: string;
		icon: string;
		colour?: string;
		url: string;
		recipeTree: PlannerTreeItem[];
		rawItems: PlannerItem[];
	};

	type PlannerApiTreeItem = {
		id?: string;
		name?: string;
		icon?: string;
		colour?: string;
		quantity?: number;
		url?: string;
		children?: PlannerApiTreeItem[];
	};

	type PlannerApiProduct = {
		id?: string;
		name?: string;
		icon?: string;
		colour?: string;
		url?: string;
		recipeTree?: PlannerApiTreeItem[];
		ingredients?: PlannerApiTreeItem[];
		rawItems?: PlannerItem[];
	};

	type PlanEntry = {
		id: string;
		qty: number;
	};

	type MergedItem = PlannerItem;

	const plannerApp = document.getElementById('planner-app');
	const productSearch = document.getElementById('product-search') as HTMLInputElement | null;
	const productResults = document.getElementById('product-results');
	const planRows = document.getElementById('plan-rows');
	const planEmpty = document.getElementById('plan-empty');
	const totalsList = document.getElementById('totals-list');
	const totalsEmpty = document.getElementById('totals-empty');
	const totalsCount = document.getElementById('totals-count');
	const breakdownToggle = document.getElementById('breakdown-toggle') as HTMLButtonElement | null;
	const breakdownPanel = document.getElementById('breakdown-panel');
	const breakdownHint = document.getElementById('breakdown-hint');
	const breakdownSection = document.getElementById('breakdown-section');
	const copyLinkBtn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;

	const imageBaseUrl = plannerApp?.dataset.imageBase ?? '/images/items/';

	let products: PlannerProduct[] = [];
	const productsById = new Map<string, PlannerProduct>();
	let plan: PlanEntry[] = [];
	let searchDebounceTimer: ReturnType<typeof setTimeout> | undefined;
	let urlDebounceTimer: ReturnType<typeof setTimeout> | undefined;
	let datasetPromise: Promise<PlannerProduct[]> | null = null;

	const slot = (item: { icon?: string; colour?: string }, size = 'w-11', quantity?: number) =>
		itemSlot({ icon: item.icon, colour: item.colour, quantity, size, imageBase: imageBaseUrl });
	const showTrees = () => breakdownToggle?.getAttribute('aria-pressed') === 'true';

	function normalizeTreeItem(item: PlannerApiTreeItem): PlannerTreeItem | null {
		if (!item?.id || !item?.name) return null;

		return {
			id: item.id,
			name: item.name,
			icon: item.icon ?? '',
			colour: item.colour,
			quantity: item.quantity ?? 1,
			url: item.url ?? `/item/${item.id}`,
			children: (item.children ?? [])
				.map(normalizeTreeItem)
				.filter((child): child is PlannerTreeItem => child !== null),
		};
	}

	function normalizeProduct(entry: PlannerApiProduct): PlannerProduct | null {
		if (!entry?.id || !entry?.name || !Array.isArray(entry.rawItems)) return null;

		const treeSource = Array.isArray(entry.recipeTree)
			? entry.recipeTree
			: Array.isArray(entry.ingredients)
				? entry.ingredients
				: [];

		return {
			id: entry.id,
			name: entry.name,
			icon: entry.icon ?? '',
			colour: entry.colour,
			url: entry.url ?? `/item/${entry.id}`,
			recipeTree: treeSource
				.map(normalizeTreeItem)
				.filter((item): item is PlannerTreeItem => item !== null),
			rawItems: entry.rawItems.filter((item) => item?.id && item?.name),
		};
	}

	function loadPlannerDataset(): Promise<PlannerProduct[]> {
		if (!datasetPromise) {
			datasetPromise = fetch('/calculator/planner-data.json')
				.then((response) => {
					if (!response.ok) {
						throw new Error(`Planner data request failed (${response.status})`);
					}
					return response.json();
				})
				.then((results) => {
					if (!results || !Array.isArray(results.body)) {
						return [];
					}

					return results.body
						.map((entry: PlannerApiProduct) => normalizeProduct(entry))
						.filter((entry: PlannerProduct | null): entry is PlannerProduct => entry !== null);
				})
				.catch((error) => {
					datasetPromise = null;
					throw error;
				});
		}
		return datasetPromise;
	}

	function parsePlanFromUrl(): PlanEntry[] {
		const itemsParam = new URLSearchParams(window.location.search).get('items');
		if (!itemsParam) return [];

		return itemsParam
			.split(',')
			.map((segment) => {
				const [id, qtyStr] = segment.split(':');
				if (!id) return null;
				const qty = Number.parseInt(qtyStr ?? '1', 10);
				if (!Number.isFinite(qty) || qty < 1) return null;
				return { id, qty };
			})
			.filter((entry): entry is PlanEntry => entry !== null && productsById.has(entry.id));
	}

	function updateUrl() {
		if (urlDebounceTimer) {
			clearTimeout(urlDebounceTimer);
		}
		urlDebounceTimer = setTimeout(() => {
			const params = new URLSearchParams();
			if (plan.length > 0) {
				params.set('items', plan.map((entry) => `${entry.id}:${entry.qty}`).join(','));
			}
			const query = params.toString();
			const newUrl = `/calculator/planner${query ? `?${query}` : ''}`;
			window.history.replaceState({}, '', newUrl);
			if (copyLinkBtn) {
				copyLinkBtn.disabled = plan.length === 0;
			}
		}, 200);
	}

	function mergeRawItems(entries: PlanEntry[]): MergedItem[] {
		const merged = new Map<string, MergedItem>();

		for (const entry of entries) {
			const product = productsById.get(entry.id);
			if (!product) continue;

			for (const rawItem of product.rawItems) {
				const totalQty = rawItem.quantity * entry.qty;
				const existing = merged.get(rawItem.id);
				if (existing) {
					existing.quantity += totalQty;
				} else {
					merged.set(rawItem.id, {
						id: rawItem.id,
						name: rawItem.name,
						icon: rawItem.icon,
						colour: rawItem.colour,
						quantity: totalQty,
					});
				}
			}
		}

		return Array.from(merged.values()).sort((a, b) => b.quantity - a.quantity);
	}

	function createItemRow(item: MergedItem): HTMLLIElement {
		const li = document.createElement('li');
		li.className = 'calc-row';
		li.appendChild(slot(item, 'w-11', item.quantity));

		const nameSpan = document.createElement('span');
		nameSpan.className = 'name';
		nameSpan.textContent = item.name;
		li.appendChild(nameSpan);

		const qtySpan = document.createElement('span');
		qtySpan.className = 'calc-amount';
		qtySpan.textContent = item.quantity.toLocaleString();
		li.appendChild(qtySpan);

		return li;
	}

	function createTreeNodeRow(item: PlannerTreeItem, isLeaf: boolean): HTMLElement {
		const row = document.createElement(isLeaf ? 'a' : 'div');
		row.className = 'node';

		if (isLeaf) {
			(row as HTMLAnchorElement).href = item.url;
		}

		row.appendChild(slot(item, 'w-10', item.quantity));

		const nameSpan = document.createElement('span');
		nameSpan.className = `node-name ${isLeaf ? '' : 'font-medium'}`;
		nameSpan.textContent = item.name;
		row.appendChild(nameSpan);

		const qtySpan = document.createElement('span');
		qtySpan.className = 'sr-only';
		qtySpan.textContent = `, quantity ${item.quantity.toLocaleString()}`;
		row.appendChild(qtySpan);

		return row;
	}

	function appendRecipeTree(container: HTMLElement, items: PlannerTreeItem[], parentQuantity = 1) {
		const list = document.createElement('ul');

		for (const item of items) {
			const displayQuantity = item.quantity * parentQuantity;
			const displayItem = { ...item, quantity: displayQuantity };
			const listItem = document.createElement('li');

			if (item.children.length > 0) {
				listItem.appendChild(createTreeNodeRow(displayItem, false));
				appendRecipeTree(listItem, item.children, displayQuantity);
			} else {
				listItem.appendChild(createTreeNodeRow(displayItem, true));
			}

			list.appendChild(listItem);
		}

		container.appendChild(list);
	}

	function renderTotals() {
		if (!totalsList || !totalsEmpty || !breakdownSection || !breakdownPanel) return;

		totalsList.textContent = '';
		breakdownSection.textContent = '';
		if (totalsCount) totalsCount.textContent = '';

		if (plan.length === 0) {
			totalsEmpty.classList.remove('hidden');
			breakdownPanel.classList.add('hidden');
			breakdownSection.classList.add('hidden');
			if (breakdownHint) {
				breakdownHint.classList.remove('hidden');
			}
			return;
		}

		totalsEmpty.classList.add('hidden');
		breakdownPanel.classList.remove('hidden');
		const merged = mergeRawItems(plan);
		if (totalsCount) totalsCount.textContent = `${merged.length} item${merged.length === 1 ? '' : 's'}`;

		for (const rawItem of merged) {
			totalsList.appendChild(createItemRow(rawItem));
		}

		if (showTrees()) {
			breakdownSection.classList.remove('hidden');
			if (breakdownHint) {
				breakdownHint.classList.add('hidden');
			}

			for (const entry of plan) {
				const product = productsById.get(entry.id);
				if (!product) continue;

				const productBlock = document.createElement('article');
				productBlock.className = 'mt-5 border-t border-line pt-4 first:mt-3 first:border-t-0 first:pt-0';

				const heading = document.createElement('h3');
				heading.className = 'mb-2 flex items-center gap-3';
				heading.appendChild(slot(product, 'w-10'));

				const headingText = document.createElement('span');
				headingText.className = 'tabular';
				headingText.textContent = `${product.name} × ${entry.qty.toLocaleString()}`;
				heading.appendChild(headingText);
				productBlock.appendChild(heading);

				const treeContainer = document.createElement('div');
				treeContainer.className = 'calc-tree calc-tree-root';
				appendRecipeTree(treeContainer, product.recipeTree, entry.qty);
				productBlock.appendChild(treeContainer);
				breakdownSection.appendChild(productBlock);
			}
		} else {
			breakdownSection.classList.add('hidden');
			if (breakdownHint) {
				breakdownHint.classList.remove('hidden');
			}
		}
	}

	function focusPlanQty(productId: string) {
		const qtyInput = planRows?.querySelector(
			`input[data-product-id="${CSS.escape(productId)}"]`
		) as HTMLInputElement | null;
		if (qtyInput) {
			qtyInput.focus();
			qtyInput.select();
		}
	}

	function addToPlan(productId: string) {
		const existing = plan.find((entry) => entry.id === productId);
		if (existing) {
			focusPlanQty(productId);
			return;
		}

		plan.push({ id: productId, qty: 1 });
		renderPlan();
		updateUrl();
		announce(`Added ${productsById.get(productId)?.name ?? 'item'} to your plan.`);
		// The results list closes after a pick; keep focus on the new row instead of losing it.
		focusPlanQty(productId);
	}

	function removeFromPlan(productId: string) {
		const index = plan.findIndex((entry) => entry.id === productId);
		const name = productsById.get(productId)?.name ?? 'item';
		plan = plan.filter((entry) => entry.id !== productId);
		renderPlan();
		updateUrl();
		announce(`Removed ${name} from your plan.`);
		// Focus the next row's remove button (or the search box when the plan is empty).
		const buttons = planRows?.querySelectorAll<HTMLButtonElement>('button[aria-label^="Remove "]');
		const next = buttons?.[Math.min(index, (buttons?.length ?? 1) - 1)];
		(next ?? productSearch)?.focus();
	}

	const plannerStatus = document.getElementById('planner-status');
	function announce(message: string) {
		if (plannerStatus) plannerStatus.textContent = message;
	}

	function setPlanQty(productId: string, qty: number) {
		const entry = plan.find((item) => item.id === productId);
		if (!entry) return;
		entry.qty = Math.max(1, qty);
		renderTotals();
		updateUrl();
	}

	function renderPlan() {
		if (!planRows || !planEmpty) return;

		planRows.textContent = '';

		if (plan.length === 0) {
			planEmpty.classList.remove('hidden');
			renderTotals();
			return;
		}

		planEmpty.classList.add('hidden');

		for (const entry of plan) {
			const product = productsById.get(entry.id);
			if (!product) continue;

			const row = document.createElement('li');
			row.className = 'calc-row';
			row.dataset.productId = product.id;
			row.appendChild(slot(product, 'w-11'));

			const nameLink = document.createElement('a');
			nameLink.href = product.url;
			nameLink.className = 'name name-link';
			nameLink.textContent = product.name;
			row.appendChild(nameLink);

			const qtyInput = document.createElement('input');
			qtyInput.type = 'number';
			qtyInput.min = '1';
			qtyInput.step = '1';
			qtyInput.inputMode = 'numeric';
			qtyInput.value = String(entry.qty);
			qtyInput.id = `qty-${product.id}`;
			qtyInput.dataset.productId = product.id;
			qtyInput.className = 'field w-[4.5rem] sm:w-24 flex-none text-center';
			qtyInput.addEventListener('change', () => {
				const parsed = Number.parseInt(qtyInput.value, 10);
				setPlanQty(product.id, Number.isFinite(parsed) ? parsed : 1);
				qtyInput.value = String(entry.qty);
			});
			qtyInput.addEventListener('input', () => {
				const parsed = Number.parseInt(qtyInput.value, 10);
				if (Number.isFinite(parsed) && parsed >= 1) {
					entry.qty = parsed;
					renderTotals();
				}
			});

			const qtyLabel = document.createElement('label');
			qtyLabel.className = 'sr-only';
			qtyLabel.textContent = `Quantity for ${product.name}`;
			qtyLabel.htmlFor = qtyInput.id;

			row.appendChild(qtyLabel);
			row.appendChild(qtyInput);

			const removeBtn = removeButton(`Remove ${product.name}`);
			removeBtn.addEventListener('click', () => removeFromPlan(product.id));
			row.appendChild(removeBtn);

			planRows.appendChild(row);
		}

		renderTotals();
	}

	function closeResults() {
		if (!productResults) return;
		productResults.classList.add('hidden');
		productResults.textContent = '';
	}

	function renderProductSearch() {
		if (!productSearch || !productResults) return;

		const term = productSearch.value.trim().toLowerCase();
		productResults.textContent = '';

		if (!term) {
			productResults.classList.add('hidden');
			return;
		}

		const matches = products
			.filter((product) => product.name.toLowerCase().includes(term))
			.sort((a, b) => {
				const aName = a.name.toLowerCase();
				const bName = b.name.toLowerCase();
				if (aName === term) return -1;
				if (bName === term) return 1;
				if (aName.startsWith(term) && !bName.startsWith(term)) return -1;
				if (bName.startsWith(term) && !aName.startsWith(term)) return 1;
				return a.name.localeCompare(b.name);
			})
			.slice(0, 50);

		if (matches.length === 0) {
			productResults.classList.remove('hidden');
			const empty = document.createElement('p');
			empty.className = 'calc-empty';
			empty.textContent = 'No matching products found.';
			productResults.appendChild(empty);
			announce('No matching products found.');
			return;
		}

		productResults.classList.remove('hidden');
		announce(`${matches.length} matching product${matches.length === 1 ? '' : 's'}. Press Tab or the down arrow to reach them.`);
		const ul = document.createElement('ul');
		ul.setAttribute('aria-label', 'Matching products');

		for (const product of matches) {
			const li = document.createElement('li');

			const btn = document.createElement('button');
			btn.type = 'button';
			btn.appendChild(slot(product, 'w-9'));

			const nameSpan = document.createElement('span');
			nameSpan.textContent = product.name;
			btn.appendChild(nameSpan);

			const inPlan = plan.some((entry) => entry.id === product.id);
			if (inPlan) {
				const badge = document.createElement('span');
				badge.className = 'meta';
				badge.textContent = 'In plan';
				btn.appendChild(badge);
			}

			btn.addEventListener('click', () => {
				addToPlan(product.id);
				productSearch.value = '';
				closeResults();
			});

			li.appendChild(btn);
			ul.appendChild(li);
		}

		productResults.appendChild(ul);
	}

	async function init() {
		try {
			products = await loadPlannerDataset();
			productsById.clear();
			for (const product of products) {
				productsById.set(product.id, product);
			}

			if (products.length === 0) {
				if (planEmpty) {
					planEmpty.textContent = 'Unable to load product data. Please refresh the page.';
				}
				return;
			}

			plan = parsePlanFromUrl();
			renderPlan();
			updateUrl();
		} catch (error) {
			if (import.meta.env.DEV) {
				console.error('Failed to load planner data:', error);
			}
			if (planEmpty) {
				planEmpty.textContent = 'Unable to load product data. Please refresh the page.';
			}
		}
	}

	if (productSearch) {
		productSearch.addEventListener('input', () => {
			if (searchDebounceTimer) {
				clearTimeout(searchDebounceTimer);
			}
			searchDebounceTimer = setTimeout(renderProductSearch, 200);
		});
		if (productResults) bindResultKeys(productSearch, productResults, closeResults);
	}

	if (planRows) bindNumericPaste(planRows);

	if (breakdownToggle) {
		breakdownToggle.addEventListener('click', () => {
			const next = !showTrees();
			breakdownToggle.setAttribute('aria-pressed', String(next));
			breakdownToggle.textContent = next ? 'Hide crafting trees' : 'Show crafting trees';
			renderTotals();
		});
	}

	if (copyLinkBtn) {
		copyLinkBtn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				const originalText = copyLinkBtn.textContent;
				copyLinkBtn.textContent = 'Copied!';
				announce('Link copied to the clipboard.');
				setTimeout(() => {
					copyLinkBtn.textContent = originalText;
				}, 2000);
			} catch {
				copyLinkBtn.textContent = 'Copy failed';
				announce('Copying the link failed.');
				setTimeout(() => {
					copyLinkBtn.textContent = 'Copy link';
				}, 2000);
			}
		});
	}

	init();
</script>
