---
import Layout from '@layouts/Layout.astro';
import CompactCard from '@components/CompactCard.astro';
import Pagination from '@components/Pagination.astro';
import PageLinks from '@components/PageLinks.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getSlug } from '@utils/lookup.js';
import { buildCollectionStructuredData, getSiteOrigin } from '@utils/structuredData.js';
import { buildCategoryBreadcrumbs, buildCategoryIntro, buildPaginatedMeta, buildPaginationUrls } from '@utils/seo.js';
import type { Item } from '@utils/lookup.js';
import data from '@datav2/Products.json';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';
import { nameSortKey } from '../../integrations/cleanGameNames';
import '../../assets/css/lists.css';

export async function getStaticPaths({ paginate }: { paginate: <T>(data: T[], options: { pageSize: number }) => unknown[] }) {
	/** A–Z by nameSortKey(): leading quotes and punctuation ignored, names starting with a digit last. */
	const compareNames = (a: string, b: string): number => {
		const x = nameSortKey(a);
		const y = nameSortKey(b);
		// the digit marker is '~', which localeCompare would put first
		return Number(x.startsWith('~')) - Number(y.startsWith('~')) || x.localeCompare(y, 'en', { numeric: true });
	};
	const sorted = [...(data as Item[])].sort((a, b) => compareNames(a.Name ?? '', b.Name ?? ''));
	const pages = paginate(sorted, { pageSize: 80 });
	return pages.slice(1);
}
// All paginated data is passed on the "page" prop
interface PageProps {
	page: {
		data: Item[];
		currentPage: number;
		lastPage: number;
		url: {
			prev?: string;
			next?: string;
		};
	};
}
const { page } = Astro.props as PageProps;
const hasRecipe = (item: Item): boolean =>
	'RequiredItems' in item && Array.isArray(item.RequiredItems) && item.RequiredItems.length > 0;
const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, siteOrigin).toString();
const calculatorItems = page.data.filter(hasRecipe);
const itemListElements = calculatorItems.map((item, index) => ({
	name: item.Name,
	url: `${siteOrigin}${getSlug(item)}`,
	position: (page.currentPage - 1) * 80 + index + 1,
}));
const structuredData = buildCollectionStructuredData({
	siteOrigin,
	canonicalUrl,
	collectionName: 'Crafting Calculator',
	collectionDescription: 'A calculator to help your farming efforts by calculating exactly what you need to craft any item.',
	collectionPath: '/calculator',
	currentPage: page.currentPage,
	items: itemListElements,
});
const breadcrumbs = buildCategoryBreadcrumbs('Crafting Calculator', '/calculator', page.currentPage);
const intro = buildCategoryIntro(
	'Pick an item, then set the quantity on its page to see how much of each ingredient you need.',
	page.currentPage,
	page.lastPage
);
const baseDescription = 'A calculator to help your farming efforts by calculating exactly what you need to craft any item.';
const { title, description } = buildPaginatedMeta('Crafting Calculator', baseDescription, page.currentPage, page.lastPage);
const { prevUrl, nextUrl } = buildPaginationUrls(siteOrigin, page);
---

<Layout
	{title}
	{description}
	slug="calculator"
	structuredData={structuredData}
	prevUrl={prevUrl}
	nextUrl={nextUrl}
>
	<div class="list-page">
		<Breadcrumbs items={breadcrumbs} className="pt-2 mb-4 !px-0" />
		<header class="list-head">
			<h1>Crafting Calculator</h1>
			<p class="intro">
				{intro} <a href="/calculator/">Search every craftable product</a>.
			</p>
		</header>
		<div id="items" class="tile-grid">
			{
				calculatorItems.map((item, index) => (
					<CompactCard
						card={{
							name: item.Name,
							image: SITE.imageBaseUrl + toWebp(item.Icon),
							link: getSlug(item),
							colour: item.Colour,
							group: item.Group,
						}}
						index={index}
						loading={index < 20 ? 'eager' : 'lazy'}
					/>
				))
			}
		</div>
		<Pagination page={page} />
		<PageLinks currentPage={page.currentPage} lastPage={page.lastPage} basePath="/calculator" />
	</div>
</Layout>
