---
import Layout from '@layouts/Layout.astro';
import RecipeCards from '@components/table/RecipeCards.astro';
import { cookingRows, sortRows } from '@components/table/recipeRows';

const rows = sortRows(cookingRows(), 'name');
---

<Layout
	title={"Cooking Recipes | No Man's Sky Recipes"}
	description="No Man's Sky Nutrient Processor recipes as cards, with the ingredients and output of each recipe."
	slug="cooking"
	robots="noindex,follow,max-image-preview:large"
	canonical="/cooking/"
>
	<RecipeCards title="Cooking" image="/images/cooker.webp" base="/cooking" kind="cooking" rows={rows}>
		All {rows.length.toLocaleString()} Nutrient Processor recipes as cards. Type an ingredient to see what it cooks into, or a dish to see how to make it.
	</RecipeCards>
</Layout>
