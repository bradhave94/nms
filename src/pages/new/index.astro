---
import Layout from '@layouts/Layout.astro';
import CompactCard from '@components/CompactCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getSlug } from '@utils/lookup.js';
import { buildCollectionStructuredData, getSiteOrigin } from '@utils/structuredData.js';
import { buildCategoryBreadcrumbs } from '@utils/seo.js';
import {
	formatVersionLabel,
	getNewUpdatePayload,
	type NewUpdateItem,
} from '@utils/newUpdate';
import { getRouteEligibleNewItems } from '@utils/routeCatalog.js';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';
import { nameSortKey } from '../../integrations/cleanGameNames';
import { CATEGORY_SLUGS, categories, type CategorySlug } from '../../config/categories.js';
import '../../assets/css/lists.css';

/** A–Z by nameSortKey(): leading quotes and punctuation ignored, names starting with a digit last. */
const compareNames = (a: string, b: string): number => {
	const x = nameSortKey(a);
	const y = nameSortKey(b);
	// the digit marker is '~', which localeCompare would put first
	return Number(x.startsWith('~')) - Number(y.startsWith('~')) || x.localeCompare(y, 'en', { numeric: true });
};

const update = getNewUpdatePayload();
const addedItems = getRouteEligibleNewItems(update.Items)
	.map(({ item }) => item as unknown as NewUpdateItem)
	.sort((a, b) => compareNames(a.Name ?? '', b.Name ?? ''));
const versionLabel = formatVersionLabel(update.VersionKey);
const previousLabel = formatVersionLabel(update.PreviousVersionKey);
const generatedDate = new Date(update.GeneratedAt).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

// The payload can compare a release with itself (7.00 vs 7.00); only name a different previous version.
const showPrevious = Boolean(update.PreviousVersionKey) && previousLabel !== versionLabel;
const updateName = SITE.version_name ? `the ${SITE.version_name} update (${versionLabel})` : `update ${versionLabel}`;

const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL('/new/', siteOrigin).toString();
const itemListElements = addedItems.map((item, index) => ({
	name: item.Name,
	url: `${siteOrigin}${getSlug(item)}`,
	position: index + 1,
}));
const structuredData = buildCollectionStructuredData({
	siteOrigin,
	canonicalUrl,
	collectionName: `New in ${versionLabel}`,
	collectionDescription: `Items introduced in No Man's Sky ${versionLabel} compared to ${previousLabel}.`,
	collectionPath: '/new',
	currentPage: 1,
	items: itemListElements,
});
const breadcrumbs = buildCategoryBreadcrumbs(`New in ${versionLabel}`, '/new', 1);
const title = `New Items in No Man's Sky ${versionLabel} | No Man's Sky Recipes`;
const description = `${addedItems.length} new items introduced in NMS ${versionLabel} (since ${previousLabel}). Browse the latest additions to No Man's Sky.`;

// One section per catalog, in sidebar order; anything else (creatures, ...) after them.
const sectionOf = (item: NewUpdateItem): string => getSlug(item).split('/')[1] ?? 'other';
const sectionLabel = (key: string): string =>
	categories[key as CategorySlug]?.h1 ?? key.charAt(0).toUpperCase() + key.slice(1).replace(/-/g, ' ');
const bySection = new Map<string, NewUpdateItem[]>();
for (const item of addedItems) {
	const key = sectionOf(item);
	bySection.set(key, [...(bySection.get(key) ?? []), item]);
}
const order = (key: string): number => {
	const index = (CATEGORY_SLUGS as readonly string[]).indexOf(key);
	return index === -1 ? CATEGORY_SLUGS.length : index;
};
const sections = [...bySection.entries()]
	.sort(([a], [b]) => order(a) - order(b) || a.localeCompare(b))
	.map(([key, items]) => ({ key, label: sectionLabel(key), items }));

const toCard = (item: NewUpdateItem) => ({
	name: item.Name?.trim() || item.Id,
	group: item.Group,
	subtitle: item.ReleaseVariant ? `Expedition ${item.ReleaseVariant.Expedition} variant` : undefined,
	image: `${SITE.imageBaseUrl}${toWebp(item.Icon)}`,
	link: getSlug(item),
	colour: item.Colour,
});
---

<Layout {title} {description} slug="new" structuredData={structuredData}>
	<div class="list-page">
		<Breadcrumbs items={breadcrumbs} className="pt-2 mb-4 !px-0" />
		<header class="list-head">
			<h1>New in {versionLabel}</h1>
			<p class="intro">
				<span class="tabular">{addedItems.length}</span> items added in {updateName}{showPrevious && `, compared to ${previousLabel}`}.
				Data refreshed {generatedDate}. Changes to existing items are on their own pages.
			</p>
		</header>

		{
			sections.length > 0 && (
				<nav aria-label="Categories on this page" class="mb-2 flex flex-wrap gap-2">
					{sections.map((section) => (
						<a href={`#new-${section.key}`} class="pill hover:border-accent">
							{section.label} <span class="tabular text-dim">{section.items.length}</span>
						</a>
					))}
				</nav>
			)
		}

		{
			sections.map((section, sectionIndex) => (
				<section class="new-section" aria-labelledby={`new-${section.key}`}>
					<h2 class="section-title scroll-mt-6" id={`new-${section.key}`}>
						{section.label} <span class="count tabular">{section.items.length}</span>
					</h2>
					<div class="tile-grid">
						{section.items.map((item, index) => (
							<CompactCard card={toCard(item)} index={index} loading={sectionIndex === 0 && index < 20 ? 'eager' : 'lazy'} />
						))}
					</div>
				</section>
			))
		}
	</div>
</Layout>
