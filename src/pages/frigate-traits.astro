---
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { buildCollectionStructuredData, getSiteOrigin } from '@utils/structuredData.js';
import { withSiteTitle } from '@utils/seo.js';
import { frigateTraits, groupTraits, offeredOn, strengthLabel } from '@utils/referenceData';
import '../assets/css/creatures.css';

const groups = groupTraits();
const negative = frigateTraits.filter((trait) => !trait.Beneficial).length;
const anchor = (stat: string) => `stat-${stat.toLowerCase()}`;

const title = withSiteTitle("Frigate Traits in No Man's Sky: Every Bonus and Flaw");
const description = `All ${frigateTraits.length} No Man's Sky frigate traits: what each one does, how strong it is, and which frigate types can roll it.`;
const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Frigate traits' }];

const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL('/frigate-traits/', siteOrigin).toString();
const structuredData = buildCollectionStructuredData({
	siteOrigin,
	canonicalUrl,
	collectionName: "No Man's Sky frigate traits",
	collectionDescription: description,
	collectionPath: '/frigate-traits',
	currentPage: 1,
	breadcrumbs,
	items: groups.map((group, index) => ({ name: group.heading, url: `${canonicalUrl}#${anchor(group.stat)}`, position: index + 1 })),
});
---

<Layout {title} {description} slug="frigate-traits" {structuredData} {breadcrumbs}>
	<Breadcrumbs items={breadcrumbs} className="max-w-[1180px] pt-3 mb-1 lg:px-8" />
	<div class="cr-wrap">
		<header class="cr-head">
			<div class="min-w-0">
				<h1 class="cr-title">Frigate traits</h1>
				<p class="cr-lead">
					All {frigateTraits.length} traits a frigate can roll, {negative} of them flaws. A frigate's primary trait comes with its type; the others raise or lower one expedition stat.
				</p>
			</div>
		</header>

		<nav class="ft-jump" aria-label="Frigate stats">
			<ul>
				{groups.map((group) => <li><a href={`#${anchor(group.stat)}`}>{group.heading} <span class="tabular">{group.traits.length}</span></a></li>)}
			</ul>
		</nav>

		{groups.map((group) => (
			<section class="cr-section" id={anchor(group.stat)} aria-labelledby={`${anchor(group.stat)}-heading`}>
				<h2 class="section-title" id={`${anchor(group.stat)}-heading`}>
					{group.heading} <span class="count tabular">{group.traits.length}</span>
				</h2>
				<table class="cr-table stack">
					<thead>
						<tr>
							<th scope="col">Trait</th>
							<th scope="col">Effect</th>
							<th scope="col">Strength</th>
							<th scope="col">Rolls on</th>
						</tr>
					</thead>
					<tbody>
						{group.traits.map((trait) => (
							<tr>
								<th scope="row">{trait.Name}</th>
								<td data-label="Effect" class={trait.Beneficial ? 'ft-good' : 'ft-bad'}>{trait.Effect ?? '—'}</td>
								<td data-label="Strength">{strengthLabel(trait.Strength)}</td>
								<td data-label="Rolls on">{offeredOn(trait)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		))}
	</div>
</Layout>

<style>
	.ft-jump ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1.5rem; padding: 0; list-style: none; }
	.ft-jump a { display: inline-flex; gap: .4rem; padding: .3rem .7rem; border: 1px solid var(--color-line-strong); border-radius: 999px; font-size: .875rem; color: var(--color-ink); }
	.ft-jump a span { color: var(--color-dim); }
	.ft-good { color: #86efac; }
	.ft-bad { color: #fda4af; }
</style>
