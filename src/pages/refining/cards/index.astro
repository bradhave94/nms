---
import Layout from '@layouts/Layout.astro';
import RecipeCards from '@components/table/RecipeCards.astro';
import { refiningRows, sortRows } from '@components/table/recipeRows';

const rows = sortRows(refiningRows(), 'name');
---

<Layout
	title={"Refiner recipes | No Man's Sky Recipes"}
	description="No Man's Sky refiner recipes as cards, with the inputs and output of each recipe."
	slug="refining"
	robots="noindex,follow,max-image-preview:large"
	canonical="/refining/"
>
	<RecipeCards title="Refining" image="/images/refiner.webp" base="/refining" kind="refining" rows={rows}>
		All {rows.length.toLocaleString()} refiner recipes as cards. Type an item to see what makes it or what it's used for.
	</RecipeCards>
</Layout>
