---
import Layout from '@layouts/Layout.astro';
import CompactCard from '@components/CompactCard.astro';
import Pagination from '@components/Pagination.astro';
import PageLinks from '@components/PageLinks.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getSlug } from '@utils/lookup.js';
import { buildCollectionStructuredData, getSiteOrigin } from '@utils/structuredData.js';
import { buildCategoryBreadcrumbs, buildCategoryIntro, buildPaginatedMeta, buildPaginationUrls, parseIntroLinks } from '@utils/seo.js';
import type { Item } from '@utils/lookup.js';
import { nameSortKey } from '../../integrations/cleanGameNames';
import { CATEGORY_SLUGS, categories, type CategorySlug } from '../../config/categories.js';
import { getCategoryDataset } from '../../config/categoryData.js';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';
import '../../assets/css/lists.css';

// 80 per page keeps every existing /[category]/[page] URL: a bigger page would drop the last pages.
const PAGE_SIZE = 80;

export async function getStaticPaths({ paginate }: { paginate: <T>(data: T[], options: { pageSize: number; params?: Record<string, string> }) => unknown[] }) {
	/** A–Z by nameSortKey(): leading quotes and punctuation ignored, names starting with a digit last. */
	const compareNames = (a: string, b: string): number => {
		const x = nameSortKey(a);
		const y = nameSortKey(b);
		// the digit marker is '~', which localeCompare would put first
		return Number(x.startsWith('~')) - Number(y.startsWith('~')) || x.localeCompare(y, 'en', { numeric: true });
	};
	return CATEGORY_SLUGS.flatMap((slug) => {
		const config = categories[slug];
		const sorted = [...getCategoryDataset(config.datasets)].sort((a, b) =>
			compareNames(a.Name ?? '', b.Name ?? '')
		);
		const pages = paginate(sorted, {
			pageSize: 80,
			params: { category: slug },
		});
		return pages.slice(1);
	});
}

interface PageProps {
	page: {
		data: Item[];
		currentPage: number;
		lastPage: number;
		url: {
			prev?: string;
			next?: string;
		};
	};
}

const slug = Astro.params.category as CategorySlug;
const config = categories[slug];
const categoryPath = `/${config.slug}`;
const { page } = Astro.props as PageProps;
const baseDescription = config.pageDescription ?? config.description;
const introText = config.pageIntro ?? config.intro;

const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, siteOrigin).toString();
const itemListElements = page.data.map((item, index) => ({
	name: item.Name,
	url: `${siteOrigin}${getSlug(item)}`,
	position: (page.currentPage - 1) * PAGE_SIZE + index + 1,
}));
const structuredData = buildCollectionStructuredData({
	siteOrigin,
	canonicalUrl,
	collectionName: config.h1,
	collectionDescription: baseDescription,
	collectionPath: categoryPath,
	...(config.firstPagePath ? { firstPagePath: config.firstPagePath } : {}),
	currentPage: page.currentPage,
	items: itemListElements,
});
const breadcrumbs = config.firstPagePath
	? buildCategoryBreadcrumbs(config.h1, categoryPath, page.currentPage, config.firstPagePath)
	: buildCategoryBreadcrumbs(config.h1, categoryPath, page.currentPage);
const intro = buildCategoryIntro(introText, page.currentPage, page.lastPage);
const { title, description } = buildPaginatedMeta(
	config.metaTitle,
	baseDescription,
	page.currentPage,
	page.lastPage
);
const { prevUrl, nextUrl } = buildPaginationUrls(siteOrigin, page);
---

<Layout
	{title}
	{description}
	slug={config.slug}
	structuredData={structuredData}
	prevUrl={prevUrl}
	nextUrl={nextUrl}
>
	<div class="list-page">
		<Breadcrumbs items={breadcrumbs} className="pt-2 mb-4 !px-0" />
		<header class="list-head">
			<h1>{config.h1}</h1>
			<p class="intro">
				{parseIntroLinks(intro).map((segment) =>
					segment.href ? <a href={segment.href}>{segment.text}</a> : segment.text
				)}
				{' '}<a href={`${categoryPath}/`}>Search all {config.h1.toLowerCase()}</a>.
			</p>
		</header>
		<div id="items" class="tile-grid">
			{
				page.data.map((item, index) => (
					<CompactCard
						card={{
							name: item.Name,
							image: SITE.imageBaseUrl + toWebp(item.Icon),
							link: getSlug(item),
							colour: item.Colour,
							group: item.Group,
						}}
						index={index}
						loading={index < 20 ? 'eager' : 'lazy'}
					/>
				))
			}
		</div>
		<Pagination page={page} />
		<PageLinks currentPage={page.currentPage} lastPage={page.lastPage} basePath={categoryPath} />
	</div>
</Layout>
