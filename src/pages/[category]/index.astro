---
import Layout from '@layouts/Layout.astro';
import CategoryFilter from '@components/CategoryFilter.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import NitroAd from '@components/ads/NitroAd.astro';
import PageLinks from '@components/PageLinks.astro';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';
import { getSlug } from '@utils/lookup.js';
import type { Item } from '@utils/lookup.js';
import { buildCollectionStructuredData, getSiteOrigin } from '@utils/structuredData.js';
import { buildCategoryBreadcrumbs, buildCategoryIntro, buildPaginatedMeta, buildPaginationUrls, parseIntroLinks } from '@utils/seo.js';
import { nameSortKey } from '../../integrations/cleanGameNames';
import { CATEGORY_SLUGS, categories, type CategorySlug } from '../../config/categories.js';
import { getCategoryDataset } from '../../config/categoryData.js';
import '../../assets/css/lists.css';

/** A–Z by nameSortKey(): leading quotes and punctuation ignored, names starting with a digit last. */
const compareNames = (a: string, b: string): number => {
	const x = nameSortKey(a);
	const y = nameSortKey(b);
	// the digit marker is '~', which localeCompare would put first
	return Number(x.startsWith('~')) - Number(y.startsWith('~')) || x.localeCompare(y, 'en', { numeric: true });
};

export function getStaticPaths() {
	return CATEGORY_SLUGS.map((slug) => ({ params: { category: slug } }));
}

/** A–Z, ignoring leading quotes and punctuation; names starting with a digit go last. */
const sortByName = (items: Item[]): Item[] =>
	[...items].sort((a, b) => compareNames(a.Name ?? '', b.Name ?? ''));

const slug = Astro.params.category as CategorySlug;
const config = categories[slug];
const categoryPath = `/${config.slug}`;

// Must match the page size in [page].astro: the /[category]/[page] URLs depend on it.
const pageSize = 80;
const sortedItems = sortByName(getCategoryDataset(config.datasets));
const pageData = sortedItems.slice(0, pageSize);
const lastPage = Math.max(1, Math.ceil(sortedItems.length / pageSize));
const page = {
	data: pageData,
	currentPage: 1,
	lastPage,
	url: {
		next: lastPage > 1 ? `${categoryPath}/2` : undefined,
	},
};

const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL(`${categoryPath}/`, siteOrigin).toString();
const itemListElements = page.data.map((item, index) => ({
	name: item.Name,
	url: `${siteOrigin}${getSlug(item)}`,
	position: index + 1,
}));
const structuredData = buildCollectionStructuredData({
	siteOrigin,
	canonicalUrl,
	collectionName: config.h1,
	collectionDescription: config.description,
	collectionPath: categoryPath,
	...(config.firstPagePath ? { firstPagePath: config.firstPagePath } : {}),
	currentPage: page.currentPage,
	items: itemListElements,
});
const breadcrumbs = config.firstPagePath
	? buildCategoryBreadcrumbs(config.h1, categoryPath, page.currentPage, config.firstPagePath)
	: buildCategoryBreadcrumbs(config.h1, categoryPath, page.currentPage);
const intro = buildCategoryIntro(config.intro, page.currentPage, page.lastPage);
const { title, description } = buildPaginatedMeta(
	config.metaTitle,
	config.description,
	page.currentPage,
	page.lastPage
);
const { nextUrl } = buildPaginationUrls(siteOrigin, page);
const filterItems = sortedItems.map((item) => ({
	name: item.Name,
	group: item.Group,
	icon: toWebp(item.Icon),
	link: getSlug(item),
	colour: item.Colour,
	value: item.BaseValueUnits,
}));
---

<Layout
	{title}
	{description}
	slug={config.slug}
	structuredData={structuredData}
	nextUrl={nextUrl}
>
	<div class="list-page">
		<Breadcrumbs items={breadcrumbs} className="pt-2 mb-4 !px-0" />
		<header class="list-head">
			<h1>{config.h1}</h1>
			<p class="intro">
				{parseIntroLinks(intro).map((segment) =>
					segment.href ? <a href={segment.href}>{segment.text}</a> : segment.text
				)}
			</p>
		</header>
		<CategoryFilter
			id={config.slug}
			basePath={categoryPath}
			items={filterItems}
			imageBase={SITE.imageBaseUrl}
			initialCount={pageSize}
			searchLabel={`Search ${config.h1.toLowerCase()}`}
		>
			<NitroAd slot="ad" id="list-after-intro" />
		</CategoryFilter>
		<PageLinks currentPage={1} lastPage={page.lastPage} basePath={categoryPath} />
	</div>
</Layout>
