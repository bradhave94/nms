---
import Layout from '@layouts/Layout.astro';
import RecipeCards from '@components/table/RecipeCards.astro';
import { craftingRows, sortRows } from '@components/table/recipeRows';

const rows = sortRows(craftingRows(), 'value');
---

<Layout
	title={"Crafting Guide | No Man's Sky Recipes"}
	description="No Man's Sky crafting recipes as cards, with the components each item needs."
	slug="crafting-guide"
	robots="noindex,follow,max-image-preview:large"
	canonical="/crafting-guide/"
>
	<RecipeCards title="Crafting" image="/images/crafting.webp" base="/crafting-guide" kind="crafting" rows={rows}>
		All {rows.length.toLocaleString()} crafted products as cards, most valuable first.
	</RecipeCards>
</Layout>
