---
import Layout from '@layouts/Layout.astro';
import CreaturesShell from '@components/creatures/CreaturesShell.astro';
import SpeciesTable from '@components/creatures/SpeciesTable.astro';
import { counts } from '@components/creatures/data';
import { buildCollectionStructuredData, getSiteOrigin } from '@utils/structuredData.js';
import { buildCategoryBreadcrumbs } from '@utils/seo.js';

// The hub's sections, in nav order (also the CollectionPage item list).
const sections = [
	{ name: 'Species', link: '/creatures/species/' },
	{ name: 'Affinities', link: '/creatures/affinities/' },
	{ name: 'Moves', link: '/creatures/moves/' },
	{ name: 'Arena', link: '/creatures/arena/' },
	{ name: 'Companions', link: '/creatures/companions/' },
];

const title = "Creatures | No Man's Sky Recipes";
const description =
	"Explore No Man's Sky creature species, affinity relationships, and move families from the Xeno Arena system.";
const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL('/creatures/', siteOrigin).toString();
const structuredData = buildCollectionStructuredData({
	siteOrigin,
	canonicalUrl,
	collectionName: 'Creatures',
	collectionDescription: description,
	collectionPath: '/creatures',
	currentPage: 1,
	items: sections.map((section, index) => ({
		name: section.name,
		url: `${siteOrigin}${section.link}`,
		position: index + 1,
	})),
});
const breadcrumbs = buildCategoryBreadcrumbs('Creatures', '/creatures', 1);
---

<Layout title={title} description={description} slug="creatures" structuredData={structuredData}>
	<CreaturesShell
		active="hub"
		title="Creatures"
		lead={`${counts.species} species from the game files, ${counts.battleReady} of them battle-ready in the Xeno Arena.`}
		breadcrumbs={breadcrumbs}
	>
		<section aria-labelledby="species-heading">
			<h2 id="species-heading" class="section-title">Species</h2>
			<SpeciesTable />
		</section>
	</CreaturesShell>
</Layout>
