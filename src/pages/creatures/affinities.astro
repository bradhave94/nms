---
import Layout from '@layouts/Layout.astro';
import CreaturesShell from '@components/creatures/CreaturesShell.astro';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';
import { AFFINITY_COLOURS, MATCHUPS, affinityById, speciesRows } from '@components/creatures/data';

const IMAGE_BASE = SITE.imageBaseUrl;
const rows = speciesRows();

const displayNameFor = (affinityId: string): string => affinityById.get(affinityId)?.DisplayName ?? affinityId;
const iconFor = (affinityId: string): string | null => affinityById.get(affinityId)?.Icon ?? null;
const speciesFilterUrl = (affinityId: string): string =>
	`/creatures/species/?affinity=${encodeURIComponent(displayNameFor(affinityId))}`;
const speciesCount = (affinityId: string): number =>
	rows.filter((r) => r.affinity === displayNameFor(affinityId)).length;

const title = "Creature Affinities | No Man's Sky Recipes";
const description =
	"See the eight Xeno Arena creature affinities and the Holo-Arena attack and defense matchup chart.";
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Creatures', href: '/creatures' },
	{ name: 'Affinities' },
];
---

<Layout title={title} description={description} slug="creatures" {breadcrumbs}>
	<CreaturesShell
		active="affinities"
		title="Affinities"
		lead={`Arena battles turn on affinity. Each of the ${MATCHUPS.length} affinities hits one affinity hard and one weakly, and takes extra damage from one and less from another, so pick a companion that counters your opponent.`}
		breadcrumbs={breadcrumbs}
	>
		<section class="cr-section" aria-labelledby="matchups-heading">
			<h2 id="matchups-heading" class="section-title">Matchup chart</h2>
			<table class="cr-table stack af-table">
				<thead>
					<tr>
						<th scope="col">Affinity</th>
						<th scope="col">Attack strong vs</th>
						<th scope="col">Attack weak vs</th>
						<th scope="col">Defense strong vs</th>
						<th scope="col">Defense weak vs</th>
						<th scope="col" class="num">Species</th>
					</tr>
				</thead>
				<tbody>
					{
						MATCHUPS.map((row) => {
							const icon = iconFor(row.affinityId);
							const n = speciesCount(row.affinityId);
							return (
								<tr>
									<th scope="row">
										<a class="af-name" href={speciesFilterUrl(row.affinityId)}>
											<span class="slot" style={`--c:#${AFFINITY_COLOURS[displayNameFor(row.affinityId)] ?? '333333'}`}>
												{icon && <img src={`${IMAGE_BASE}${toWebp(icon)}`} alt="" width="40" height="40" loading="lazy" />}
											</span>
											{displayNameFor(row.affinityId)}
										</a>
									</th>
									<td data-label="Attack strong vs">
										<a class="af-link" href={speciesFilterUrl(row.attackStrongId)}>
											{iconFor(row.attackStrongId) && <img src={`${IMAGE_BASE}${toWebp(iconFor(row.attackStrongId) as string)}`} alt="" width="24" height="24" loading="lazy" />}
											{displayNameFor(row.attackStrongId)}
										</a>
									</td>
									<td data-label="Attack weak vs">
										<a class="af-link" href={speciesFilterUrl(row.attackWeakId)}>
											{iconFor(row.attackWeakId) && <img src={`${IMAGE_BASE}${toWebp(iconFor(row.attackWeakId) as string)}`} alt="" width="24" height="24" loading="lazy" />}
											{displayNameFor(row.attackWeakId)}
										</a>
									</td>
									<td data-label="Defense strong vs">
										<a class="af-link" href={speciesFilterUrl(row.defenseStrongId)}>
											{iconFor(row.defenseStrongId) && <img src={`${IMAGE_BASE}${toWebp(iconFor(row.defenseStrongId) as string)}`} alt="" width="24" height="24" loading="lazy" />}
											{displayNameFor(row.defenseStrongId)}
										</a>
									</td>
									<td data-label="Defense weak vs">
										<a class="af-link" href={speciesFilterUrl(row.defenseWeakId)}>
											{iconFor(row.defenseWeakId) && <img src={`${IMAGE_BASE}${toWebp(iconFor(row.defenseWeakId) as string)}`} alt="" width="24" height="24" loading="lazy" />}
											{displayNameFor(row.defenseWeakId)}
										</a>
									</td>
									<td data-label="Species" class="num">
										<a class="link" href={speciesFilterUrl(row.affinityId)}>
											{n}<span class="sr-only"> {displayNameFor(row.affinityId)} species</span>
										</a>
									</td>
								</tr>
							);
						})
					}
				</tbody>
			</table>
			<p class="cr-note mt-4">
				Attack is the damage a creature deals: extra against its strong affinity, reduced against its weak one.
				Defense is the damage it takes: reduced from its strong affinity, extra from its weak one. The game shows
				both on each creature's Attack Profile and Defenses panels. Strong attacks run in one loop: Mechanical,
				Desert, Toxic, Tropical, Anomalous, Radioactive, Fire, Frost, then back to Mechanical.
			</p>
			<p class="cr-note mt-2">
				Each affinity links to the <a class="link" href="/creatures/species/">species table</a>, filtered to creatures
				with that affinity.
			</p>
		</section>
	</CreaturesShell>
</Layout>

<style>
	.af-table td, .af-table th { vertical-align: middle; }
	.af-name { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; font-weight: 600; color: var(--color-ink); text-decoration: underline; text-decoration-color: rgb(255 195 86 / .45); text-underline-offset: 3px; }
	.af-name:hover { color: var(--color-accent); }
	.af-name .slot { width: 2.75rem; }
	.af-link { display: inline-flex; align-items: center; gap: .45rem; min-height: 32px; color: var(--color-ink); text-decoration: underline; text-decoration-color: rgb(159 176 195 / .5); text-underline-offset: 3px; }
	.af-link:hover { color: var(--color-accent); }
</style>
