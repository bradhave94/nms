---
import Layout from '@layouts/Layout.astro';
import CreaturesShell from '@components/creatures/CreaturesShell.astro';
import creaturesData from '@datav2/Creatures.json';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';

type CreatureAffinity = {
	Id: string;
	DisplayName?: string | null;
	Icon?: string | null;
};

type CreatureMove = {
	Id: string;
	Name?: string | null;
	DefaultDisplayName?: string | null;
	NamesByAffinity?: Record<string, string> | null;
	NameStub?: string | null;
	Description?: string | null;
	EffectDescription?: string | null;
	Target?: string | null;
	AffinityRaw?: string | null;
	Affinity?: string | null;
	AffinityDisplay?: string | null;
	Category?: string | null;
	CategoryIcon?: string | null;
};

type MoveSetOption = {
	Template?: string | null;
	Weighting?: number | null;
	CooldownMin?: number | null;
	CooldownMax?: number | null;
};

type MoveSetSlot = {
	Slot?: string | null;
	Options?: MoveSetOption[] | null;
};

type CreatureMoveSet = {
	Id: string;
	Name?: string | null;
	Slots?: MoveSetSlot[] | null;
};

type MoveFamilyVariant = {
	id: string;
	label: string;
	affinityLabel: string;
	affinityIcon: string | null;
	targetLabel: string;
	weightHint: string;
	description: string | null;
	namesByAffinity: Record<string, string> | null;
};

type MoveFamily = {
	key: string;
	name: string;
	category: string;
	categoryIcon: string | null;
	description: string | null;
	variants: MoveFamilyVariant[];
	variantDescGroups: { desc: string; affinities: string[] }[];
};

const IMAGE_BASE = SITE.imageBaseUrl;
const battleMoves =
	((creaturesData as Record<string, unknown>).BattleMoves as CreatureMove[] | undefined) ?? [];
const moveSets = ((creaturesData as Record<string, unknown>).MoveSets as CreatureMoveSet[] | undefined) ?? [];
const affinities =
	((creaturesData as Record<string, unknown>).Affinities as CreatureAffinity[] | undefined) ?? [];

const affinityById = new Map<string, CreatureAffinity>(
	affinities
		.filter((affinity) => Boolean(affinity?.Id))
		.map((affinity) => [affinity.Id, affinity] as const)
);
const moveById = new Map<string, CreatureMove>(
	battleMoves.filter((move) => Boolean(move?.Id)).map((move) => [move.Id, move] as const)
);

const toTitleCase = (value: string): string =>
	value
		.replace(/[_-]+/g, ' ')
		.trim()
		.split(/\s+/)
		.map((word) => {
			const lower = word.toLowerCase();
			if (!lower) return word;
			if (lower === 'pvp') return 'PvP';
			if (lower === 'pve') return 'PvE';
			return lower.charAt(0).toUpperCase() + lower.slice(1);
		})
		.join(' ');

const slugify = (value: string): string =>
	value
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');

const affinityLabelFor = (affinityIdOrMode: string | null | undefined): string => {
	if (!affinityIdOrMode || affinityIdOrMode === 'Normal') return 'None';
	if (affinityIdOrMode === 'UsePetAffinity') return 'Matches Species Affinity';
	return affinityById.get(affinityIdOrMode)?.DisplayName ?? toTitleCase(affinityIdOrMode);
};

const affinityIconFor = (affinityIdOrMode: string | null | undefined): string | null => {
	if (!affinityIdOrMode || affinityIdOrMode === 'Normal' || affinityIdOrMode === 'UsePetAffinity') return null;
	return affinityById.get(affinityIdOrMode)?.Icon ?? null;
};

const moveLabelFor = (move: CreatureMove): string => {
	const namesByAffinity = move.NamesByAffinity;
	if (namesByAffinity && typeof namesByAffinity === 'object') {
		if (move.Affinity && namesByAffinity[move.Affinity]) return String(namesByAffinity[move.Affinity]);
		if (namesByAffinity.Normal) return String(namesByAffinity.Normal);
		const firstKnown = Object.values(namesByAffinity).find((entry) => Boolean(entry));
		if (firstKnown) return String(firstKnown);
	}
	return move.DefaultDisplayName ?? move.Name ?? move.NameStub ?? move.Id;
};

const familyMap = new Map<string, MoveFamily>();

for (const move of battleMoves) {
	if (!move?.Id) continue;
	const familyKey = move.NameStub ?? move.Id;
	const category = move.Category ?? 'Uncategorized';
	const familyName = move.DefaultDisplayName ?? move.Name ?? toTitleCase(familyKey);
	const affinityMode = move.Affinity ?? move.AffinityRaw ?? 'Normal';
	const variant: MoveFamilyVariant = {
		id: move.Id,
		label: moveLabelFor(move),
		affinityLabel: affinityLabelFor(affinityMode),
		affinityIcon: affinityIconFor(affinityMode),
		targetLabel: move.Target === 'Self' ? 'Self' : 'Enemy',
		weightHint: move.AffinityRaw === 'UsePetAffinity' ? 'Scales to species affinity' : 'Fixed template',
		description: move.EffectDescription ?? move.Description ?? null,
		namesByAffinity: move.NamesByAffinity && typeof move.NamesByAffinity === 'object' ? move.NamesByAffinity : null,
	};
	const existing = familyMap.get(familyKey);
	if (!existing) {
		familyMap.set(familyKey, {
			key: familyKey,
			name: familyName,
			category,
			categoryIcon: move.CategoryIcon ?? null,
			description: move.EffectDescription ?? move.Description ?? null,
			variants: [variant],
			variantDescGroups: [],
		});
		continue;
	}
	if (!existing.description && (move.EffectDescription || move.Description)) {
		existing.description = move.EffectDescription ?? move.Description!;
	}
	existing.variants.push(variant);
}

const familyList = Array.from(familyMap.values())
	.map((family) => {
		const sorted = family.variants
			.slice()
			.sort((a, b) => a.affinityLabel.localeCompare(b.affinityLabel) || a.label.localeCompare(b.label));
		const groupMap = new Map<string, string[]>();
		for (const v of sorted) {
			const desc = v.description ?? 'No description';
			if (!groupMap.has(desc)) groupMap.set(desc, []);
			if (v.affinityLabel !== 'None') groupMap.get(desc)!.push(v.affinityLabel);
		}
		return {
			...family,
			variants: sorted,
			variantDescGroups: [...groupMap.entries()].map(([desc, affs]) => ({ desc, affinities: affs })),
		};
	})
	.sort((a, b) => a.category.localeCompare(b.category) || a.name.localeCompare(b.name));

const categoryList = Array.from(new Set(familyList.map((family) => family.category)));
const familiesByCategory = new Map<string, MoveFamily[]>(
	categoryList.map((category) => [
		category,
		familyList.filter((family) => family.category === category),
	])
);

const moveSetCards = moveSets
	.filter((moveSet) => Boolean(moveSet?.Id))
	.map((moveSet) => {
		const slots = (moveSet.Slots ?? []).map((slot, slotIdx) => {
			const options = (slot.Options ?? [])
				.filter((option) => Boolean(option?.Template))
				.map((option) => {
					const templateId = option.Template as string;
					const move = moveById.get(templateId);
					const label = move ? moveLabelFor(move) : toTitleCase(templateId);
					const description = move?.EffectDescription ?? move?.Description ?? null;
					const category = move?.Category ?? null;
					const categoryIcon = move?.CategoryIcon ?? null;
					const affinityRaw = move?.Affinity ?? move?.AffinityRaw ?? null;
					const affinity = affinityRaw ? affinityLabelFor(affinityRaw) : null;
					const affinityIcon = affinityRaw ? affinityIconFor(affinityRaw) : null;
					const cooldownMin = option.CooldownMin ?? 0;
					const cooldownMax = option.CooldownMax ?? 0;
					const cooldownLabel =
						cooldownMin === 0 && cooldownMax === 0 ? 'None' :
						cooldownMin === cooldownMax ? `${cooldownMin} turn${cooldownMin === 1 ? '' : 's'}` :
						`${cooldownMin}-${cooldownMax} turns`;
					return {
						templateId,
						label,
						description,
						category,
						categoryIcon,
						affinity,
						affinityIcon,
						weighting: option.Weighting ?? 0,
						cooldownLabel,
					};
				})
				.sort((a, b) => b.weighting - a.weighting);
			return {
				slotName: `Slot ${slotIdx + 1}`,
				options,
			};
		});
		const templateCount = slots.reduce((sum, slot) => sum + slot.options.length, 0);
		return {
			id: moveSet.Id,
			name: moveSet.Name ?? toTitleCase(moveSet.Id),
			slotCount: slots.length,
			templateCount,
			slots,
		};
	})
	.sort((a, b) => a.name.localeCompare(b.name));

const title = "Creature Moves | No Man's Sky Recipes";
const description =
	"Explore Xeno Arena battle moves by move family, affinity variants, and move-set archetypes.";
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Creatures', href: '/creatures' },
	{ name: 'Moves' },
];
const totalMoves = battleMoves.filter((move) => Boolean(move?.Id)).length;

---

<Layout title={title} description={description} slug="creatures" {breadcrumbs}>
	<CreaturesShell
		active="moves"
		title="Battle moves"
		lead={`${totalMoves} move templates in ${familyList.length} families, and the ${moveSetCards.length} move sets species draw them from. Pick an affinity to see what each attack is called for it.`}
		breadcrumbs={breadcrumbs}
	>
		<div class="mv-tools">
			<div class="sp-affs" id="affinity-filter" role="group" aria-label="Show move names for affinity">
				<button type="button" class="btn-quiet aff-btn" aria-pressed="true" data-filter="all">All</button>
				{affinities.map((a) => (
					<button type="button" class="btn-quiet aff-btn" aria-pressed="false" data-filter={a.Id}>
						{a.Icon && <img src={`${IMAGE_BASE}${toWebp(a.Icon)}`} alt="" width="22" height="22" loading="lazy" />}
						{a.DisplayName ?? a.Id}
					</button>
				))}
			</div>
			<nav aria-label="Move categories">
				<ul class="cr-jump">
					{categoryList.map((category) => (
						<li>
							<a href={`#category-${slugify(category)}`}>
								{toTitleCase(category)}<span class="ml-1.5 text-dim tabular">{familiesByCategory.get(category)?.length ?? 0}</span>
							</a>
						</li>
					))}
					<li><a href="#move-sets">Move sets<span class="ml-1.5 text-dim tabular">{moveSetCards.length}</span></a></li>
				</ul>
			</nav>
		</div>

		{categoryList.map((category) => (
			<section class="cr-section" id={`category-${slugify(category)}`} aria-labelledby={`h-${slugify(category)}`}>
				<h2 class="section-title" id={`h-${slugify(category)}`}>
					{toTitleCase(category)} moves <span class="count tabular">{familiesByCategory.get(category)?.length ?? 0}</span>
				</h2>
				<div class="cr-grid c2">
					{(familiesByCategory.get(category) ?? []).map((family) => {
						const familyNamesMap = family.variants[0]?.namesByAffinity;
						const hasAffinityNames = familyNamesMap && Object.keys(familyNamesMap).length > 1;
						return (
							<article class="panel cr-card variant-card" data-default-label={family.name} data-aff-labels={hasAffinityNames ? JSON.stringify(familyNamesMap) : undefined}>
								<div class="mv-head">
									{family.categoryIcon && (
										<img src={`${IMAGE_BASE}${toWebp(family.categoryIcon)}`} alt="" width="36" height="36" loading="lazy" />
									)}
									<div class="min-w-0">
										<h3 data-move-name>{family.name}</h3>
										<p class="mv-meta">
											{toTitleCase(family.category)} · targets {(family.variants[0]?.targetLabel ?? 'Enemy').toLowerCase()} · {family.variants.length === 1 ? '1 variant' : `${family.variants.length} variants`}
										</p>
									</div>
								</div>
								{family.variantDescGroups.length > 1 ? (
									<ul class="mv-descs">
										{family.variantDescGroups.map((group) => (
											<li>
												{group.desc}
												{group.affinities.length > 0 && group.affinities[0] !== 'None' && (
													<span class="text-dim"> ({group.affinities.join(', ')})</span>
												)}
											</li>
										))}
									</ul>
								) : (
									family.description && <p class="mt-2">{family.description}</p>
								)}
								{hasAffinityNames && (
									<div class="mt-3" data-affinity-names>
										<ul class="cr-chips" data-affinity-all aria-label="Name by affinity">
											{Object.entries(familyNamesMap!).map(([affId, affName]) => {
												const aff = affinityById.get(affId);
												return (
													<li class="cr-chip" data-aff={affId}>
														{aff?.Icon ? (
															<img src={`${IMAGE_BASE}${toWebp(aff.Icon)}`} alt={aff.DisplayName ?? affId} width="20" height="20" loading="lazy" />
														) : (
															<span class="text-dim">{affId === 'Normal' ? 'Physical:' : `${affId}:`}</span>
														)}
														{String(affName)}
													</li>
												);
											})}
										</ul>
										<p class="mv-single" hidden data-affinity-single />
									</div>
								)}
							</article>
						);
					})}
				</div>
			</section>
		))}

		<section class="cr-section" id="move-sets" aria-labelledby="move-sets-heading">
			<h2 class="section-title" id="move-sets-heading">Move sets <span class="count tabular">{moveSetCards.length}</span></h2>
			<p>
				A move set decides which moves a species can learn. Each slot picks one move from a weighted pool: the
				higher the weight, the more often it is chosen.
			</p>
			{moveSetCards.map((moveSet, i) => (
				<details class="cr-details" open={i === 0}>
					<summary>
						<h3 class="m-0 text-[1.0625rem] font-semibold">{moveSet.name}</h3>
						<span class="cr-sum-meta tabular">{moveSet.slotCount} slots · {moveSet.templateCount} move options</span>
					</summary>
					<div class="cr-details-body cr-grid c2">
						{moveSet.slots.map((slot) => (
							<div>
								<h4 class="mv-slot">{slot.slotName}</h4>
								<table class="cr-table stack">
									<thead>
										<tr>
											<th scope="col">Move</th>
											<th scope="col" class="num">Weight</th>
											<th scope="col" class="num">Cooldown</th>
										</tr>
									</thead>
									<tbody>
										{slot.options.map((option) => (
											<tr>
												<th scope="row">
													<span class="mv-opt">
														{(option.affinityIcon ?? option.categoryIcon) && (
															<img src={`${IMAGE_BASE}${toWebp(option.affinityIcon ?? option.categoryIcon)}`} alt="" width="22" height="22" loading="lazy" />
														)}
														<span>
															{option.label}
															<span class="mv-opt-meta">
																{[option.category && toTitleCase(option.category), option.affinity].filter(Boolean).join(' · ')}
															</span>
														</span>
													</span>
												</th>
												<td data-label="Weight" class="num">{option.weighting}</td>
												<td data-label="Cooldown" class="num">{option.cooldownLabel}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						))}
					</div>
				</details>
			))}
		</section>
	</CreaturesShell>

	<script>
		const filterBar = document.getElementById('affinity-filter');
		if (filterBar) {
			const buttons = filterBar.querySelectorAll<HTMLButtonElement>('.aff-btn');
			const cards = document.querySelectorAll<HTMLElement>('.variant-card');

			const applyFilter = (affinity: string) => {
				cards.forEach((card) => {
					const nameEl = card.querySelector<HTMLElement>('[data-move-name]');
					const allGrid = card.querySelector<HTMLElement>('[data-affinity-all]');
					const singleEl = card.querySelector<HTMLElement>('[data-affinity-single]');
					const raw = card.dataset.affLabels;
					if (!raw || !nameEl) return;
					let labels: Record<string, string>;
					try {
						labels = JSON.parse(raw);
					} catch {
						return;
					}
					const matched = affinity === 'all' ? '' : labels[affinity];
					nameEl.textContent = matched || card.dataset.defaultLabel || nameEl.textContent;
					if (allGrid) allGrid.hidden = Boolean(matched);
					if (singleEl) {
						singleEl.hidden = !matched;
						singleEl.textContent = matched ? `Shown as ${matched} for this affinity.` : '';
					}
				});
			};

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
					applyFilter(btn.dataset.filter ?? 'all');
				});
			});
		}
	</script>
</Layout>

<style>
	.mv-tools { margin-bottom: .5rem; }
	.mv-tools .sp-affs { margin-bottom: .9rem; }
	.mv-head { display: flex; align-items: flex-start; gap: .7rem; }
	.mv-head img { flex: none; margin-top: .1rem; }
	.mv-head h3 { margin: 0; font-size: 1.15rem; font-weight: 600; }
	.mv-meta { margin: .1rem 0 0 !important; font-size: .875rem !important; color: var(--color-dim) !important; }
	.mv-descs { margin: .6rem 0 0; padding-left: 1.1rem; font-size: .9375rem; color: #cfd9e4; }
	.mv-descs li + li { margin-top: .2rem; }
	.mv-single { margin-top: .4rem !important; font-weight: 500; color: var(--color-ink) !important; }
	.mv-slot { margin: 0 0 .4rem; font-size: 1rem; font-weight: 600; color: var(--color-dim); }
	.mv-opt { display: inline-flex; align-items: flex-start; gap: .5rem; }
	.mv-opt img { flex: none; margin-top: .1rem; }
	.mv-opt-meta { display: block; font-size: .8125rem; font-weight: 400; color: var(--color-dim); }
	@media (max-width: 639px) {
		.mv-tools .sp-affs { flex-wrap: nowrap; overflow-x: auto; margin-inline: -1rem; padding: 0 1rem 4px; scrollbar-width: none; }
		.mv-tools .sp-affs .btn-quiet { flex: none; }
	}
</style>
