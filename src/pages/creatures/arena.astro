---
import Layout from '@layouts/Layout.astro';
import CreaturesShell from '@components/creatures/CreaturesShell.astro';
import creaturesData from '@datav2/Creatures.json';
import { getById, getSlug } from '@utils/lookup.js';
import { SITE } from '@config';
import { toWebp } from '@utils/icons';

type ArenaMode = {
	Id: string;
	Name: string;
	Description?: string | null;
	Difficulty?: string | null;
	GameMode: string;
	RewardWin: string | null;
	RewardLoss: string | null;
	ExperienceMultiplier: number;
};

type LeagueLevel = {
	LevelName: string;
	Threshold: number;
};

type ArenaLeague = {
	Id: string;
	StatTitle: string;
	Levels: LeagueLevel[];
	MedalName?: string | null;
	MedalDescription?: string | null;
	WikiName?: string | null;
	WikiDescription?: string | null;
};

type RewardItem = {
	Type: string;
	Id?: string | null;
	ProductId?: string | null;
	StatId?: string | null;
	AmountMin?: number;
	AmountMax?: number;
	Amount?: number;
	Chance: number;
};

type ArenaReward = {
	Id: string;
	RewardChoice: string;
	IncrementStat: string | null;
	Items: RewardItem[];
};

type PetShopItem = {
	Id: string;
	ProductID: string;
	Icon: string;
	Name: string;
	Group: string;
	Description: string;
	IconPath: string;
	LinkedRewardID: string;
	RequiredStat: string;
	RequiredStatTier: number;
	Price: number;
};

const data = creaturesData as Record<string, unknown>;
const IMAGE_BASE = SITE.imageBaseUrl;

const globals = (data.CreatureGlobals as Record<string, unknown>) ?? {};
const arenaGuild = globals.ArenaGuild as { Name?: string; Description?: string } | undefined;
const battleUI = globals.BattleUI as Record<string, string> | undefined;
const holoArenaHeader = (battleUI?.MAIN_HEADER ?? 'Creature battles')
	.toLowerCase()
	.replace(/(^|[\s-])\w/g, (m) => m.toUpperCase());

const arenaModes = (data.ArenaModes as ArenaMode[] | undefined) ?? [];
const arenaLeagues = (data.ArenaLeague as ArenaLeague[] | undefined) ?? [];
const arenaRewards = (data.ArenaRewards as ArenaReward[] | undefined) ?? [];
const petShop = (data.PetShop as PetShopItem[] | undefined) ?? [];

const rewardById = new Map<string, ArenaReward>(
	arenaRewards.filter((r) => Boolean(r?.Id)).map((r) => [r.Id, r] as const),
);
const leagueById = new Map<string, ArenaLeague>(
	arenaLeagues.filter((l) => Boolean(l?.Id)).map((l) => [l.Id, l] as const),
);


const toTitleCase = (value: string): string =>
	value
		.replace(/[_-]+/g, ' ')
		.trim()
		.split(/\s+/)
		.map((word) => {
			const lower = word.toLowerCase();
			if (!lower) return word;
			if (lower === 'pvp') return 'PvP';
			if (lower === 'pve') return 'PvE';
			return lower.charAt(0).toUpperCase() + lower.slice(1);
		})
		.join(' ');

const _PRODUCT_NAMES: Record<string, string> = {
	CHART_PB_CHALNX: "Champion's Invitation",
	CHART_PB_CHALL: "Challenger's Invitation",
	TREAT_FREELEVEL: 'Retroviral Pellet',
};

function rewardItemParts(item: RewardItem): { label: string; href?: string; chanceSuffix?: string } {
	const chanceSuffix = item.Chance < 100 ? ` (${item.Chance}%)` : '';
	if (item.Type === 'Currency' && item.Id === 'Nanites') {
		return {
			label: `${item.AmountMin}–${item.AmountMax} Nanites`,
			href: getSlug('TECHFRAG'),
			chanceSuffix,
		};
	}
	if (item.Type === 'Product' && item.ProductId) {
		const product = getById(item.ProductId);
		return {
			label: product?.Name ?? toTitleCase(item.ProductId),
			href: getSlug(item.ProductId),
			chanceSuffix,
		};
	}
	return { label: toTitleCase(item.Id ?? item.Type), chanceSuffix };
}

// League-stat increments carry no stat id in the data; show them once as "league progress".
function winParts(reward: ArenaReward | undefined) {
	const items = reward?.Items ?? [];
	const parts = items.filter((item) => item.Type !== 'IncrementStat').map(rewardItemParts);
	if (items.some((item) => item.Type === 'IncrementStat')) parts.push({ label: 'league progress' });
	return parts;
}

function summarizeReward(reward: ArenaReward | undefined): string {
	if (!reward) return 'None';
	const parts: string[] = [];
	for (const item of reward.Items) {
		const part = rewardItemParts(item);
		parts.push(`${part.label}${part.chanceSuffix ?? ''}`);
	}
	return parts.length > 0 ? parts.join(', ') : 'League stat progress';
}

const petBattlerModes = arenaModes.filter((m) => m.GameMode === 'Creature Battle');
const diceGameModes = arenaModes.filter((m) => m.GameMode === 'Dice Game');

const title = "Xeno Arena | No Man's Sky Recipes";
const description =
	'Explore the Xeno Arena system: battle modes, league progression, AI difficulty, rewards, and pet shop eggs.';
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Creatures', href: '/creatures' },
	{ name: 'Arena' },
];
const modeGroups = [
	{ heading: holoArenaHeader, modes: petBattlerModes },
	{ heading: 'Dice game', modes: diceGameModes },
].filter((group) => group.modes.length > 0);
// Every mode currently pays 1× XP; only show the column when a mode differs.
const showXp = arenaModes.some((mode) => mode.ExperienceMultiplier !== 1);
---

<Layout title={title} description={description} slug="creatures" {breadcrumbs}>
	<CreaturesShell
		active="arena"
		title="Xeno Arena"
		lead={`${arenaModes.length} arena modes, ${arenaLeagues.length} league ladders and ${petShop.length} reward eggs, with what each win pays.`}
		breadcrumbs={breadcrumbs}
	>
		<section class="cr-section" aria-labelledby="modes-heading">
			<h2 class="section-title" id="modes-heading">Modes <span class="count tabular">{arenaModes.length}</span></h2>
			{modeGroups.map((group) => (
				<>
					<h3 class="cr-h3">{group.heading}</h3>
					<table class="cr-table stack ar-modes">
						<thead>
							<tr>
								<th scope="col">Mode</th>
								<th scope="col">Difficulty</th>
								<th scope="col">Win reward</th>
								{showXp && <th scope="col" class="num">XP</th>}
							</tr>
						</thead>
						<tbody>
							{group.modes.map((mode) => {
								const winReward = mode.RewardWin ? rewardById.get(mode.RewardWin) : undefined;
								const diff = mode.Difficulty ?? (/pvp/i.test(mode.Id) ? 'Player vs player' : '—');
								return (
									<tr>
										<th scope="row">
											<span class="ar-mode">
												{mode.Name}
												{mode.Description && <span class="ar-desc">{mode.Description}</span>}
											</span>
										</th>
										<td data-label="Difficulty">
											<span class={`ar-diff ar-${(mode.Difficulty ?? 'pvp').toLowerCase()}`}>{diff}</span>
										</td>
										<td data-label="Win reward">
											<span>
												{winParts(winReward).length > 0
													? winParts(winReward).map((part, index) => (
															<>
																{index > 0 && ', '}
																{part.href ? <a href={part.href} class="link">{part.label}</a> : part.label}
																{part.chanceSuffix}
															</>
														))
													: summarizeReward(winReward)}
											</span>
										</td>
										{showXp && <td data-label="XP multiplier" class="num">{mode.ExperienceMultiplier}×</td>}
									</tr>
								);
							})}
						</tbody>
					</table>
				</>
			))}
		</section>

		<section class="cr-section" aria-labelledby="leagues-heading">
			<h2 class="section-title" id="leagues-heading">League ladders <span class="count tabular">{arenaLeagues.length}</span></h2>
			{arenaGuild?.Description && <p>{arenaGuild.Description}</p>}
			<p>Each ladder tracks one arena stat. Higher tiers unlock the reward eggs below.</p>
			{arenaLeagues.map((league) => (
				<details class="cr-details">
					<summary>
						<h3 class="m-0 text-[1.0625rem] font-semibold">{league.StatTitle}</h3>
						<span class="cr-sum-meta tabular">{league.Levels.length} tiers</span>
					</summary>
					<div class="cr-details-body">
						{league.WikiDescription && <p class="cr-note">{league.WikiDescription}</p>}
						<table class="cr-table">
							<thead>
								<tr>
									<th scope="col" class="num">Tier</th>
									<th scope="col">Title</th>
									<th scope="col" class="num">Threshold</th>
								</tr>
							</thead>
							<tbody>
								{league.Levels.map((level, idx) => (
									<tr>
										<td class="num">{idx}</td>
										<th scope="row">{level.LevelName}</th>
										<td class="num">{level.Threshold}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</details>
			))}
		</section>

		<section class="cr-section" aria-labelledby="eggs-heading">
			<h2 class="section-title" id="eggs-heading">Pet shop reward eggs <span class="count tabular">{petShop.length}</span></h2>
			<p>Companion eggs you can only earn by climbing the league ladders.</p>
			<div class="cr-grid c3">
				{petShop.map((egg) => {
					const league = leagueById.get(egg.RequiredStat);
					const statLabel = league?.StatTitle ?? toTitleCase(egg.RequiredStat);
					return (
						<article id={`pet-shop-${egg.Id}`} class="panel cr-card ar-egg">
							<div class="ar-egg-head">
								<span class="slot w-14">
									<img src={`${IMAGE_BASE}${toWebp(egg.Icon)}`} alt="" width="56" height="56" loading="lazy" />
								</span>
								<div class="min-w-0">
									<h3>
										<a href={getSlug(egg.ProductID)} class="ar-egg-name">{egg.Name}</a>
									</h3>
									<p class="cr-meta !mt-0">{egg.Group}</p>
								</div>
							</div>
							<p class="whitespace-pre-line">{egg.Description}</p>
							<p class="cr-meta">
								Requires <strong class="font-semibold text-ink">{statLabel} tier {egg.RequiredStatTier}</strong>
							</p>
						</article>
					);
				})}
			</div>
		</section>
	</CreaturesShell>
</Layout>

<style>
	.ar-mode { display: flex; flex-direction: column; gap: .15rem; }
	.ar-desc { font-size: .875rem; font-weight: 400; color: var(--color-dim); max-width: 46ch; }
	.ar-diff { display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; }
	.ar-diff::before { content: ""; width: .55rem; height: .55rem; border-radius: 50%; background: var(--color-dim); }
	.ar-easy::before { background: #4ade80; }
	.ar-medium::before { background: var(--color-accent); }
	.ar-hard::before { background: #f87171; }
	.ar-modes th:first-child { width: 40%; }
	.ar-egg { display: flex; flex-direction: column; gap: .6rem; scroll-margin-top: 5rem; }
	.ar-egg:target { border-color: var(--color-accent-line); }
	.ar-egg-head { display: flex; align-items: center; gap: .8rem; }
	.ar-egg-head h3 { margin: 0; }
	.ar-egg-name { color: var(--color-ink); text-decoration: underline; text-decoration-color: rgb(255 195 86 / .45); text-underline-offset: 3px; }
	.ar-egg-name:hover { color: var(--color-accent); }
	@media (max-width: 639px) {
		.ar-modes th:first-child { width: auto; }
		.ar-modes tbody th { display: block !important; }
		.cr-table.stack .ar-desc { max-width: none; }
	}
</style>
