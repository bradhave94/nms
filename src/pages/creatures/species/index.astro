---
import Layout from '@layouts/Layout.astro';
import CreaturesShell from '@components/creatures/CreaturesShell.astro';
import SpeciesTable from '@components/creatures/SpeciesTable.astro';
import { counts, speciesRows } from '@components/creatures/data';
import { buildCollectionStructuredData, getSiteOrigin } from '@utils/structuredData.js';
import { buildPaginatedMeta } from '@utils/seo.js';

const species = speciesRows();

const siteOrigin = getSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL('/creatures/species/', siteOrigin).toString();
const collectionDescription =
	"Browse No Man's Sky creature species, battle readiness, rarity, move area, and affinity data from the Xeno Arena system.";
const structuredData = buildCollectionStructuredData({
	siteOrigin,
	canonicalUrl,
	collectionName: 'Creature Species',
	collectionDescription,
	collectionPath: '/creatures/species',
	breadcrumbs: [{ name: 'Home', href: '/' }, { name: 'Creatures', href: '/creatures/' }, { name: 'Species' }],
	currentPage: 1,
	items: species.slice(0, 25).map((item, index) => ({
		name: item.subtitle ? `${item.name} (${item.subtitle})` : item.name,
		url: `${siteOrigin}/creatures/${item.id}/`,
		position: index + 1,
	})),
});
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Creatures', href: '/creatures/' },
	{ name: 'Species' },
];
const { title, description } = buildPaginatedMeta('Creature Species', collectionDescription, 1, 1);
---

<Layout title={title} description={description} slug="creatures" structuredData={structuredData}>
	<CreaturesShell
		active="species"
		title="Creature species"
		lead={`${counts.species} species, ${counts.battleReady} of them battle-ready. Colours mark affinity, battle readiness, rarity and where each one moves.`}
		breadcrumbs={breadcrumbs}
		icon="SPEC_PB_EGG01.png"
		iconColour="2C3E50"
	>
		<SpeciesTable caption="Creature species" />
		<p class="cr-note mt-6">
			Affinity decides who wins a Xeno Arena fight. See the <a class="link" href="/creatures/affinities/">affinity matchups</a>.
		</p>
	</CreaturesShell>
</Layout>
