---
import Layout from '@layouts/Layout.astro';
import CreaturesShell from '@components/creatures/CreaturesShell.astro';
import { allSpecies, speciesLabel, toTitleCase } from '@components/creatures/data';
import { getSlug } from '@utils/lookup.js';
import creaturesData from '@datav2/Creatures.json';
import eggModifiers from '@datav2/EggModifiers.json';

type TraitModifier = {
	Trait: string;
	TraitMin: number;
	TraitMax: number;
	WeightModifierMin: number;
	WeightModifierMax: number;
	CooldownModifierMin: number;
	CooldownModifierMax: number;
};

type MoodModifier = {
	Mood: string;
	MoodMin: number;
	MoodMax: number;
	WeightModifierMin: number;
	WeightModifierMax: number;
	CooldownModifierMin: number;
	CooldownModifierMax: number;
};

type FollowUpBehaviour = {
	Behaviour: string;
	TraitBased: boolean;
	Trait: string;
	TraitMin: number;
	TraitMax: number;
	WeightMin: number;
	WeightMax: number;
};

type Behaviour = {
	Id: string;
	Name: string;
	Label: string | null;
	UILabel: string | null;
	ReactiveBehaviour: boolean;
	UsefulBehaviour: boolean;
	Weight: number;
	MinPerformTime: number;
	MaxPerformTime: number;
	CooldownTime: number;
	Validity: string;
	TraitModifiers?: TraitModifier[];
	MoodModifiers?: MoodModifier[];
	FollowUpBehaviours?: FollowUpBehaviour[];
	MoodOnComplete?: { Hungry: number; Lonely: number };
	Slug?: string;
};

type PetAccessory = {
	Id: string;
	Name: string;
	Descriptor: string;
	Description: string | null;
	Groups: string[];
	Slug?: string;
};

type EggOverride = {
	Id: string;
	CreatureID: string;
	CanChangeGrowth: boolean;
	CanChangeAccessories: boolean;
	CanChangeColour: boolean;
	CanChangeTraits: boolean;
	MinScaleOverride: number;
	MaxScaleOverride: number;
	Slug?: string;
};

type EggModifier = {
	Id: string;
	ItemId: string;
	ItemType: string;
	Name: string;
	Group: string;
	Trait: string;
	IncreasesTrait: boolean;
	Direction: string;
	DirectionSymbol: string;
	EffectShort: string;
	BaseValueOverride: number;
};

type EggSequencerConstants = {
	PetEggLayingInterval: number;
	PetEggFirstEggDelay: number;
	PetEggModificationTime: number;
	PetEggModificationItemLimit: number;
	PetEggSubstanceModifier: number;
	PetEggScaleRangeModifier: number;
	PetEggScaleRangeMax: number;
	PetEggTraitRangeModifier: number;
	PetEggTraitRangeMax: number;
	PetEggOverdosageModifier: number;
	PetEggMaxOverdosage: number;
	PetEggMaxTopDescriptorChangeChance: number;
	PetEggAccessoryChanceModifier: number;
	PetEggMaxAccessoriesChangeChance: number;
	PetEggMaxChangeProduct: string;
};

const data = creaturesData as Record<string, unknown>;
const behaviours = (data.Behaviours as Behaviour[] | undefined) ?? [];
const petAccessories = (data.PetAccessories as PetAccessory[] | undefined) ?? [];
const eggOverrides = (data.EggOverrides as EggOverride[] | undefined) ?? [];
const globals = data.CreatureGlobals as Record<string, unknown> ?? {};
const eggConstants = globals.EggSequencerConstants as EggSequencerConstants | undefined;
const battleStats = (globals.BattleStats as Record<string, { Header: string | null; Label: string | null }>) ?? {};
const arenaModes = ((creaturesData as Record<string, unknown>).ArenaModes as { Id: string; Name: string; Description: string | null; GameMode: string; Difficulty: string | null; ExperienceMultiplier: number }[] | undefined) ?? [];
const slotLabels = (globals.AccessorySlotLabels as Record<string, string>) ?? {};
const eggLabels = (globals.EggLabels as {
	TraitWords: Record<string, string>;
	SizeWords: Record<string, string>;
	TypeNames: Record<string, string>;
	Requirements: Record<string, string>;
}) ?? { TraitWords: {}, SizeWords: {}, TypeNames: {}, Requirements: {} };
const moodStrings = (globals.MoodStrings as { Good: string[]; Hungry: string[]; Lonely: string[] }) ?? { Good: [], Hungry: [], Lonely: [] };
const wonderRecords = (globals.WonderRecords as Array<{Name: string; Measurement?: string | null}>) ?? [];
const trustConstants = (globals.TrustConstants as Record<string, number>) ?? {};
const feedingConstants = (globals.FeedingConstants as Record<string, number>) ?? {};
const movementConstants = (globals.MovementConstants as Record<string, number>) ?? {};
const companionChat = (globals.CompanionChat as Record<string, string[]>) ?? {};
const biomeChat = (globals.BiomeChat as Record<string, string[]>) ?? {};
const goodMoods = [...new Set(moodStrings.Good)];
const hungryMoods = [...new Set(moodStrings.Hungry)];
const lonelyMoods = [...new Set(moodStrings.Lonely)];

const chatCategoryCount = Object.keys(companionChat).length;
const chatMessageCount = Object.values(companionChat).reduce((sum, arr) => sum + arr.length, 0);
const sortedChatCategories = Object.entries(companionChat)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([category, messages]) => {
		const display = category
			.replace(/_/g, ' ')
			.split(' ')
			.map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
			.join(' ')
			.replace(/Agg$/, '(Aggressive)')
			.replace(/Dev$/, '(Devoted)')
			.replace(/Gen$/, '(Gentle)')
			.replace(/Hel$/, '(Helpful)')
			.replace(/Ind$/, '(Independent)')
			.replace(/Pla$/, '(Playful)');
		return { category, display, messages };
	});
const sortedBiomeChat = Object.entries(biomeChat).sort(([a], [b]) => a.localeCompare(b));

const sortedBehaviours = [...behaviours].sort((a, b) => {
	if (a.UsefulBehaviour !== b.UsefulBehaviour) return a.UsefulBehaviour ? -1 : 1;
	return b.Weight - a.Weight;
});

const trustLabels: Record<string, string> = {
	PetTrustOnAdoption: 'Trust on Adoption',
	PetTrustOnHatch: 'Trust on Hatch',
	PetTrustIncreaseStep: 'Trust Increase per Step',
	PetTrustDecreaseStep: 'Trust Decrease per Step',
	PetTrustIncreaseThreshold: 'Increase Threshold',
	PetTrustDecreaseThreshold: 'Decrease Threshold',
	PetMinTrust: 'Minimum Trust',
	PetTrustChangeInterval: 'Change Interval',
};

const feedingLabels: Record<string, string> = {
	FeedingTaskAmount: 'Feeding Task Amount',
	FeedingFollowTime: 'Follow Time After Feeding',
	FeedingNoticeTime: 'Notice Time',
	FeedingNoticeDistance: 'Notice Distance',
	PetInteractBaseRange: 'Interaction Range',
	PetTickleChatChance: 'Tickle Chat Chance',
	PetTreatChatChance: 'Treat Chat Chance',
	PetChatCooldown: 'Chat Cooldown',
	PetChatUseTraitTemplateChance: 'Trait Chat Chance',
};

const movementLabels: Record<string, string> = {
	PetAnimSpeedBoostSmallerThan: 'Speed Boost Threshold (smaller than)',
	PetAnimSpeedBoostStrength: 'Speed Boost Strength',
	PetAnimSpeedMax: 'Max Animation Speed',
	PetAnimSpeedMin: 'Min Animation Speed',
	PetMinSummonDistance: 'Min Summon Distance',
	PetMaxSummonDistance: 'Max Summon Distance',
	PetFollowRunPlayerDistance: 'Run-to-Follow Distance',
	PetPlayerSpeedSmoothTime: 'Speed Smooth Time',
};

const modifiers = eggModifiers as EggModifier[];
const traits = ['Helpfulness', 'Aggression', 'Independence'] as const;
const modsByTrait = Object.fromEntries(
	traits.map((trait) => [
		trait,
		{
			increase: modifiers.filter((m) => m.Trait === trait && m.IncreasesTrait),
			decrease: modifiers.filter((m) => m.Trait === trait && !m.IncreasesTrait),
		},
	])
) as Record<string, { increase: EggModifier[]; decrease: EggModifier[] }>;

const formatTime = (seconds: number): string => {
	if (seconds < 60) return `${seconds}s`;
	if (seconds < 3600) return `${(seconds / 60).toFixed(0)}m`;
	const hrs = seconds / 3600;
	return hrs === Math.floor(hrs) ? `${hrs}h` : `${hrs.toFixed(1)}h`;
};

const formatPerformTime = (min: number, max: number): string => {
	if (min === max) return formatTime(min);
	return `${formatTime(min)} – ${formatTime(max)}`;
};


const traitColors: Record<string, string> = {
	Helpfulness: 'text-emerald-300',
	Aggression: 'text-red-300',
	Independence: 'text-amber-300',
};

const title = "Companions | No Man's Sky Recipes";
const description =
	"Companion behaviours, egg sequencer modifiers, pet accessories, and egg overrides for No Man's Sky.";
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Creatures', href: '/creatures' },
	{ name: 'Companions' },
];
const overrideName = (creatureId: string): string => {
	const match = allSpecies.find((s) => s.Id === creatureId);
	return match ? speciesLabel(match) : creatureId;
};

const jumpLinks = [
	{ id: 'leveling', label: 'Leveling and genetics' },
	{ id: 'behaviours', label: 'Behaviours' },
	{ id: 'egg-sequencer', label: 'Egg sequencer' },
	{ id: 'accessories', label: 'Accessories' },
	{ id: 'moods', label: 'Mood states' },
	{ id: 'records', label: 'Records' },
	{ id: 'chat', label: 'Companion chat' },
];

const moodGroups = [
	{ label: 'Happy', cls: 'text-emerald-300', words: goodMoods },
	{ label: 'Hungry', cls: 'text-amber-300', words: hungryMoods },
	{ label: 'Lonely', cls: 'text-violet-300', words: lonelyMoods },
];

const trustDisplay = (key: string, value: number): string =>
	key === 'PetTrustChangeInterval' ? `${value}s` : String(value);
const feedingDisplay = (key: string, value: number): string => {
	const isTime = key.includes('Time') || key === 'PetChatCooldown';
	const isDist = key.includes('Distance') || key.includes('Range');
	const isChance = key.includes('Chance');
	return isTime ? `${value}s` : isDist ? `${value}m` : isChance ? `${(value * 100).toFixed(0)}%` : String(value);
};
const movementDisplay = (key: string, value: number): string =>
	key.includes('Distance') ? `${value}m` : key.includes('Time') ? `${value}s` : String(value);

const sequencerRows: [string, string][] = eggConstants
	? [
			['Egg laying interval', formatTime(eggConstants.PetEggLayingInterval)],
			['First egg delay', formatTime(eggConstants.PetEggFirstEggDelay)],
			['Modification time', `${eggConstants.PetEggModificationTime}s`],
			['Modification item limit', String(eggConstants.PetEggModificationItemLimit)],
			['Substance modifier', `${eggConstants.PetEggSubstanceModifier}x`],
			['Scale range modifier', String(eggConstants.PetEggScaleRangeModifier)],
			['Scale range max', String(eggConstants.PetEggScaleRangeMax)],
			['Trait range modifier', String(eggConstants.PetEggTraitRangeModifier)],
			['Trait range max', String(eggConstants.PetEggTraitRangeMax)],
			['Overdosage modifier', String(eggConstants.PetEggOverdosageModifier)],
			['Max overdosage', String(eggConstants.PetEggMaxOverdosage)],
			['Top descriptor change chance', `${(eggConstants.PetEggMaxTopDescriptorChangeChance * 100).toFixed(0)}%`],
			['Accessory chance modifier', `${eggConstants.PetEggAccessoryChanceModifier}x`],
			['Max accessories change chance', `${(eggConstants.PetEggMaxAccessoriesChangeChance * 100).toFixed(0)}%`],
			['Max change product', eggConstants.PetEggMaxChangeProduct],
		]
	: [];
---

<Layout title={title} description={description} slug="creatures" {breadcrumbs}>
	<CreaturesShell
		active="companions"
		title="Companions"
		lead={`Raise, breed and battle-train your creatures: how mutation works, ${behaviours.length} companion behaviours, the egg sequencer, ${petAccessories.length} accessories and every mood state.`}
		breadcrumbs={breadcrumbs}
	>
		<nav aria-label="On this page">
			<ul class="cr-jump">
				{jumpLinks.map((link) => <li><a href={`#${link.id}`}>{link.label}</a></li>)}
			</ul>
		</nav>

		<section id="leveling" class="cr-section" aria-labelledby="leveling-h">
			<h2 id="leveling-h" class="section-title">Leveling and genetics</h2>
			<p>How companions gain power through battle experience, mutation progress and gene editing.</p>

			<h3 class="cr-h3">How mutation works</h3>
			<ol class="cp-steps">
				<li class="panel cr-card">
					<span class="cr-card-title">Battle</span>
					<p>Exposure to battles in the Holo-Arena will slowly mutate a companion.</p>
				</li>
				<li class="panel cr-card">
					<span class="cr-card-title">Gene edit</span>
					<p>Each level of mutation allows an individual gene to be edited, levelling up the companion's combat performance.</p>
				</li>
				<li class="panel cr-card">
					<span class="cr-card-title">Max potential</span>
					<p>Once a creature reaches its maximum genetic potential, further edits can be made to change the creature's available moves.</p>
				</li>
			</ol>

			<h3 class="cr-h3">The three editable genes</h3>
			<div class="cr-grid c3">
				<div class="panel cr-card">
					<h4 class="cr-card-title text-emerald-300">Agility</h4>
					<p>Editing this gene will improve this creature's agility, improving their chances to dodge incoming attacks. In a battle, the creature with the higher agility stat will move first.</p>
					<p class="cr-meta">Smaller creatures have a higher inherent agility.</p>
				</div>
				<div class="panel cr-card">
					<h4 class="cr-card-title text-red-300">Health</h4>
					<p>Editing this gene will improve this creature's health, improving their chances of survival in the Holo-Arena.</p>
					<p class="cr-meta">Larger creatures have higher inherent health.</p>
				</div>
				<div class="panel cr-card">
					<h4 class="cr-card-title text-amber-300">Combat</h4>
					<p>Editing this gene will improve this creature's combat ability, increasing the power of their abilities. Improvements include damage, healing strength, buff duration, and more.</p>
				</div>
			</div>

			<h3 class="cr-h3">Size and stats</h3>
			<div class="cr-grid c2">
				<div class="panel cr-card">
					<h4 class="cr-card-title">Small creatures</h4>
					<p>Boosted agility: they move first more often and dodge better.</p>
				</div>
				<div class="panel cr-card">
					<h4 class="cr-card-title">Large creatures</h4>
					<p>Boosted health: higher survivability, and they can absorb more damage.</p>
				</div>
			</div>

			<h3 class="cr-h3">Retroviral Pellet</h3>
			<div class="panel cr-card cp-pellet">
				<p>
					<a class="link font-semibold" href={getSlug('TREAT_FREELEVEL')}>Retroviral Pellet</a>
					<span class="text-dim"> · genetic mutator</span>
				</p>
				<p class="mt-1">
					A specialised treat laced with gene-manipulating retroviruses, capable of evolving the battle abilities of a companion. Feeding this to your tamed creatures will instantly unlock part of their genetic potential.
				</p>
			</div>

			<h3 class="cr-h3">Battle stats reference</h3>
			<table class="cr-table stack">
				<thead>
					<tr>
						<th scope="col">Stat</th>
						<th scope="col">Header</th>
						<th scope="col">Label</th>
					</tr>
				</thead>
				<tbody>
					{Object.entries(battleStats).map(([key, stat]) => (
						<tr>
							<th scope="row">{key}</th>
							<td data-label="Header">{stat.Header ?? '—'}</td>
							<td data-label="Label">{stat.Label ?? '—'}</td>
						</tr>
					))}
				</tbody>
			</table>

			<h3 class="cr-h3">Trust and bonding</h3>
			<p class="cr-note">Companions build trust over time through feeding, interaction and care.</p>
			<dl class="cr-facts">
				{Object.entries(trustConstants).map(([key, value]) => (
					<div><dt>{trustLabels[key] ?? key}</dt><dd>{trustDisplay(key, value)}</dd></div>
				))}
			</dl>

			<h3 class="cr-h3">Feeding and interaction</h3>
			<dl class="cr-facts">
				{Object.entries(feedingConstants).map(([key, value]) => (
					<div><dt>{feedingLabels[key] ?? key}</dt><dd>{feedingDisplay(key, value)}</dd></div>
				))}
			</dl>

			<h3 class="cr-h3">Movement and speed</h3>
			<dl class="cr-facts">
				{Object.entries(movementConstants).map(([key, value]) => (
					<div><dt>{movementLabels[key] ?? key}</dt><dd>{movementDisplay(key, value)}</dd></div>
				))}
			</dl>

			{arenaModes.length > 0 && (
				<>
					<h3 class="cr-h3">XP multipliers by mode</h3>
					<table class="cr-table stack">
						<thead>
							<tr>
								<th scope="col">Mode</th>
								<th scope="col">Game type</th>
								<th scope="col">Difficulty</th>
								<th scope="col" class="num">XP multiplier</th>
							</tr>
						</thead>
						<tbody>
							{arenaModes.map((mode) => (
								<tr>
									<th scope="row">{mode.Name}</th>
									<td data-label="Game type">{mode.GameMode}</td>
									<td data-label="Difficulty">{mode.Difficulty ?? '—'}</td>
									<td data-label="XP multiplier" class="num">{mode.ExperienceMultiplier}x</td>
								</tr>
							))}
						</tbody>
					</table>
				</>
			)}
		</section>

		<section id="behaviours" class="cr-section" aria-labelledby="behaviours-h">
			<h2 id="behaviours-h" class="section-title">Companion behaviours <span class="count tabular">{behaviours.length}</span></h2>
			<p>
				Useful behaviours first, then by weight. The line under a behaviour lists its trait and mood modifiers, the
				mood change when it completes, and the behaviours it can chain to.
			</p>
			<table class="cr-table stack cp-beh">
				<thead>
					<tr>
						<th scope="col">Name</th>
						<th scope="col" class="hide-sm">Label</th>
						<th scope="col">Useful</th>
						<th scope="col">Validity</th>
						<th scope="col" class="num">Weight</th>
						<th scope="col" class="num">Cooldown</th>
						<th scope="col" class="num">Perform time</th>
					</tr>
				</thead>
				<tbody>
					{sortedBehaviours.map((b) => {
						const hasDetails = (b.TraitModifiers && b.TraitModifiers.length > 0)
							|| (b.MoodModifiers && b.MoodModifiers.length > 0)
							|| b.MoodOnComplete
							|| (b.FollowUpBehaviours && b.FollowUpBehaviours.length > 0);
						return (
							<>
								<tr class={hasDetails ? 'has-detail' : ''}>
									<th scope="row">{b.Name}</th>
									<td data-label="Label" class="hide-sm">{b.UILabel ?? b.Label ?? '—'}</td>
									<td data-label="Useful">
										{b.UsefulBehaviour ? (
											<span class="cr-yes"><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.58l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>Yes</span>
										) : (
											<span class="cr-no"><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5 9h10v2H5z" /></svg>No</span>
										)}
									</td>
									<td data-label="Validity">{b.Validity}</td>
									<td data-label="Weight" class="num">{b.Weight}</td>
									<td data-label="Cooldown" class="num">{formatTime(b.CooldownTime)}</td>
									<td data-label="Perform time" class="num">{formatPerformTime(b.MinPerformTime, b.MaxPerformTime)}</td>
								</tr>
								{hasDetails && (
									<tr class="detail">
										<td colspan="7">
											<div class="cp-detail">
												{b.TraitModifiers?.map((tm) => (
													<p>
														<span class={`font-semibold ${traitColors[tm.Trait] ?? 'text-ink'}`}>{tm.Trait}</span>{' '}
														scales weight {tm.WeightModifierMin}x – {tm.WeightModifierMax}x, cooldown {tm.CooldownModifierMin}x – {tm.CooldownModifierMax}x
													</p>
												))}
												{b.MoodModifiers?.map((mm) => (
													<p>
														Mood {mm.Mood} ({mm.MoodMin} – {mm.MoodMax}) scales weight {mm.WeightModifierMin}x – {mm.WeightModifierMax}x, cooldown {mm.CooldownModifierMin}x – {mm.CooldownModifierMax}x
													</p>
												))}
												{b.MoodOnComplete && (
													<p>
														On completion:
														{b.MoodOnComplete.Hungry !== 0 && ` Hungry ${b.MoodOnComplete.Hungry > 0 ? '+' : ''}${b.MoodOnComplete.Hungry}`}
														{b.MoodOnComplete.Lonely !== 0 && ` Lonely ${b.MoodOnComplete.Lonely > 0 ? '+' : ''}${b.MoodOnComplete.Lonely}`}
														{b.MoodOnComplete.Hungry === 0 && b.MoodOnComplete.Lonely === 0 && ' no mood change'}
													</p>
												)}
												{b.FollowUpBehaviours && b.FollowUpBehaviours.length > 0 && (
													<p>
														Chains to{' '}
														{b.FollowUpBehaviours.map((fu, i) => (
															<>
																{i > 0 && ', '}
																<span class="text-ink">{fu.Behaviour}</span>
																{fu.TraitBased && (
																	<span class={traitColors[fu.Trait] ?? ''}> ({fu.Trait} {fu.TraitMin} → {fu.TraitMax})</span>
																)}
															</>
														))}
													</p>
												)}
											</div>
										</td>
									</tr>
								)}
							</>
						);
					})}
				</tbody>
			</table>
		</section>

		<section id="egg-sequencer" class="cr-section" aria-labelledby="egg-h">
			<h2 id="egg-h" class="section-title">Egg sequencer</h2>
			<p>
				Add substances or products to an egg in the Egg Sequencer to shift the companion's traits. Items are grouped by
				the trait they affect and whether they raise or lower it.
			</p>

			<div class="cr-grid">
				{traits.map((trait) => (
					<div class="panel cr-card">
						<h3 class={`cr-card-title ${traitColors[trait]}`}>{trait}</h3>
						<div class="cr-grid c2 mt-2">
							{([['Increase', modsByTrait[trait].increase], ['Decrease', modsByTrait[trait].decrease]] as const).map(([dir, list]) => (
								<div>
									<p class="cp-dir">{dir}s {trait.toLowerCase()} <span class="tabular">({list.length})</span></p>
									<ul class="cp-mods">
										{list.map((m) => (
											<li>
												<span class="text-ink">{m.Name}</span>
												<span class="cp-mod-meta">{m.ItemType} · {m.Group}</span>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</div>
				))}
			</div>

			{sequencerRows.length > 0 && (
				<>
					<h3 class="cr-h3">Sequencer constants</h3>
					<table class="cr-table">
						<thead>
							<tr>
								<th scope="col">Parameter</th>
								<th scope="col" class="num">Value</th>
							</tr>
						</thead>
						<tbody>
							{sequencerRows.map(([label, value]) => (
								<tr>
									<th scope="row" class="!font-normal">{label}</th>
									<td class="num !text-ink">{value}</td>
								</tr>
							))}
						</tbody>
					</table>
				</>
			)}

			<div class="cr-grid c2 mt-6">
				<div class="panel cr-card">
					<h3 class="cr-card-title">Trait words</h3>
					<p class="cr-meta !mt-0 mb-3">Words that describe a companion's personality after trait changes.</p>
					<dl class="cp-words">
						{Object.entries(eggLabels.TraitWords).map(([key, word]) => (
							<div><dt>{key}</dt><dd>{word}</dd></div>
						))}
					</dl>
				</div>
				<div class="panel cr-card">
					<h3 class="cr-card-title">Size words</h3>
					<p class="cr-meta !mt-0 mb-3">Words that describe a companion's size after sequencer changes.</p>
					<dl class="cp-words">
						{Object.entries(eggLabels.SizeWords).map(([key, word]) => (
							<div><dt>{key}</dt><dd>{word}</dd></div>
						))}
					</dl>
				</div>
			</div>

			{eggOverrides.length > 0 && (
				<>
					<h3 class="cr-h3">Egg overrides</h3>
					<p class="cr-note">These species have special rules in the Egg Sequencer.</p>
					<table class="cr-table stack">
						<thead>
							<tr>
								<th scope="col">Species</th>
								<th scope="col">Growth</th>
								<th scope="col">Accessories</th>
								<th scope="col">Colour</th>
								<th scope="col">Traits</th>
								<th scope="col" class="num">Scale range</th>
							</tr>
						</thead>
						<tbody>
							{eggOverrides.map((eo) => (
								<tr>
									<th scope="row"><a href={`/creatures/${eo.CreatureID}/`} class="link">{overrideName(eo.CreatureID)}</a></th>
									{([['Growth', eo.CanChangeGrowth], ['Accessories', eo.CanChangeAccessories], ['Colour', eo.CanChangeColour], ['Traits', eo.CanChangeTraits]] as const).map(([label, ok]) => (
										<td data-label={label}>
											{ok ? (
												<span class="cr-yes"><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.58l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>Can change</span>
											) : (
												<span class="cr-no"><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5 9h10v2H5z" /></svg>Fixed</span>
											)}
										</td>
									))}
									<td data-label="Scale range" class="num">{eo.MinScaleOverride} – {eo.MaxScaleOverride}</td>
								</tr>
							))}
						</tbody>
					</table>
				</>
			)}
		</section>

		<section id="accessories" class="cr-section" aria-labelledby="acc-h">
			<h2 id="acc-h" class="section-title">Pet accessories <span class="count tabular">{petAccessories.length}</span></h2>
			<p>Accessories you can fit to a companion. The placement shows where each one attaches.</p>
			<ul class="cr-grid c3 cp-acc">
				{petAccessories.map((acc) => (
					<li class="panel cr-card">
						<h3 class="cr-card-title">{acc.Name}</h3>
						{acc.Description && <p>{acc.Description}</p>}
						<p class="cr-meta">
							{acc.Groups.map((group) => slotLabels[group] ?? toTitleCase(group)).join(', ')}
						</p>
					</li>
				))}
			</ul>
		</section>

		<section id="moods" class="cr-section" aria-labelledby="moods-h">
			<h2 id="moods-h" class="section-title">Mood states <span class="count tabular">{goodMoods.length + hungryMoods.length + lonelyMoods.length}</span></h2>
			<p>The words a companion's mood can show, in three groups.</p>
			<div class="cr-grid c3">
				{moodGroups.map((group) => (
					<div class="panel cr-card">
						<h3 class={`cr-card-title ${group.cls}`}>{group.label} <span class="text-dim font-normal text-sm tabular">{group.words.length}</span></h3>
						<ul class="cr-chips">
							{group.words.map((m) => <li class="cr-chip">{m}</li>)}
						</ul>
					</div>
				))}
			</div>
		</section>

		<section id="records" class="cr-section" aria-labelledby="records-h">
			<h2 id="records-h" class="section-title">Creature records <span class="count tabular">{wonderRecords.length}</span></h2>
			<p>Records the game tracks for the creatures you discover.</p>
			<ul class="cp-records">
				{wonderRecords.map((record) => (
					<li>
						<span class="text-ink">{record.Name}</span>
						{record.Measurement && <span class="text-dim text-sm">{record.Measurement}</span>}
					</li>
				))}
			</ul>
		</section>

		<section id="chat" class="cr-section" aria-labelledby="chat-h">
			<h2 id="chat-h" class="section-title">Companion chat</h2>
			<p>
				What companions say during different activities and moods, shaped by their personality traits:
				{' '}{chatCategoryCount} categories, {chatMessageCount} messages.
			</p>
			{sortedChatCategories.map(({ display, messages }) => (
				<details class="cr-details">
					<summary>
						<span>{display}</span>
						<span class="cr-sum-meta tabular">{messages.length} messages</span>
					</summary>
					<div class="cr-details-body">
						<ul class="cr-chips">
							{messages.map((msg) => <li class="cr-chip">{msg}</li>)}
						</ul>
					</div>
				</details>
			))}

			{sortedBiomeChat.length > 0 && (
				<>
					<h3 class="cr-h3">Biome words</h3>
					<p class="cr-note">Words companions use to describe each planet type.</p>
					<dl class="cr-grid c3 cp-biomes">
						{sortedBiomeChat.map(([biome, words]) => (
							<div class="panel cr-card">
								<dt class="cr-card-title">{toTitleCase(biome)}</dt>
								<dd>{words.join(', ')}</dd>
							</div>
						))}
					</dl>
				</>
			)}
		</section>
	</CreaturesShell>
</Layout>

<style>
	.cp-steps { display: grid; gap: .75rem; margin: 0; padding: 0; list-style: none; counter-reset: step; }
	@media (min-width: 768px) { .cp-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	.cp-steps li { counter-increment: step; }
	.cp-steps .cr-card-title { display: flex; align-items: center; gap: .55rem; }
	.cp-steps .cr-card-title::before { content: counter(step); display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--color-panel-3); border: 1px solid var(--color-line-strong); font-size: .875rem; font-weight: 600; font-variant-numeric: tabular-nums; }
	.cp-pellet { max-width: 36rem; }
	.cp-beh tbody th { white-space: nowrap; }
	.cp-beh tr.has-detail > * { border-bottom: 0; }
	.cp-detail { display: grid; gap: .2rem; }
	.cp-detail p { margin: 0; }
	.cp-dir { margin: 0 0 .35rem; font-size: .875rem; font-weight: 600; color: var(--color-dim); }
	.cp-mods { display: grid; gap: .3rem; margin: 0; padding: 0; list-style: none; }
	.cp-mods li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .1rem .75rem; padding: .4rem .65rem; border-radius: 8px; background: var(--color-panel-2); border: 1px solid var(--color-line); font-size: .9375rem; }
	.cp-mod-meta { font-size: .8125rem; color: var(--color-dim); }
	.cp-words { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .35rem; margin: 0; }
	.cp-words div { padding: .35rem .6rem; border-radius: 8px; background: var(--color-panel-2); border: 1px solid var(--color-line); }
	.cp-words dt { font-size: .75rem; color: var(--color-dim); }
	.cp-words dd { margin: 0; font-size: .9375rem; }
	.cp-acc { margin: 0; padding: 0; list-style: none; }
	.cp-records { display: grid; gap: .4rem; margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
	.cp-records li { display: flex; flex-direction: column; padding: .55rem .8rem; border-radius: 10px; background: var(--color-panel); border: 1px solid var(--color-line); }
	.cp-biomes { margin: 0; }
	.cp-biomes dd { margin: 0; font-size: .9375rem; color: #cfd9e4; }
	@media (min-width: 640px) { .cp-beh tbody th { white-space: normal; } }
</style>
