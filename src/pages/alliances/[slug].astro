---
import '@assets/css/alliances.css';
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { ALLIANCE_COLOURS, findGalaxy } from '@utils/alliances';
import { swatchStyle } from '@utils/contrast';
import { findCommunityBanners } from '@utils/allianceBanners';
import { SITE } from '@config';
import { getApprovedAllianceBySlug, type PublicAlliance } from '@utils/alliancesDb';
import { notFoundResponse } from '@utils/notFound';
import { toWebp } from '@utils/icons';

export const prerender = false;

const slug = Astro.params.slug ?? '';
let alliance: PublicAlliance | undefined;
try {
	alliance = await getApprovedAllianceBySlug(slug);
} catch (error) {
	console.error('Alliance lookup failed', error);
	return new Response('The alliance directory is temporarily unavailable.', {
		status: 503,
		headers: { 'Cache-Control': 'no-store', 'Content-Type': 'text/plain; charset=utf-8' },
	});
}
if (!alliance) {
	return notFoundResponse();
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');

const siteOrigin = 'https://nomansskyrecipes.com';
const canonical = `/alliances/${alliance.slug}/`;
const title = `${alliance.name}${alliance.tag ? ` [${alliance.tag}]` : ''}: No Man's Sky Alliance`;
const locationText = [alliance.galaxy, alliance.region].filter(Boolean).join(', ');
const firstSentence = alliance.description.split(/(?<=[.!?])\s/)[0] ?? alliance.description;
const description = `${alliance.name} is a No Man's Sky alliance in ${locationText}. ${firstSentence}`.slice(0, 158);
const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Alliances', href: '/alliances/' }, { name: alliance.name }];
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Alliances', item: `${siteOrigin}/alliances/` },
		{ '@type': 'ListItem', position: 3, name: alliance.name, item: `${siteOrigin}${canonical}` },
	],
};
const communityItems = findCommunityBanners(alliance.name);
const galaxyNumber = findGalaxy(alliance.galaxy)?.number;
const platformsText = alliance.platforms.length > 0 ? alliance.platforms.join(', ') : 'All platforms';
const colourName = ALLIANCE_COLOURS.find((colour) => colour.hex === alliance.color.toLowerCase())?.name;
// The portal address as the game shows it: 12 glyphs, read here in groups of four.
const glyphGroups = alliance.portalGlyphs ? (alliance.portalGlyphs.toUpperCase().match(/.{1,4}/g) ?? []) : [];
const listedOn = alliance.approvedAt
	? new Date(alliance.approvedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
	: undefined;
---

<Layout {title} {description} slug="alliances" {canonical} {structuredData}>
	<div class="alliances mx-auto max-w-[1180px] pb-16 lg:px-8">
		<Breadcrumbs items={breadcrumbs} className="!px-0 pt-4 mb-4" />
		<header class="mb-8">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
				{alliance.tag && <span class="tag tag-lg" style={swatchStyle(alliance.color)}><span class="sr-only">Tag </span>{alliance.tag}</span>}
				<h1 class="min-w-0 [overflow-wrap:anywhere]">{alliance.name}</h1>
			</div>
			<p class="lede">No Man's Sky alliance in {locationText}</p>
		</header>

		<div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
			<div class="min-w-0 space-y-6">
				<section class="panel" aria-labelledby="about-heading">
					<h2 id="about-heading">About</h2>
					<p class="description mt-4">{alliance.description}</p>
					{alliance.focuses.length > 0 && (
						<p class="help mt-4">Focus: {alliance.focuses.join(' · ')}</p>
					)}
				</section>

				<section class="panel" aria-labelledby="join-heading">
					<h2 id="join-heading">How to join {alliance.name}</h2>
					<ol class="steps mt-4">
						<li>
							Travel to the <strong>{alliance.galaxy}</strong> galaxy{galaxyNumber && galaxyNumber > 1 && <> (galaxy {galaxyNumber})</>}{alliance.region && <> and the <strong>{alliance.region}</strong> region</>}.
							{alliance.galaxy.toLowerCase() !== 'euclid' && <> See our <a class="link" href="/blog/no-mans-sky-galaxies-guide/">galaxies guide</a> for getting between galaxies.</>}
						</li>
						<li>
							Find the <strong>{alliance.joinSystem}</strong> system.
							{alliance.portalGlyphs ? <> The quickest route is a portal. Dial this address:</> : <> Ask the alliance for directions if you can't find it on the Galaxy Map.</>}
							{glyphGroups.length > 0 && (
								<p class="glyphs">
									<span class="sr-only">Portal address {glyphGroups.join('').split('').join(' ')}</span>
									{glyphGroups.map((group) => (
										<span class="glyph-group" aria-hidden="true">{group.split('').map((glyph) => <span class="glyph">{glyph}</span>)}</span>
									))}
								</p>
							)}
						</li>
						<li>Dock at the space station, go to the Station Core and choose to join the alliance.</li>
					</ol>
				</section>
			</div>

			<aside class="min-w-0 space-y-6">
				<section class="panel" aria-labelledby="details-heading">
					<h2 id="details-heading" class="sr-only">Details</h2>
					<dl class="facts">
						{alliance.tag && <div><dt>Tag</dt><dd class="font-mono">{alliance.tag}</dd></div>}
						<div>
							<dt>Banner colour</dt>
							<dd class="flex items-center gap-2">
								<span class="colour-dot" style={`background: ${alliance.color}`} aria-hidden="true"></span>
								{colourName ?? alliance.color}
							</dd>
						</div>
						<div><dt>Galaxy</dt><dd>{alliance.galaxy}{galaxyNumber && <span class="text-dim tabular"> · #{galaxyNumber}</span>}</dd></div>
						{alliance.region && <div><dt>Region</dt><dd>{alliance.region}</dd></div>}
						<div><dt>Station system</dt><dd>{alliance.joinSystem}</dd></div>
						<div><dt>Platforms</dt><dd>{platformsText}</dd></div>
						{alliance.languages && <div><dt>Languages</dt><dd>{alliance.languages}</dd></div>}
						{listedOn && <div><dt>Listed</dt><dd>{listedOn}</dd></div>}
					</dl>
					{(alliance.discordUrl || alliance.websiteUrl) && (
						<div class="mt-6 flex flex-wrap gap-3">
							{alliance.discordUrl && <a class="btn-primary" href={alliance.discordUrl} rel="nofollow ugc noopener" target="_blank">Join the Discord</a>}
							{alliance.websiteUrl && <a class="btn-quiet" href={alliance.websiteUrl} rel="nofollow ugc noopener" target="_blank">Website</a>}
						</div>
					)}
				</section>
				{communityItems && (
					<section class="panel" aria-labelledby="flair-heading">
						<h2 id="flair-heading">In-game banner and decal</h2>
						<p class="help !mt-1">{alliance.name} has its own items in the game.</p>
						<ul class="mt-4 space-y-3">
							{[communityItems.banner, communityItems.decal].map((flair) => (
								<li>
									<a class="group flex items-center gap-3" href={flair.href}>
										<span class="slot w-12"><img src={`${SITE.imageBaseUrl}${toWebp(flair.icon)}`} alt="" width="40" height="40" loading="lazy" /></span>
										<span class="link">{flair.name}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)}
			</aside>
		</div>

		<div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
			<a class="btn-quiet" href="/alliances/">← All alliances</a>
			<div class="flex flex-wrap items-center gap-3">
				<p class="help !mt-0">Something out of date?</p>
				<a class="btn-quiet" href={`/alliances/${alliance.slug}/edit/`}>Suggest an edit</a>
			</div>
		</div>
	</div>
</Layout>
