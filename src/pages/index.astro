---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NitroAd from '@components/ads/NitroAd.astro';
import { SITE } from '@config';
import { Refinery, NutrientProcessor } from '@datav2/index.js';
import { getNewUpdatePayload } from '@utils/newUpdate';
import { getRouteEligibleNewItems } from '@utils/routeCatalog.js';

// Home: search first, then the three machines, then calculators, catalogs, what's new and the latest guides.
// Counts come from the data; the catalog art is the same 3D renders the old card grid used.
const img = (id: string) => `/images/items/${id}.webp`;

const machines = [
	{ name: 'Refiner', href: '/refining/', image: '/images/refiner.webp', text: `${Refinery.length} recipes. Search by what goes in or what comes out.` },
	{ name: 'Nutrient Processor', href: '/cooking/', image: '/images/cooker.webp', text: `${NutrientProcessor.length.toLocaleString('en-US')} cooking recipes, from raw ingredient to pie.` },
	{ name: 'Crafting', href: '/crafting-guide/', image: '/images/crafting.webp', text: 'Every craft, with the full tree down to raw materials.' },
];

const calculators = [
	{ name: 'Crafting planner', href: '/calculator/planner/', image: '/images/calculator.webp', text: 'Add what you want to build and get one shopping list.' },
	{ name: 'Reverse calculator', href: '/calculator/reverse/', image: img('ACCESS3'), text: 'Start from what you have and see what it makes.' },
	{ name: 'Farm calculator', href: '/calculator/farm/', image: img('FARMPROD3'), text: 'Plant counts and harvest times for a farm.' },
	{ name: 'Base power', href: '/calculator/power/', image: img('U_BATTERY_S'), text: 'Generators, batteries and solar for your base.' },
];

const catalogs = [
	{ name: 'Raw materials', href: '/raw/', image: img('FUEL1') },
	{ name: 'Products', href: '/products/', image: img('ULTRAPROD1') },
	{ name: 'Technology', href: '/technology/', image: img('U_BATTERY_S') },
	{ name: 'Upgrades', href: '/upgrades/', image: img('UP_SLASR1') },
	{ name: 'Buildings', href: '/buildings/', image: img('S_COMPOSTBIN') },
	{ name: 'Starships', href: '/starships/', image: img('TWITCH_SHIP17') },
	{ name: 'Exocraft', href: '/exocraft/', image: '/images/exocraft.webp' },
	{ name: 'Corvette', href: '/corvette/', image: img('B_WNG_R') },
	{ name: 'Creatures', href: '/creatures/', image: img('SPEC_PB_EGG01') },
	{ name: 'Fish', href: '/fish/', image: img('F_DEEP_COM_XL') },
	{ name: 'Curiosities', href: '/curiosities/', image: img('BIOSHIP_EGG1') },
	{ name: 'Food', href: '/food/', image: img('FOOD_F_MED1') },
	{ name: 'Other', href: '/other/', image: img('SPEC_EMOTE03') },
	{ name: 'All items', href: '/items/', image: img('STA_00') },
];

const popular = [
	{ name: 'Chromatic Metal', href: '/raw/STELLAR2/' },
	{ name: 'Stasis Device', href: '/products/ULTRAPROD2/' },
	{ name: 'Fusion Ignitor', href: '/products/ULTRAPROD1/' },
	{ name: 'Antimatter', href: '/products/ANTIMATTER/' },
	{ name: 'Glass', href: '/products/FARMPROD3/' },
];

// same count as /new/ (only items that have a page)
const newCount = getRouteEligibleNewItems(getNewUpdatePayload().Items).length;
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Layout
	title="No Man's Sky Recipes Guide, Refiner Recipes, Crafting & Cooking"
	description="Find No Man's Sky recipes, refiner outputs, crafting chains, blog posts, and item lookup tools for products, upgrades, food, and raw materials."
	slug="home"
	ogImage={`${SITE.website}/images/refiner.webp`}
>
	<div class="home -mx-4 -mt-4 lg:-mx-8">
		<section class="hero" aria-labelledby="home-title">
			<picture><source media="(max-width: 767px)" srcset="/images/backgrounds/bg11-960.webp" /><img class="hero-art" src="/images/backgrounds/bg11-1600.webp" srcset="/images/backgrounds/bg11-1600.webp 1600w, /images/backgrounds/bg11.webp 1920w" sizes="(min-width: 1024px) calc(100vw - 224px), 100vw" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" /></picture>
			<div class="hero-in">
				<h1 id="home-title">Every recipe in No Man's Sky</h1>
				<p class="hero-lead">Refiner, Nutrient Processor and crafting recipes from the game files, with calculators for what to farm. Updated for the {SITE.version_name} update.</p>
				<form class="hero-search" role="search" data-search-form action="/items/">
					<label for="home-q" class="sr-only">Search items and recipes</label>
					<input id="home-q" name="q" type="search" class="field !min-h-14 !rounded-xl !border-[#56657a] !bg-[#07090e]/85 !text-lg" placeholder="Try “chromatic metal”" autocomplete="off" />
					<button class="btn-primary !min-h-14 !rounded-xl !px-6 !text-lg">Search</button>
				</form>
				<p class="hero-popular">Popular:{' '}
					{popular.map((p, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={p.href}>{p.name}</a></>)}
				</p>
			</div>
		</section>

		<div class="home-body">
			<section aria-labelledby="h-tools">
				<h2 id="h-tools" class="sr-only">Tools</h2>
				<ul class="machines">
					{machines.map((m) => (
						<li><a href={m.href} class="machine">
							<img src={m.image} alt="" width="200" height="200" loading="eager" />
							<span><span class="machine-name">{m.name}</span><span class="machine-text">{m.text}</span></span>
						</a></li>
					))}
				</ul>
			</section>

			<NitroAd id="home-after-hero" class="!my-8 px-0" minHeight={250} />

			<div class="home-cols">
				<section aria-labelledby="h-calc">
					<h2 id="h-calc" class="section-title">Calculators</h2>
					<ul class="calcs">
						{calculators.map((c) => (
							<li><a href={c.href} class="calc">
								<img src={c.image} alt="" width="56" height="56" loading="lazy" />
								<span><span class="calc-name">{c.name}</span><span class="calc-text">{c.text}</span></span>
							</a></li>
						))}
					</ul>
				</section>

				<section aria-labelledby="h-cat">
					<h2 id="h-cat" class="section-title">Catalogs</h2>
					<ul class="cats">
						{catalogs.map((c) => (
							<li><a href={c.href} class="cat">
								<img src={c.image} alt="" width="96" height="96" loading="lazy" />
								<span>{c.name}</span>
							</a></li>
						))}
					</ul>
				</section>
			</div>

			<a href="/new/" class="new-strip">
				<span class="new-tag">{SITE.version_name} {SITE.version}</span>
				<span>{newCount > 0 ? `${newCount} new items in this update` : 'What’s new in this update'}</span>
				<span aria-hidden="true" class="ml-auto">→</span>
			</a>

			{posts.length > 0 && (
				<section aria-labelledby="h-guides" class="mt-12">
					<div class="flex items-baseline gap-4">
						<h2 id="h-guides" class="section-title">Latest guides</h2>
						<a href="/blog/" class="link ml-auto text-base">All guides</a>
					</div>
					<ul class="posts">
						{posts.map((p) => (
							<li><a href={`/blog/${p.id}/`} class="post">
								{p.data.heroImage && <img src={p.data.heroImage} alt="" width="640" height="360" loading="lazy" />}
								<span class="post-title">{p.data.title}</span>
								<time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{fmt(p.data.pubDate)}</time>
							</a></li>
						))}
					</ul>
				</section>
			)}
		</div>
	</div>
</Layout>

<style>
	.hero { position: relative; isolation: isolate; overflow: hidden; padding: 3.5rem 1rem 3rem; }
	@media (min-width: 1024px) { .hero { padding: 5rem 2rem 4.5rem; } }
	.hero-art { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 55% 38%; }
	.hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(11 15 20 / .95), rgb(11 15 20 / .7) 55%, rgb(11 15 20 / .2)), linear-gradient(0deg, var(--color-space), transparent 45%); }
	@media (max-width: 767px) { .hero::after { background: linear-gradient(0deg, var(--color-space), rgb(11 15 20 / .78) 60%, rgb(11 15 20 / .55)); } }
	.hero-in { max-width: 40rem; }
	.hero h1 { margin: 0; font-size: clamp(2.25rem, 5.2vw, 3.6rem); font-weight: 700; line-height: 1.03; letter-spacing: -.01em; }
	.hero-lead { margin: 1rem 0 1.5rem; max-width: 46ch; font-size: 1.125rem; color: #dfe7f0; }
	.hero-search { display: flex; gap: .6rem; max-width: 36rem; }
	.hero-popular { margin: .9rem 0 0; font-size: .95rem; color: #c9d4e0; }
	.hero-popular a { color: var(--color-accent); font-weight: 500; text-decoration: underline; text-decoration-color: rgb(255 195 86 / .4); text-underline-offset: 3px; }
	.hero-popular a:hover { text-decoration-color: currentColor; }
	.home-body { padding: .5rem 1rem 3rem; }
	@media (min-width: 1024px) { .home-body { padding: .5rem 2rem 4rem; } }
	ul { margin: 0; padding: 0; list-style: none; }
	.machines { display: grid; gap: 1rem; }
	@media (min-width: 900px) { .machines { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	.machine { display: grid; grid-template-columns: 96px 1fr; gap: 1rem; align-items: center; height: 100%; padding: .9rem 1.1rem; border-radius: 14px; border: 1px solid var(--color-line); background: var(--color-panel); transition: border-color .15s, background-color .15s; }
	.machine:hover { border-color: var(--color-accent); background: var(--color-panel-3); }
	.machine img { width: 96px; height: 96px; object-fit: contain; }
	@media (max-width: 639px) { .machine { grid-template-columns: 64px 1fr; padding: .7rem .9rem; } .machine img { width: 64px; height: 64px; } .machine-name { font-size: 1.25rem; } }
	.machine-name { display: block; font-size: 1.5rem; font-weight: 600; line-height: 1.1; }
	.machine:hover .machine-name { color: var(--color-accent); }
	.machine-text { display: block; margin-top: .3rem; font-size: .95rem; color: var(--color-dim); }
	.home-cols { display: grid; gap: 2.5rem; margin-top: .5rem; }
	@media (min-width: 1100px) { .home-cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); } }
	.calcs { display: grid; gap: .6rem; }
	@media (min-width: 640px) and (max-width: 1099px) { .calcs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	.calc { display: grid; grid-template-columns: 52px 1fr; gap: .85rem; align-items: center; height: 100%; padding: .7rem .9rem; border-radius: 12px; border: 1px solid var(--color-line); background: var(--color-panel); transition: border-color .15s; }
	.calc:hover { border-color: var(--color-accent); }
	.calc img { width: 52px; height: 52px; object-fit: contain; }
	.calc-name { display: block; font-size: 1.0625rem; font-weight: 600; }
	.calc-text { display: block; font-size: .875rem; line-height: 1.35; color: var(--color-dim); }
	.cats { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); }
	.cat { display: grid; justify-items: center; gap: .3rem; height: 100%; padding: .9rem .5rem .75rem; border-radius: 12px; border: 1px solid var(--color-line); background: radial-gradient(circle at 50% 35%, #1b2533, var(--color-panel-2) 70%); text-align: center; font-size: .95rem; font-weight: 500; transition: border-color .15s; }
	.cat:hover { border-color: var(--color-accent); color: var(--color-accent); }
	.cat img { width: 84px; height: 84px; object-fit: contain; }
	.new-strip { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; margin-top: 2.5rem; padding: .9rem 1.1rem; border-radius: 12px; border: 1px solid var(--color-accent-line); background: rgb(255 195 86 / .06); font-size: 1rem; transition: border-color .15s; }
	.new-strip:hover { border-color: var(--color-accent); }
	.new-tag { color: var(--color-accent); font-weight: 600; }
	.posts { display: grid; gap: 1.25rem; }
	@media (min-width: 700px) { .posts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	.post { display: grid; gap: .5rem; }
	.post img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; border: 1px solid var(--color-line); }
	.post-title { font-size: 1.0625rem; font-weight: 600; line-height: 1.3; }
	.post:hover .post-title { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
	.post time { font-size: .875rem; color: var(--color-dim); }
</style>
