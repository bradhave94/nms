---
import Layout from '@layouts/Layout.astro';

const popular = [
	{ name: 'Refining recipes', href: '/refining/', blurb: 'Every refiner recipe with ratios and times' },
	{ name: 'Cooking recipes', href: '/cooking/', blurb: 'Nutrient Processor recipes and values' },
	{ name: 'Crafting guide', href: '/crafting-guide/', blurb: 'What every craftable item needs' },
	{ name: 'Crafting calculator', href: '/calculator/', blurb: 'Total raw materials for any build' },
	{ name: 'All items', href: '/items/', blurb: 'Browse the full item catalog' },
	{ name: 'Blog', href: '/blog/', blurb: 'Guides for expeditions, updates and farming' },
];
---

<Layout
	title="Page Not Found | No Man's Sky Recipes"
	description="This page doesn't exist. Search the site or jump to refining, cooking, crafting and the calculator."
	robots="noindex,follow"
	ads={false}
>
	<section class="mx-auto max-w-3xl px-4 pt-16 pb-12 text-center">
		<h1 class="text-4xl font-bold leading-[1.05] text-ink sm:text-6xl">Lost in space</h1>
		<p class="mx-auto mt-4 max-w-xl text-lg text-dim">
			Error 404: we couldn't find that page. It may have moved after a game update. Search for the item or recipe you wanted, or
			start from one of the pages below.
		</p>
		<button type="button" data-open-search class="btn-primary mt-8 cursor-pointer px-6">
			<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path
					fill-rule="evenodd"
					d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
					clip-rule="evenodd"></path>
			</svg>
			Search items and guides
		</button>
	</section>
	<section class="mx-auto max-w-4xl px-4 pb-16">
		<h2 class="section-title justify-center">Popular pages</h2>
		<nav aria-label="Popular pages" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				popular.map((page) => (
					<a
						href={page.href}
						class="panel group flex flex-col justify-center px-5 py-4 text-left no-underline transition-colors hover:border-line-strong hover:bg-panel-3"
					>
						<span class="font-semibold text-ink group-hover:text-accent">{page.name}</span>
						<span class="mt-1 text-sm text-dim">{page.blurb}</span>
					</a>
				))
			}
		</nav>
	</section>
</Layout>
